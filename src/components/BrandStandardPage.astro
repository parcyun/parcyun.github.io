---
import PsFooter from './PsFooter.astro';
import type { BrandStandard } from '../data/brandStandards';

interface Props { standard: BrandStandard }
const { standard } = Astro.props;
const title = `${standard.name} · Web Standard — parcyun studio Works`;
---
<!doctype html>
<html lang="ko" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={`${standard.name} 웹 컴포넌트와 섹션 표준 카탈로그`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</head>
<body class:list={[standard.surface === 'dark' && 'is-masterclass']}>
  <header class="site-header">
    <a class="studio" href="/works/" aria-label="parcyun studio Works로 이동">parcyun studio <span>/ works</span></a>
    <nav aria-label="페이지 탐색">
      <a href="#foundation">Foundation</a>
      <a href="#components">Components</a>
      <a href="#sections">Sections</a>
      <button class="theme-toggle" type="button" aria-label="어두운 화면으로 전환" aria-pressed="false">◐</button>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-index">STANDARD / 01</div>
      <div class="hero-copy">
        <p>{standard.eyebrow}</p>
        <h1>{standard.name}</h1>
        <h2>{standard.koreanName}</h2>
      </div>
      <p class="hero-summary">{standard.summary}</p>
      <div class="hero-meta"><span>Mode</span><strong>{standard.tone}</strong></div>
    </section>

    <section class="foundation section" id="foundation">
      <header class="section-heading"><span>01</span><div><p>Foundation</p><h2>보이는 것보다 먼저<br />기준을 고정합니다.</h2></div></header>
      <div class="palette" aria-label={`${standard.name} 색상 체계`}>
        {standard.palette.map((color) => <article style={`--swatch:${color.value}`}><div class="swatch"></div><span>{color.name}</span><code>{color.value}</code></article>)}
      </div>
      <div class="type-grid">
        {standard.typography.map((type) => <article><span>{type.role}</span><strong style={`font-family:${type.family === 'Pretendard' ? "'Pretendard Variable', sans-serif" : `'${type.family}', sans-serif`}`}>{type.family}</strong><p>{type.note}</p></article>)}
      </div>
      <div class="asset-actions" aria-label={`${standard.name} 표준 파일`}>
        <button type="button" data-asset-open data-url={standard.manifestUrl} data-label="Component manifest"><span>JSON</span><strong>구성 요소 명세 보기</strong><small>파일·출처·재사용 기준</small></button>
        <button type="button" data-asset-open data-url={standard.cssUrl} data-label="Design tokens"><span>CSS</span><strong>토큰 파일 미리보기</strong><small>색상·서체·간격 기준</small></button>
      </div>
    </section>

    <section class="brand-stage section" aria-label={`${standard.name} 브랜드 미리보기`}>
      <div class="stage-label">LIVE LANGUAGE</div>
      <div class="stage-mark" aria-hidden="true">{standard.slug === 'mdbf' ? 'ㅁ' : 'M'}</div>
      <div class="stage-copy"><span>{standard.name}</span><h2>{standard.slug === 'mdbf' ? '교육의 건강한 미래를 만드는 교사 공동체' : '현장에서 검증된 연수를, 모든 교사에게.'}</h2></div>
    </section>

    <section class="section" id="components">
      <header class="section-heading"><span>02</span><div><p>Objects</p><h2>작게 나누되,<br />역할은 선명하게.</h2></div></header>
      <p class="catalog-hint">각 항목을 누르면 동작 형태와 재사용 기준을 확인할 수 있습니다.</p>
      <div class="inventory">
        {standard.objects.map((item, index) => <button type="button" data-catalog-open data-catalog-kind="object" data-catalog-title={item.name} data-catalog-description={item.description} data-catalog-source={item.source}><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.name}</h3><p>{item.description}</p></div><code>{item.source}</code><b aria-hidden="true">↗</b></button>)}
      </div>
    </section>

    <section class="section section-tinted" id="sections">
      <header class="section-heading"><span>03</span><div><p>Sections</p><h2>반복되는 화면을<br />하나의 문법으로.</h2></div></header>
      <div class="section-cards">
        {standard.sections.map((item, index) => <button type="button" data-catalog-open data-catalog-kind="section" data-catalog-title={item.name} data-catalog-description={item.description} data-catalog-source={item.source}><span>SECTION {String(index + 1).padStart(2, '0')}</span><h3>{item.name}</h3><p>{item.description}</p><code>{item.source}</code><b aria-hidden="true">Preview ↗</b></button>)}
      </div>
    </section>

    <section class="section rules">
      <header class="section-heading"><span>04</span><div><p>Usage</p><h2>일관성을 지키는<br />네 가지 약속.</h2></div></header>
      <ol>{standard.rules.map((rule) => <li>{rule}</li>)}</ol>
      <div class="downloads">
        <a href={standard.manifestUrl} download><span>JSON</span><strong>Component manifest</strong><small>구성 요소·출처 명세</small></a>
        <a href={standard.cssUrl} download><span>CSS</span><strong>Design tokens</strong><small>색상·서체·간격 토큰</small></a>
      </div>
    </section>
  </main>
  <dialog class="catalog-dialog" aria-labelledby="catalog-title">
    <div class="catalog-dialog-inner">
      <button class="catalog-close" type="button" aria-label="미리보기 닫기">×</button>
      <p class="catalog-eyebrow">Interactive standard preview</p>
      <h2 id="catalog-title"></h2>
      <p class="catalog-description"></p>
      <div class="catalog-preview" aria-live="polite"></div>
      <p class="catalog-source"><span>Source</span><code></code></p>
      <div class="catalog-actions"><a class="catalog-file" href="#" target="_blank" rel="noreferrer">표준 파일 열기</a><button class="catalog-demo-action" type="button">상태 전환</button></div>
      <pre class="catalog-code" hidden></pre>
    </div>
  </dialog>
  <PsFooter showReview={false} />

  <script is:inline>
    const root = document.documentElement;
    const button = document.querySelector('.theme-toggle');
    const dialog = document.querySelector('.catalog-dialog');
    const dialogTitle = dialog?.querySelector('#catalog-title');
    const dialogDescription = dialog?.querySelector('.catalog-description');
    const dialogPreview = dialog?.querySelector('.catalog-preview');
    const dialogSource = dialog?.querySelector('.catalog-source code');
    const dialogFile = dialog?.querySelector('.catalog-file');
    const dialogCode = dialog?.querySelector('.catalog-code');
    const dialogAction = dialog?.querySelector('.catalog-demo-action');
    const isMdbf = document.body.classList.contains('is-masterclass') === false;
    const saved = localStorage.getItem('ps-standard-theme');
    if (saved === 'dark') root.dataset.theme = 'dark';
    const sync = () => {
      const dark = root.dataset.theme === 'dark';
      button?.setAttribute('aria-pressed', String(dark));
      button?.setAttribute('aria-label', dark ? '밝은 화면으로 전환' : '어두운 화면으로 전환');
    };
    sync();
    button?.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      localStorage.setItem('ps-standard-theme', root.dataset.theme);
      sync();
    });

    const escapeMarkup = (value) => value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' })[char]);
    const previewMarkup = (title, kind) => {
      const blue = isMdbf ? 'MDBF Blue' : 'Masterclass Blue';
      const modifier = isMdbf ? 'preview-mdbf' : 'preview-masterclass';
      if (/Header|Chrome|Navigation/.test(title)) return `<div class="mini-shell ${modifier}"><div class="mini-nav"><strong>${isMdbf ? '몽당분필' : 'the Masterclass'}</strong><span>소개</span><span>사업</span><span>소식</span><button>메뉴</button></div><p>공용 내비게이션은 페이지 이동에도 같은 위치와 정보 위계를 유지합니다.</p></div>`;
      if (/Carousel|Marquee|Row|Series/.test(title)) return `<div class="mini-shell ${modifier}"><div class="mini-row"><article></article><article></article><article></article></div><div class="mini-controls"><button aria-label="이전">←</button><span>1 / 3</span><button aria-label="다음">→</button></div></div>`;
      if (/Modal|Detail|Gate|Access/.test(title)) return `<div class="mini-shell ${modifier}"><div class="mini-modal"><span>${blue}</span><strong>${escapeMarkup(title)}</strong><p>현재 화면 위에서 내용을 이어 보는 상세 레이어입니다.</p><button>계속 보기</button></div></div>`;
      if (/Action|Link|Button/.test(title)) return `<div class="mini-shell ${modifier}"><div class="mini-actions"><button>자세히 보기 <i>→</i></button><button class="ghost">저장하기</button></div><p>핵심 행동은 한 번에 구분되도록 대비와 여백을 고정합니다.</p></div>`;
      if (/Inquiry|Board|Archive|Channel/.test(title)) return `<div class="mini-shell ${modifier}"><div class="mini-list"><span>2026.09.11</span><strong>${escapeMarkup(title)} 예시 제목</strong><button>열기</button></div><div class="mini-list is-muted"><span>2026.09.08</span><strong>일관된 카드와 목록 구조</strong><button>열기</button></div></div>`;
      return `<div class="mini-shell ${modifier}"><span class="mini-label">${kind.toUpperCase()}</span><h3>${escapeMarkup(title)}</h3><p>실제 화면에서 반복되는 구조를 축소해 보여 주는 표준 미리보기입니다.</p><button>인터랙션 확인</button></div>`;
    };
    const openDialog = ({ title, description, source, kind, url, code }) => {
      if (!dialog || !dialogTitle || !dialogDescription || !dialogPreview || !dialogSource || !dialogFile || !dialogCode) return;
      dialogTitle.textContent = title;
      dialogDescription.textContent = description;
      dialogSource.textContent = source || url || '';
      dialogPreview.innerHTML = code ? '' : previewMarkup(title, kind || 'asset');
      dialogFile.href = url || '#';
      dialogFile.textContent = code ? '파일 다운로드' : '표준 파일 열기';
      dialogCode.hidden = !code;
      if (code) dialogCode.textContent = code;
      dialog.showModal();
    };
    document.querySelectorAll('[data-catalog-open]').forEach((item) => item.addEventListener('click', () => openDialog({
      title: item.dataset.catalogTitle || '', description: item.dataset.catalogDescription || '', source: item.dataset.catalogSource || '', kind: item.dataset.catalogKind || '',
    })));
    document.querySelectorAll('[data-asset-open]').forEach((item) => item.addEventListener('click', async () => {
      const url = item.dataset.url || '';
      const label = item.dataset.label || 'Standard asset';
      openDialog({ title: label, description: '배포 중인 표준 파일의 내용을 직접 확인할 수 있습니다.', source: url, kind: 'asset', url });
      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('asset request failed');
        const code = await response.text();
        if (dialogCode && dialogPreview) { dialogPreview.innerHTML = ''; dialogCode.hidden = false; dialogCode.textContent = code; }
      } catch {
        if (dialogCode) { dialogCode.hidden = false; dialogCode.textContent = '미리보기를 불러오지 못했습니다. 파일 열기 버튼으로 다시 확인해 주세요.'; }
      }
    }));
    dialog?.querySelector('.catalog-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialogAction?.addEventListener('click', () => {
      if (!dialogPreview) return;
      dialogPreview.classList.toggle('is-active');
      dialogAction.textContent = dialogPreview.classList.contains('is-active') ? '적용됨' : '상태 전환';
    });
  </script>
</body>
</html>

<style is:global>
  :root{--ps:#ffb11a;--bg:#f5f2ea;--paper:#fff;--ink:#101010;--muted:#6e6b65;--line:#d9d4c8;--brand:#3364d9;--brand-dark:#0f3aa0;--brand-soft:#f0f4ff;color-scheme:light}
  :root[data-theme='dark']{--bg:#111;--paper:#191919;--ink:#f4f1e9;--muted:#aaa59d;--line:#393631;color-scheme:dark}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:'Pretendard Variable','Pretendard',sans-serif;font-weight:350;line-height:1.65;word-break:keep-all;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}
  .site-header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;height:68px;padding:0 clamp(20px,4vw,64px);border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(12px)}.studio{font-family:Montserrat,sans-serif;font-size:13px;font-weight:600;letter-spacing:-.02em}.studio span{color:var(--muted);font-weight:400}.site-header nav{display:flex;align-items:center;gap:24px;font-family:Montserrat,sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:.08em}.theme-toggle{width:34px;height:34px;border:1px solid var(--line);border-radius:50%;background:transparent;color:var(--ink);cursor:pointer}
  main{overflow:hidden}.hero,.section{max-width:1440px;margin:auto;padding:clamp(88px,11vw,168px) clamp(22px,6vw,92px)}.hero{display:grid;grid-template-columns:1fr 2.2fr;gap:40px;min-height:calc(100vh - 68px);align-content:center;border-bottom:1px solid var(--line)}.hero-index,.hero-copy>p,.section-heading p,.stage-label{font:500 10px/1.4 Montserrat,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}.hero-copy h1{margin:20px 0 0;font:500 clamp(58px,10vw,144px)/.88 Montserrat,sans-serif;letter-spacing:-.075em}.hero-copy h2{margin:22px 0 0;font-size:clamp(17px,2vw,28px);font-weight:400;color:var(--brand-dark)}.hero-summary{grid-column:2;max-width:720px;margin:54px 0 0;font-size:clamp(20px,2vw,30px);line-height:1.55;letter-spacing:-.025em}.hero-meta{grid-column:2;display:flex;gap:20px;margin-top:34px;padding-top:20px;border-top:1px solid var(--line);font-size:12px}.hero-meta span{color:var(--muted)}
  .section{border-bottom:1px solid var(--line)}.section-heading{display:grid;grid-template-columns:1fr 2.2fr;gap:40px;margin-bottom:70px}.section-heading>span{font:500 11px Montserrat,sans-serif;color:var(--ps)}.section-heading p{margin:0 0 18px}.section-heading h2{margin:0;font-size:clamp(34px,4.5vw,66px);font-weight:350;line-height:1.1;letter-spacing:-.045em}
  .palette{display:grid;grid-template-columns:repeat(6,1fr);border:1px solid var(--line)}.palette article{min-width:0;padding:12px;border-right:1px solid var(--line)}.palette article:last-child{border:0}.swatch{aspect-ratio:1;background:var(--swatch);border:1px solid color-mix(in srgb,var(--line) 60%,transparent)}.palette span,.palette code{display:block;margin-top:12px;font-size:11px}.palette code{margin-top:2px;color:var(--muted)}.type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:54px;background:var(--line);border:1px solid var(--line)}.type-grid article{padding:28px;background:var(--paper)}.type-grid span,.type-grid p{font-size:11px;color:var(--muted)}.type-grid strong{display:block;margin:30px 0 18px;font-size:clamp(24px,3vw,42px);font-weight:500}
  .brand-stage{position:relative;display:grid;grid-template-columns:1fr 1.7fr;align-items:end;min-height:680px;max-width:none;background:var(--brand);color:#fff}.is-masterclass .brand-stage{background:#07090f}.stage-label{position:absolute;top:54px;left:clamp(22px,6vw,92px);color:#fff9}.stage-mark{font:600 clamp(180px,30vw,460px)/.7 Montserrat,sans-serif;letter-spacing:-.14em;color:#fff}.is-masterclass .stage-mark{color:#3364d9}.stage-copy{max-width:740px}.stage-copy span{font:500 12px Montserrat,sans-serif;letter-spacing:.1em}.stage-copy h2{margin:22px 0 0;font-size:clamp(32px,4.6vw,70px);font-weight:350;line-height:1.1;letter-spacing:-.045em}
  .asset-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:32px}.asset-actions button{display:grid;grid-template-columns:64px 1fr;gap:4px 20px;padding:24px 28px;border:1px solid var(--line);background:var(--paper);color:var(--ink);font:inherit;text-align:left;cursor:pointer;transition:background .2s ease,border-color .2s ease,transform .2s ease}.asset-actions button:hover,.asset-actions button:focus-visible{border-color:var(--ps);background:color-mix(in srgb,var(--ps) 8%,var(--paper));outline:none;transform:translateY(-2px)}.asset-actions span{grid-row:1/3;display:grid;place-items:center;width:54px;height:54px;border-radius:50%;background:var(--ps);color:#000;font:600 10px Montserrat,sans-serif}.asset-actions strong{font-size:17px}.asset-actions small{color:var(--muted)}
  .catalog-hint{margin:-34px 0 30px;color:var(--muted);font-size:14px}.inventory{border-top:1px solid var(--ink)}.inventory button{display:grid;width:100%;grid-template-columns:60px 1fr minmax(160px,260px) 28px;gap:24px;align-items:start;padding:30px 0;border:0;border-bottom:1px solid var(--line);background:transparent;color:inherit;font:inherit;text-align:left;cursor:pointer}.inventory button:hover,.inventory button:focus-visible{background:color-mix(in srgb,var(--ps) 7%,transparent);outline:none}.inventory>button>span{font:500 11px Montserrat,sans-serif;color:var(--brand)}.inventory h3{margin:0 0 8px;font-size:22px;font-weight:550}.inventory p{max-width:650px;margin:0;color:var(--muted)}.inventory code,.section-cards code{font-size:10px;color:var(--muted);overflow-wrap:anywhere}.inventory b{font:400 20px/1 Montserrat,sans-serif;color:var(--ps);transition:transform .2s ease}.inventory button:hover b{transform:translate(3px,-3px)}
  .section-tinted{background:var(--paper)}.section-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.section-cards button{display:flex;min-height:270px;flex-direction:column;padding:28px;border:1px solid var(--line);background:var(--bg);color:var(--ink);font:inherit;text-align:left;cursor:pointer;transition:border-color .2s ease,transform .2s ease}.section-cards button:hover,.section-cards button:focus-visible{border-color:var(--ps);outline:none;transform:translateY(-3px)}.section-cards span{font:500 9px Montserrat,sans-serif;letter-spacing:.12em;color:var(--brand)}.section-cards h3{margin:45px 0 12px;font-size:24px}.section-cards p{margin:0;color:var(--muted)}.section-cards code{margin-top:auto;padding-top:24px}.section-cards b{margin-top:14px;color:var(--ps);font:500 11px Montserrat,sans-serif;letter-spacing:.06em;text-transform:uppercase}
  .rules ol{margin:0 0 70px;padding:0;counter-reset:rule;list-style:none;border-top:1px solid var(--ink)}.rules li{counter-increment:rule;display:grid;grid-template-columns:60px 1fr;padding:28px 0;border-bottom:1px solid var(--line);font-size:clamp(16px,1.6vw,22px)}.rules li:before{content:'0' counter(rule);font:500 11px Montserrat,sans-serif;color:var(--brand)}.downloads{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.downloads a{display:grid;grid-template-columns:64px 1fr;gap:4px 20px;padding:28px;border:1px solid var(--line);transition:background .2s ease,border-color .2s ease}.downloads a:hover,.downloads a:focus-visible{border-color:var(--ps);background:color-mix(in srgb,var(--ps) 8%,var(--paper));outline:none}.downloads span{grid-row:1/3;display:grid;place-items:center;width:54px;height:54px;border-radius:50%;background:var(--ps);color:#000;font:600 10px Montserrat,sans-serif}.downloads strong{font-size:18px}.downloads small{color:var(--muted)}
