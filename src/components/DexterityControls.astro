---
import PsFooter from './PsFooter.astro';
const {showTheme=false}=Astro.props;
---
<aside class="dexterity-dock" aria-label="페이지 도구">
  <div class="dexterity-dock-row">
    {showTheme && <button type="button" class="dexterity-theme" data-dexterity-theme aria-label="라이트 모드로 전환" title="라이트 모드로 전환"><svg class="theme-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg><svg class="theme-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 13a9 9 0 0 1-10-10 9 9 0 1 0 10 10Z"/></svg></button>}
    <div id="visitor-stats" class="ps-visits dexterity-dock-visits" aria-live="polite"></div>
    <button type="button" class="dexterity-to-top" aria-label="상단으로 이동" title="상단으로 이동">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg>
    </button>
  </div>
  <PsFooter showLinks={false} showFeedback={false} showReview={false} contactLabel="협업 문의"/>
</aside>
<script>
function initDexterityControls(){
const dock=document.querySelector<HTMLElement>('.dexterity-dock');
dock?.querySelector('.dexterity-to-top')?.addEventListener('click',()=>{
  window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'});
});
const slot=dock?.closest<HTMLElement>('[data-dexterity-footer-slot]');
if(dock&&slot){
  let frame=0;
  const sync=()=>{
    frame=0;
    slot.style.height=dock.offsetHeight+'px';
    const inset=parseFloat(getComputedStyle(slot.parentElement!).paddingBottom)||12;
    dock.classList.toggle('is-docked',slot.getBoundingClientRect().bottom<=innerHeight-inset+1);
  };
  const schedule=()=>{if(!frame)frame=requestAnimationFrame(sync);};
  window.addEventListener('scroll',schedule,{passive:true});
  window.addEventListener('resize',schedule);
  const observer=new ResizeObserver(schedule);observer.observe(dock);sync();
return ()=>{observer.disconnect();cancelAnimationFrame(frame);window.removeEventListener('scroll',schedule);window.removeEventListener('resize',schedule);};
}
}
if((window as any).psPageLifecycle)(window as any).psPageLifecycle.register('dexterity-controls',initDexterityControls);else initDexterityControls();
</script>
<script is:inline src="/visitor-counter.js?v=20261122-music-2" defer></script>
<script is:inline src="/dexterity-refresh.js?v=20261123-1" defer></script>
<style is:global>
@media(pointer:coarse){html.dexterity-refresh-enabled{overscroll-behavior-y:contain}}
.dexterity-refresh{position:fixed;top:env(safe-area-inset-top,0px);left:calc(50% - 20px);z-index:9990;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--ps-bg,#000);color:#FFB11A;border:1px solid var(--ps-border,#333);opacity:0;pointer-events:none;transform:translateY(calc(var(--pull,0px) - 44px));transition:opacity .15s}
.dexterity-refresh.is-visible{opacity:1}.dexterity-refresh.is-ready svg{transform:rotate(180deg)}.dexterity-refresh.is-refreshing svg{animation:dexterity-refresh-spin .8s linear infinite}
@keyframes dexterity-refresh-spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.dexterity-refresh{transition:none}.dexterity-refresh.is-refreshing svg{animation:none}}
body:has([data-dexterity-theme]),body:has([data-dexterity-theme]) :is(.heading,.meta,.eyebrow,.prose,.notes,.article-top-back,figcaption,.game-guide,.game-guide-back,.game-guide-summary,.game-guide-note,.game-guide-link,.game-guide-toc,.guide-carousel-track>a,.guide-carousel-track p){transition:background-color .3s ease,color .3s ease,border-color .3s ease}
@media(prefers-reduced-motion:reduce){body:has([data-dexterity-theme]),body:has([data-dexterity-theme]) :is(.heading,.meta,.eyebrow,.prose,.notes,.article-top-back,figcaption,.game-guide,.game-guide-back,.game-guide-summary,.game-guide-note,.game-guide-link,.game-guide-toc,.guide-carousel-track>a,.guide-carousel-track p){transition:none}}
html:has(.dexterity-dock),body:has(.dexterity-dock),body:has(.dexterity-dock) *{scrollbar-width:none}
body:has(.dexterity-dock)::-webkit-scrollbar,html:has(.dexterity-dock)::-webkit-scrollbar,body:has(.dexterity-dock) *::-webkit-scrollbar{display:none}
body:has(.dexterity-dock){padding-bottom:144px;--dexterity-gutter:clamp(20px,4vw,48px)}
.dexterity-dock{position:fixed;right:max(var(--dexterity-gutter),env(safe-area-inset-right));bottom:max(12px,env(safe-area-inset-bottom));z-index:9989;display:flex;flex-direction:column;align-items:flex-end;gap:12px;max-width:calc(100vw - 2 * var(--dexterity-gutter) - env(safe-area-inset-left) - env(safe-area-inset-right));pointer-events:none}
.dexterity-dock>*{pointer-events:auto}
.dexterity-home:has(.dexterity-dock){padding-bottom:0}
.dexterity-dock.is-docked{position:absolute;right:0;bottom:0}
.dexterity-dock-row{display:flex;align-items:center;justify-content:flex-end;gap:12px;max-width:100%}
.dexterity-dock .dexterity-theme{display:grid;place-items:center;flex:none;width:44px;height:44px;min-height:44px;margin:0;padding:0;border:1px solid #ffffff40;border-radius:50%;background:#111;color:#FFB11A;cursor:pointer}
.dexterity-theme .theme-moon,html[data-theme=light] .dexterity-theme .theme-sun{display:none}html[data-theme=light] .dexterity-theme .theme-moon{display:block}
.dexterity-theme:hover{border-color:#FFB11A}.dexterity-theme:focus-visible{outline:2px solid #FFB11A;outline-offset:4px}
.dexterity-dock #visitor-stats{display:inline-flex;flex-wrap:wrap;gap:16px;margin:0;padding:8px 12px;border:1px solid #ffffff26;border-radius:999px;background:#000c;color:#aaa;font-size:11px;line-height:1.5;min-height:0}
.dexterity-dock #visitor-stats:empty{display:none}
.dexterity-dock .dexterity-to-top{display:grid;place-items:center;flex:none;width:48px;height:48px;min-height:48px;padding:0;border:1px solid #ffffff40;border-radius:50%;background:#111;color:#FFB11A;cursor:pointer;transition:background .18s,border-color .18s}
.dexterity-to-top svg{display:block}
.dexterity-dock .dexterity-to-top:hover{background:#222;border-color:#FFB11A}
.dexterity-dock .dexterity-to-top:focus-visible{outline:2px solid #FFB11A;outline-offset:4px}
.dexterity-dock #ps-footer-root .ps-brand-fixed{position:static;left:auto;right:auto;bottom:auto;max-width:100%;margin:0;box-sizing:border-box}
.dexterity-dock #ps-footer-root{max-width:100%;min-width:0}
.dexterity-dock #ps-footer-root .ps-brand-text{flex-wrap:wrap;justify-content:flex-end}
@media(prefers-reduced-motion:reduce){html:has(.dexterity-dock){scroll-behavior:auto}.dexterity-dock .dexterity-to-top{transition:none}}
</style>
