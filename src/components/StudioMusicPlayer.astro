<script is:inline src="/studio-music.js?v=20261122-4" defer></script>
<style>
  .studio-music-player{position:fixed;top:max(14px,env(safe-area-inset-top));left:calc(100vw - max(20px,env(safe-area-inset-right)));transform:translateX(-100%);z-index:92;display:flex;align-items:center;gap:4px;width:max-content;max-width:calc(100vw - 84px);height:44px;color:#ccc;font:300 12px/1.4 Montserrat,'Pretendard Variable',sans-serif;letter-spacing:0}
  .studio-music-player button{display:grid;place-items:center;flex:none;width:44px;height:44px;min-height:44px;margin:0;padding:0;border:0;border-radius:50%;background:transparent;color:inherit;cursor:pointer;box-shadow:none;transition:color .18s}
  .studio-music-player button:hover{color:#FFB11A}.studio-music-player button:focus-visible{outline:2px solid #FFB11A;outline-offset:2px}
  .studio-music-player button{position:relative}.studio-music-player svg{position:absolute;transition:opacity .25s ease,transform .25s ease;opacity:0;transform:scale(.75)}
  .studio-music-player[data-playing="true"] [data-music-pause],.studio-music-player:not([data-playing="true"]) [data-music-play]{opacity:1;transform:scale(1)}
  .studio-music-player [data-music-title]{min-width:0;max-width:210px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
