---
export interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  lang?: string;
}
const { title, description = '', ogTitle = '', ogDescription = '', ogUrl = '', lang = 'ko' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{ogTitle && <meta property="og:title" content={ogTitle} />}
{ogDescription && <meta property="og:description" content={ogDescription} />}
<meta property="og:type" content="website" />
{ogUrl && <meta property="og:url" content={ogUrl} />}

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

<style is:global>
/* === parcyun studio · Cinematic Mode tokens === */
:root {
  --ps-primary:                    #FFB11A;
  --ps-primary-dark:               #E89500;

  --ps-bg-cinematic:               #000000;
  --ps-surface-cinematic-1:        #141414;
  --ps-surface-cinematic-2:        #222222;
  --ps-surface-cinematic-3:        #333333;
  --ps-text-cinematic-secondary:   #8C8C8C;

  --ps-font-body: 'Pretendard Variable', 'Pretendard', 'Montserrat', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
  --ps-font-en:   'Montserrat', 'Pretendard Variable', 'Pretendard', sans-serif;
  --ps-font-signature: 'Covered By Your Grace', cursive;

  --ps-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
}

body {
  background: var(--ps-bg-cinematic);
  color: #FFFFFF;
  font-family: var(--ps-font-body);
  font-weight: 300;
  line-height: 1.6;
  word-break: keep-all;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }

/* ===== Top corner mark ===== */
.ps-corner {
  position: fixed;
  top: 20px;
  left: 24px;
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.5px;
  color: var(--ps-text-cinematic-secondary);
  z-index: 90;
  transition: color 240ms var(--ps-ease-out);
}
.ps-corner:hover { color: var(--ps-primary); }

/* ===== Layout ===== */
.wrap {
  max-width: 1108px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 768px) {
  .wrap { padding: 0 48px; }
}

section {
  padding: 96px 0;
}
@media (min-width: 768px) {
  section { padding: 120px 0; }
}

/* ===== Bilingual Section Header ===== */
.section-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 48px;
}
@media (min-width: 768px) {
  .section-header { flex-direction: row; align-items: baseline; gap: 16px; }
}
.section-header .ko {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 300;
  letter-spacing: -1.2px;
  line-height: 1.2;
  margin: 0;
  color: #FFFFFF;
}
.section-header .en {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Mandatory parcyun footer ===== */
.ps-footer {
  position: fixed;
  bottom: 16px;
  right: 20px;
  font-family: var(--ps-font-en);
  font-weight: 300;
  font-size: 11px;
  color: var(--ps-text-cinematic-secondary);
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 6px 12px;
  border-radius: 100px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.ps-signature {
  font-family: var(--ps-font-signature);
  font-size: 15px;
  color: var(--ps-primary);
  line-height: 1;
}
.ps-ig {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: inherit;
  text-decoration: none;
  margin-left: 4px;
}
.ps-ig:hover { color: var(--ps-primary); }
.ps-ig-icon { width: 10px; height: 10px; vertical-align: middle; }

/* ===== Entry animation ===== */
section, .hero {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 800ms var(--ps-ease-out), transform 800ms var(--ps-ease-out);
}
section.in-view, .hero.in-view {
  opacity: 1;
  transform: none;
}
.hero { opacity: 1; transform: none; } /* hero is always visible */

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  section, .hero { opacity: 1; transform: none; transition: none; }
}

/* ===== Floating nav (top / bottom) ===== */
.float-nav {
  position: fixed;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 80;
}
.float-nav button {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  font-family: var(--ps-font-en);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 240ms var(--ps-ease-out), color 240ms var(--ps-ease-out), transform 240ms var(--ps-ease-out);
}
.float-nav button:hover {
  border-color: var(--ps-primary);
  color: var(--ps-primary);
  transform: translateY(-2px);
}
@media (max-width: 639px) {
  .float-nav { right: 12px; gap: 6px; }
  .float-nav button { width: 36px; height: 36px; font-size: 13px; }
}

/* ===== Footer (ps-footer) · 업무 대시보드 link ===== */
.ps-footer-link {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.3px;
  color: var(--ps-text-cinematic-secondary);
  text-decoration: none;
  padding-right: 10px;
  margin-right: 4px;
  border-right: 1px solid rgba(255, 255, 255, 0.14);
  transition: color 240ms var(--ps-ease-out);
}
.ps-footer-link:hover { color: var(--ps-primary); }
.ps-footer-coffee {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.3px;
  color: var(--ps-primary);
  background: transparent;
  border: 0;
  padding: 0 10px 0 0;
  margin-right: 4px;
  border-right: 1px solid rgba(255, 255, 255, 0.14);
  cursor: pointer;
  transition: color 240ms var(--ps-ease-out);
}
.ps-footer-coffee:hover { color: var(--ps-primary-dark); }

/* ===== 커피 후원 QR 팝업 ===== */
.coffee-modal {
  position: fixed; inset: 0; z-index: 10000;
  display: flex; align-items: center; justify-content: center; padding: 24px;
}
.coffee-modal[hidden] { display: none; }
.coffee-backdrop {
  position: absolute; inset: 0;
  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  animation: coffeeFade 0.2s var(--ps-ease-out);
}
@keyframes coffeeFade { from { opacity: 0; } to { opacity: 1; } }
.coffee-card {
  position: relative; z-index: 1;
  background: var(--ps-surface-cinematic-1);
  border: 1px solid var(--ps-primary);
  border-radius: 18px;
  padding: 32px 32px 26px;
  text-align: center; max-width: 340px; width: 100%;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(255, 177, 26, 0.12);
  animation: coffeePop 0.28s var(--ps-ease-out);
}
@keyframes coffeePop { from { opacity: 0; transform: translateY(16px) scale(0.96); } to { opacity: 1; transform: none; } }
.coffee-close {
  position: absolute; top: 12px; right: 16px;
  background: transparent; border: 0;
  color: var(--ps-text-cinematic-secondary);
  font-size: 24px; line-height: 1; cursor: pointer;
  transition: color 150ms var(--ps-ease-out);
}
.coffee-close:hover { color: var(--ps-primary); }
.coffee-emoji { font-size: 40px; line-height: 1; margin-bottom: 10px; }
.coffee-title { margin: 0 0 6px; font-size: 19px; font-weight: 500; color: #FFFFFF; }
.coffee-sub { margin: 0 0 20px; font-size: 13px; font-weight: 300; color: var(--ps-text-cinematic-secondary); line-height: 1.6; }
.coffee-qr { display: block; width: 220px; height: 220px; margin: 0 auto 14px; border-radius: 12px; background: #fff; padding: 10px; object-fit: contain; }
.coffee-qr-fallback { display: none; margin: 0 auto 14px; padding: 40px 16px; border: 1px dashed var(--ps-surface-cinematic-3); border-radius: 12px; font-family: var(--ps-font-en); font-size: 12px; color: var(--ps-text-cinematic-secondary); }
.coffee-label { font-family: var(--ps-font-signature); font-size: 20px; color: var(--ps-primary); }
</style>
</head>
<body>

<a href="https://www.instagram.com/parcyun" class="ps-corner" target="_blank" rel="noopener">@parcyun</a>

<slot />

<!-- ===== Floating top/bottom nav ===== -->
<div class="float-nav" aria-label="페이지 이동">
  <button type="button" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="맨 위로">↑</button>
  <button type="button" onclick="window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})" aria-label="맨 아래로">↓</button>
</div>

<!-- ===== Mandatory parcyun footer ===== -->
<footer class="ps-footer">
  <button type="button" class="ps-footer-coffee" id="ps-coffee">☕ 커피 사주기</button>
  <a href="./dashboard.html" class="ps-footer-link">업무 대시보드 ↗</a>
  Designed by
  <span class="ps-signature">parcyun studio</span>
  <a href="https://www.instagram.com/parcyun" class="ps-ig" target="_blank" rel="noopener">
    <svg class="ps-ig-icon" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4 1 .5.4.8.8 1 1.4.2.4.3 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-1 1.4-.4.5-.8.8-1.4 1-.4.2-1 .3-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-1-.5-.4-.8-.8-1-1.4-.2-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 1-1.4.4-.5.8-.8 1.4-1 .4-.2 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 5.5a4.3 4.3 0 100 8.6 4.3 4.3 0 000-8.6zm5.4-.3a1 1 0 11-2 0 1 1 0 012 0zM12 9.5a2.5 2.5 0 110 5 2.5 2.5 0 010-5z"/>
    </svg>
    @parcyun
  </a>
</footer>

<!-- ===== 커피 후원 QR 팝업 ===== -->
<div class="coffee-modal" id="coffee-modal" hidden>
  <div class="coffee-backdrop" data-coffee-close></div>
  <div class="coffee-card" role="dialog" aria-modal="true" aria-labelledby="coffee-title">
    <button class="coffee-close" id="coffee-close" type="button" aria-label="닫기">×</button>
    <div class="coffee-emoji">☕</div>
    <h3 class="coffee-title" id="coffee-title">개발자에게 커피 한 잔</h3>
    <p class="coffee-sub">QR을 스캔해 후원할 수 있어요. 감사합니다!</p>
    <img class="coffee-qr" src="./images/coffee-qr.png" alt="parcyun studio 후원 QR"
         onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
    <div class="coffee-qr-fallback">QR 이미지를 불러올 수 없습니다.</div>
    <div class="coffee-label">parcyun studio</div>
  </div>
</div>

<script is:inline>
(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('section').forEach(function(el){ el.classList.add('in-view'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) {
        e.target.classList.add('in-view');
        io.unobserve(e.target);
      }
    });
  }, { rootMargin: '0px 0px -15% 0px', threshold: 0.05 });
  document.querySelectorAll('section').forEach(function(el){ io.observe(el); });
})();

/* ===== 커피 후원 QR 팝업 ===== */
(function(){
  var modal = document.getElementById('coffee-modal');
  function open(){ modal.hidden = false; }
  function close(){ modal.hidden = true; }
  document.getElementById('ps-coffee').addEventListener('click', open);
  document.getElementById('coffee-close').addEventListener('click', close);
  modal.addEventListener('click', function(e){ if(e.target.hasAttribute('data-coffee-close')) close(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && !modal.hidden) close(); });
})();
</script>

<script is:inline src="/share-widget.js" defer></script>
<script is:inline src="/visitor-counter.js" defer></script>
</body>
</html>
