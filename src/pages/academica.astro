---
import { icon } from '../lib/icons';
import PsFooter from '../components/PsFooter.astro';
import LectureShelf from '../components/LectureShelf.tsx';
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ACADEMICA · 강의 자료 · parcyun studio</title>
<meta name="description" content="parcyun studio 강의 자료 서가. 교육·AI·디자인 강의를 카테고리별로 모아 한 권씩 꺼내 보세요. Designed by parcyun studio." />
<meta property="og:title" content="ACADEMICA · parcyun studio" />
<meta property="og:description" content="강의 자료를 카테고리별로 모아둔 서가." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://parcyun.github.io/academica/" />
  <link rel="canonical" href="https://parcyun.github.io/academica/" />
  <meta property="og:image" content="https://parcyun.github.io/images/og-card.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://parcyun.github.io/images/og-card.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

<style is:global>

/* === parcyun studio · Cinematic Mode tokens === */
:root {
  --ps-primary:                    #FFB11A;
  --ps-primary-dark:               #E89500;

  --ps-bg-cinematic:               #000000;
  --ps-surface-cinematic-1:        #141414;
  --ps-surface-cinematic-2:        #222222;
  --ps-surface-cinematic-3:        #333333;
  --ps-text-cinematic-secondary:   #8C8C8C;

  --ps-font-body: 'Pretendard Variable', 'Pretendard', 'Montserrat', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
  --ps-font-en:   'Montserrat', 'Pretendard Variable', 'Pretendard', sans-serif;
  --ps-font-signature: 'Covered By Your Grace', cursive;

  --ps-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
}

body {
  background: var(--ps-bg-cinematic);
  color: #FFFFFF;
  font-family: var(--ps-font-body);
  font-weight: 300;
  line-height: 1.6;
  word-break: keep-all;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }


/* ===== Layout ===== */
.wrap {
  max-width: 1108px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 768px) {
  .wrap { padding: 0 48px; }
}

section {
  padding: 96px 0;
}
@media (min-width: 768px) {
  section { padding: 120px 0; }
}

/* ===== Bilingual Section Header ===== */
.section-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 48px;
}
@media (min-width: 768px) {
  .section-header { flex-direction: row; align-items: baseline; gap: 16px; }
}
.section-header .ko {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 300;
  letter-spacing: -1.2px;
  line-height: 1.2;
  margin: 0;
  color: #FFFFFF;
}
.section-header .en {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Entry animation ===== */
section, .hero {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 800ms var(--ps-ease-out), transform 800ms var(--ps-ease-out);
}
section.in-view, .hero.in-view {
  opacity: 1;
  transform: none;
}
.hero { opacity: 1; transform: none; } /* hero is always visible */

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  section, .hero { opacity: 1; transform: none; transition: none; }
}


  /* ===== 글로벌 · 우상단 그레이스케일 메인 네비 + 라인 아이콘 ===== */
  .ps-topnav{position:fixed;top:16px;right:20px;z-index:90;font-family:var(--ps-font-en);font-size:12px;letter-spacing:.04em;
    color:#8C8C8C;display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border-radius:100px;
    border:1px solid rgba(255,255,255,.1);background:rgba(0,0,0,.4);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
    transition:color .18s,border-color .18s;text-decoration:none}
  .ps-topnav:hover{color:#fff;border-color:rgba(255,255,255,.25)}
  .ps-back{position:fixed;top:14px;left:16px;z-index:91;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;padding:6px;color:#8C8C8C;cursor:pointer;line-height:0;transition:color .18s}
  .ps-back:hover{color:#fff}
  .ico{display:inline-flex;align-items:center;justify-content:center;line-height:0}
  .ico svg{display:block}

  /* ===== ACADEMICA · 히어로 ===== */
  .aca-hero{padding:100px 0 18px}
  .aca-eyebrow{font-family:var(--ps-font-en);font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--ps-primary)}
  .aca-wordmark{font-family:var(--ps-font-en);font-weight:800;font-size:clamp(48px,12vw,128px);line-height:.86;letter-spacing:-.035em;margin:16px 0 0;text-transform:uppercase}
  .aca-wordmark .g{color:var(--ps-primary);text-shadow:0 0 46px rgba(255,177,26,.42)}
  .aca-tagline{margin:22px 0 0;max-width:560px;font-size:15px;line-height:1.75;color:#EDEDED;font-weight:300}
  .aca-tagline .amber{color:var(--ps-primary);font-weight:500}
  .aca-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}
  .aca-pill{display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:10px;font-size:14px;font-weight:600;font-family:var(--ps-font-body);border:1px solid var(--ps-surface-cinematic-3);color:#fff;transition:all .2s var(--ps-ease-out)}
  .aca-pill:hover{border-color:var(--ps-primary);color:var(--ps-primary)}

  /* ===== 책장 · 가로 flat 책 (카테고리별) ===== */
  .aca-hint{font-size:13px;color:var(--ps-text-cinematic-secondary);margin:-4px 0 24px}
  .shelf-cat{margin-bottom:30px}
  .shelf-cat-head{display:flex;align-items:baseline;gap:10px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--ps-surface-cinematic-2)}
  .shelf-cat-head .ko{font-size:15px;font-weight:700;color:#fff}
  .shelf-cat-head .en{font-family:var(--ps-font-en);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ps-text-cinematic-secondary)}
  .shelf-cat-head .cnt{margin-left:auto;font-family:var(--ps-font-en);font-size:11px;color:var(--ps-text-cinematic-secondary)}
  .shelf-cat-head .cnt b{color:var(--ps-primary)}
  .hbooks{display:flex;flex-direction:column;gap:8px}
  .hbook{display:flex;align-items:center;gap:14px;padding:0 16px;background:var(--ps-surface-cinematic-1);border:1px solid var(--ps-surface-cinematic-3);border-radius:8px;overflow:hidden;text-decoration:none;min-height:62px;transition:background .16s,border-color .16s}
  .hbook:hover{background:var(--ps-surface-cinematic-2);border-color:var(--ps-primary)}
  .hbook-ico{color:var(--ps-text-cinematic-secondary);flex:0 0 auto}
  .hbook:hover .hbook-ico{color:var(--ps-primary)}
  .hbook-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;padding:12px 0}
  .hbook-title{font-size:15px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hbook-meta{font-family:var(--ps-font-en);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ps-text-cinematic-secondary)}
  .hbook-go{color:var(--ps-text-cinematic-secondary);flex:0 0 auto}
  .hbook:hover .hbook-go{color:var(--ps-primary)}

</style>
<noscript><style>section,.hero{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body>

<button type="button" class="ps-back" aria-label="뒤로 가기" onclick="if(history.length>1){history.back()}else{location.href='/'}"><span class="ico" set:html={icon('arrowLeft', 20)}></span></button>

<a href="/" class="ps-topnav"><span class="ico" set:html={icon('home', 15)}></span> parcyun studio</a>

<!-- ===== HERO ===== -->
<section class="hero aca-hero">
  <div class="wrap">
    <div class="aca-eyebrow">Lecture Shelf</div>
    <h1 class="aca-wordmark">ACADE<span class="g">MICA</span></h1>
    <p class="aca-tagline">
      교육 · AI · 디자인 <span class="amber">강의 자료</span>를 카테고리별로 모아둔 서가예요.<br>
      아래에서 한 권씩 꺼내 보세요.
    </p>
    <div class="aca-actions">
      <a href="/atlas-gears/" class="aca-pill">교육 활동 자료 · ATLAS GEARS <span class="ico" set:html={icon('arrowRight', 16)}></span></a>
    </div>
  </div>
</section>

<!-- ===== 카테고리별 책장 ===== -->
<section id="shelf">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">강의 서가</h2>
      <span class="en">The Shelf</span>
    </header>
    <p class="aca-hint">카테고리별로 나뉜 책장이에요. 책을 클릭하면 해당 강의로 이동해요.</p>
    <LectureShelf client:load />
  </div>
</section>

<!-- ===== footer (플로팅) ===== -->
<PsFooter />


<script is:inline>
(function(){
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) { document.querySelectorAll('section').forEach(function(el){ el.classList.add('in-view'); }); return; }
  var io = new IntersectionObserver(function(entries){ entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -15% 0px', threshold: 0.05 });
  document.querySelectorAll('section').forEach(function(el){ io.observe(el); });
})();
</script>
<script is:inline src="/share-widget.js" defer></script>
<script is:inline src="/visitor-counter.js" defer></script>
</body>
</html>
