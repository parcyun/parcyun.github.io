---
import AdminLogin from '../components/AdminLogin.tsx';
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title>관리자 · parcyun studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
<style>
  :root{--ps-primary:#FFB11A;--ps-primary-dark:#E89500;--ps-bg-cinematic:#000;
    --ps-surface-cinematic-1:#141414;--ps-surface-cinematic-3:#333;--ps-text-cinematic-secondary:#8C8C8C;
    --ps-font-body:'Pretendard Variable','Pretendard','Montserrat',-apple-system,sans-serif;
    --ps-font-en:'Montserrat','Pretendard Variable',sans-serif;--ps-font-signature:'Covered By Your Grace',cursive}
  *{box-sizing:border-box}html,body{margin:0;padding:0}
  body{min-height:100vh;background:#000;color:#fff;font-family:var(--ps-font-body);font-weight:300;
    display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 24px;
    word-break:keep-all;-webkit-font-smoothing:antialiased}
  .a-sig{font-family:var(--ps-font-signature);font-size:34px;color:var(--ps-primary);line-height:1;margin-bottom:6px}
  .a-eyebrow{font-family:var(--ps-font-en);font-size:11px;font-weight:600;letter-spacing:.26em;text-transform:uppercase;color:var(--ps-text-cinematic-secondary);margin-bottom:28px}
  a.a-back{position:fixed;top:16px;left:18px;font-family:var(--ps-font-en);font-size:12px;color:var(--ps-text-cinematic-secondary);text-decoration:none}
  a.a-back:hover{color:var(--ps-primary)}
</style>
</head>
<body>
  <a class="a-back" href="/">← parcyun studio</a>
  <div class="a-sig">parcyun studio</div>
  <div class="a-eyebrow">Admin</div>
  <AdminLogin client:load />
</body>
</html>
