---
import ContentStudio from '../../components/ContentStudio.tsx';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" /><title>Design Studio · parcyun studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Pretendard:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root{--a:#ffb11a;--bg:#0f0e0d;--panel:#1b1a18;--line:#3b3934;--muted:#aaa49b;--ds-radius-control:12px;--ds-radius-panel:16px;--ds-radius-elevated:20px;--ps-primary:#ffb11a;--ps-primary-dark:#e89500;--ps-font-body:Pretendard,system-ui,sans-serif;--ps-font-en:Montserrat,sans-serif;--ps-text-cinematic-secondary:#aaa49b;--ps-surface-cinematic-1:#1b1a18;--ps-surface-cinematic-3:#3b3934}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:#f5f3ef;font-family:Pretendard,system-ui,sans-serif}.cs-shell{min-height:100vh;display:grid;grid-template-columns:222px minmax(420px,1fr) 392px}.cs-pages,.cs-inspector{background:#171614;border-color:var(--line)}.cs-pages{padding:24px 16px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:5px}.cs-back{font:12px Montserrat;color:var(--muted);text-decoration:none;margin:0 8px 32px}.cs-brand{font:300 18px/1 Montserrat;letter-spacing:.12em;margin:0 8px 36px}.cs-brand b{color:var(--a);font-weight:600}.cs-caption,.cs-pages button,.cs-canvas header small,.cs-inspector header small,.cs-manager-head small{font:10px/1 Montserrat;letter-spacing:.13em;color:var(--muted)}.cs-page-caption{margin-top:20px}.cs-pages button{border:0;background:transparent;color:#ddd;text-align:left;padding:11px 12px;border-radius:var(--ds-radius-control);cursor:pointer;font-size:12px}.cs-pages button span{color:#777;margin-right:8px}.cs-pages button:hover,.cs-pages button.active{background:#2a2824;color:#fff}.cs-pages button.active span{color:var(--a)}.cs-pages .cs-subnav{font-size:11px;padding-left:18px}.cs-tip{font-size:11px;line-height:1.7;color:#8f8a82;margin:auto 8px 6px}.cs-canvas{min-width:0;display:flex;flex-direction:column;height:100vh}.cs-canvas header,.cs-inspector>header,.cs-manager-head{height:72px;padding:16px 24px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.cs-canvas header div,.cs-inspector header,.cs-manager-head div{display:flex;flex-direction:column;gap:5px}.cs-canvas header strong,.cs-inspector header strong,.cs-manager-head strong{font-size:15px;font-weight:500}.cs-canvas header a{font:11px Montserrat;color:var(--a);text-decoration:none}.cs-frame{flex:1;min-height:300px;background:#11100f;padding:24px}.cs-frame iframe{width:100%;height:100%;border:1px solid #4a463f;background:#000;border-radius:var(--ds-radius-elevated)}.cs-elements{max-height:142px;overflow:auto;padding:16px 24px;border-top:1px solid var(--line);display:flex;gap:8px;flex-wrap:wrap}.cs-elements>span{width:100%;font:9px Montserrat;letter-spacing:.12em;color:#8f8a82}.cs-elements em{font-size:12px;color:#8f8a82}.cs-elements button{border:1px solid #4a463f;background:#25231f;color:#c7c1b8;border-radius:var(--ds-radius-control);padding:7px 10px;font-size:11px;cursor:pointer;max-width:270px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cs-elements button.chosen{border-color:var(--a);color:#fff}.cs-inspector{border-left:1px solid var(--line);height:100vh;overflow:auto}.cs-status{margin:16px;padding:10px 12px;border-radius:var(--ds-radius-control);background:#302a1c;color:#f6cf79;font-size:12px}.cs-panel{border-bottom:1px solid var(--line);padding:20px}.cs-panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.cs-panel-head b{font-size:13px;font-weight:600}.cs-panel-head span,.cs-panel-head button{font:10px Montserrat;color:var(--muted);background:none;border:0;padding:0;cursor:pointer}.cs-panel textarea{width:100%;min-height:96px;resize:vertical;background:#11100f;border:1px solid #4a463f;border-radius:var(--ds-radius-control);color:#eee;padding:11px 12px;font:13px/1.5 Pretendard}.cs-empty{margin:0;color:#8f8a82;font-size:12px;line-height:1.6}.cs-style-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.cs-style-grid label{display:flex;flex-direction:column;gap:5px;font-size:10px;color:#b6b0a7}.cs-style-grid input,.cs-style-grid select,.cs-section input,.cs-career-row input{width:100%;border:1px solid #4a463f;border-radius:var(--ds-radius-control);background:#11100f;color:#eee;padding:8px 9px;font:12px Pretendard}.cs-style-grid input[type=color]{height:36px;padding:4px}.cs-actions{display:flex;gap:8px;margin-top:14px}.cs-save,.cs-reset,.cs-section button,.cs-career-row button,.cs-add-row,.cs-add-career{border:0;border-radius:var(--ds-radius-control);padding:9px 12px;background:var(--a);color:#161616;font:600 11px Pretendard;cursor:pointer}.cs-reset{background:#37342f;color:#eee}.cs-section{border:1px solid #423f38;border-radius:var(--ds-radius-panel);padding:12px;margin-top:12px}.cs-section-title{display:grid;grid-template-columns:1fr auto auto;gap:6px}.cs-section-title button,.cs-career-row button{padding:6px 8px;font-size:10px;background:#37342f;color:#eee}.cs-section-title button:first-of-type,.cs-career-row button:first-child{background:#645423;color:#ffe6a7}.cs-career-row{border-top:1px solid #38352f;padding-top:10px;margin-top:10px;display:grid;grid-template-columns:58px 1fr;gap:6px}.cs-career-row input:nth-child(3){grid-column:2}.cs-career-row>div{grid-column:1/-1;display:flex;gap:6px;justify-content:flex-end}.cs-add-row{margin-top:10px;background:#302e2a;color:#eee;width:100%}.cs-add-career{margin-top:12px;width:100%;background:#302e2a;color:#eee}.cs-manager{min-height:100vh;background:#11100f}.cs-manager-head{background:#171614}.cs-manager-head>span{font:11px Montserrat;color:var(--a)}.cs-category-tabs{display:flex;gap:8px;padding:20px 24px 0}.cs-category-tabs button{border:1px solid #4a463f;border-radius:999px;background:transparent;color:#bdb7ad;padding:9px 14px;font:12px Pretendard;cursor:pointer}.cs-category-tabs button.active{border-color:var(--a);background:#302a1c;color:#ffe1a2}.cs-data{max-width:940px;margin:0 auto;padding:24px}.cs-data-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.cs-data-top p{margin:0;color:#bdb7ad;font-size:13px}.cs-data-top b{color:#fff;font-size:18px}.cs-data-list{display:grid;gap:10px}.cs-data-row{display:flex;justify-content:space-between;gap:18px;align-items:center;padding:18px 20px;background:#1b1a18;border:1px solid #3d3933;border-radius:var(--ds-radius-panel)}.cs-data-main{min-width:0;display:flex;flex-direction:column;gap:5px}.cs-data-main small,.cs-data-main span{font:10px Montserrat;color:#a79f95}.cs-data-main strong{font-size:15px;font-weight:500}.cs-data-main p{margin:0;color:#c0b9af;font-size:12px;line-height:1.55;max-width:66ch}.cs-row-actions{display:flex;gap:8px;flex:none}.cs-row-actions button{border:1px solid #4a463f;border-radius:var(--ds-radius-control);background:transparent;color:#e7e2da;padding:8px 10px;font:12px Pretendard;cursor:pointer}.cs-row-actions .danger{color:#e9978c}.cs-feedback{max-width:940px;margin:0 auto;padding:24px}.cs-feedback .fa{width:100%}.cs-feedback .fa-post{background:#1b1a18;border-color:#3d3933;border-radius:var(--ds-radius-panel)}.cs-lock{min-height:100vh;display:grid;place-content:center;gap:14px;background:#0f0e0d;color:#fff;font-family:Pretendard}.cs-lock a{color:#ffb11a;text-decoration:none}@media(max-width:980px){.cs-shell{grid-template-columns:178px minmax(360px,1fr)}.cs-inspector{grid-column:1/-1;height:auto;border-left:0;border-top:1px solid var(--line)}.cs-style-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:650px){.cs-shell{display:block}.cs-pages{border-right:0;border-bottom:1px solid var(--line);flex-direction:row;overflow:auto;padding:12px}.cs-pages .cs-brand,.cs-pages .cs-tip,.cs-pages .cs-caption{display:none}.cs-pages button{white-space:nowrap}.cs-back{margin:10px}.cs-canvas{height:72vh}.cs-frame{padding:12px}.cs-style-grid{grid-template-columns:1fr 1fr}.cs-data{padding:16px}.cs-data-row{align-items:flex-start;flex-direction:column}.cs-row-actions{width:100%}.cs-row-actions button{flex:1}}
  </style>
  <style is:global>
    .is-published{color:var(--a);font:600 11px Montserrat;text-transform:lowercase}.review-status{font:600 10px Montserrat;text-transform:lowercase}.review-status.is-pending{color:var(--a)}.review-status.is-published{color:var(--a)}.review-status.is-rejected{color:#e58b8b}.approve-review:disabled{filter:grayscale(1);opacity:.45;cursor:not-allowed;color:#aaa;background:#2a2927;border-color:#444}.service-tag{display:inline-flex;align-items:center;padding:3px 7px;border:1px solid #4a463f;border-radius:999px;color:#bdb7ad;font:10px Montserrat}.cs-row-actions select{border:1px solid #4a463f;border-radius:var(--ds-radius-control);background:#171614;color:#eee;padding:7px 8px;font:11px Pretendard}.cs-save:disabled{opacity:.45;cursor:not-allowed}
    .cs-manager{grid-column:2/-1}.cs-component-workspace{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:20px;padding:24px;min-height:calc(100vh - 72px)}
    .cs-footer-stage{min-width:0;display:flex;flex-direction:column;gap:12px;padding:16px;background:#171614;border:1px solid #3d3933;border-radius:var(--ds-radius-elevated)}
    .cs-footer-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .cs-context-switch,.cs-viewport-switch{display:flex;gap:3px;padding:3px;background:#11100f;border:1px solid #3d3933;border-radius:var(--ds-radius-control)}
    .cs-context-switch button,.cs-viewport-switch button{border:0;border-radius:9px;background:transparent;color:#aaa49b;padding:7px 9px;font:10px Montserrat;cursor:pointer}
    .cs-context-switch button.active,.cs-viewport-switch button.active{background:#37342f;color:#fff}
    .cs-context-switch button:focus-visible,.cs-viewport-switch button:focus-visible{outline:2px solid var(--a);outline-offset:2px}
    .cs-footer-frame{position:relative;flex:1;min-height:480px;width:100%;margin:auto;border:1px solid #4a463f;border-radius:var(--ds-radius-panel);overflow:hidden;background:#0f0e0d;transition:width .2s}
    .cs-footer-frame.mobile{width:390px;max-width:100%}.cs-footer-frame iframe{display:block;width:100%;height:100%;min-height:480px;border:0}
    .cs-footer-badge{position:absolute;z-index:2;top:8px;left:8px;padding:5px 8px;border-radius:8px;background:var(--a);color:#16120a;font:600 9px Montserrat;letter-spacing:.08em}
    .cs-component-manager{width:100%;max-width:none;margin:0;padding:20px;background:#171614;border:1px solid #3d3933;border-radius:var(--ds-radius-elevated);align-self:start}
    .cs-component-manager .cs-data-top{align-items:flex-start;gap:12px}.cs-component-manager .cs-row-actions{flex-wrap:wrap;justify-content:flex-end}.cs-component-manager button:disabled{opacity:.4;cursor:not-allowed}
    .cs-component-field{display:grid;grid-template-columns:minmax(0,1fr) 32px;gap:4px}.cs-component-field button{border:1px solid #4a463f;border-radius:9px;background:#25231f;color:#bdb7ad;cursor:pointer}.cs-error{background:#3b211e;color:#ffc0b5}
    .ds-inspector{border-top:1px solid var(--line);background:#171614}.ds-object-head{position:sticky;top:0;z-index:3;display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 20px;background:#171614;border-bottom:1px solid var(--line)}
    .ds-object-head>div{min-width:0;display:flex;flex-direction:column;gap:5px}.ds-object-head small{font:9px/1 Montserrat;letter-spacing:.11em;color:#aaa49b}.ds-object-head strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px;font-weight:600}.ds-object-head code{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#aaa49b;font:10px/1.3 Montserrat}
    .ds-dirty{flex:none;border:1px solid #8a6721;border-radius:999px;padding:4px 7px;background:#302a1c;color:#ffd47d;font-size:9px}.ds-actions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;padding:8px 12px;border-bottom:1px solid var(--line)}
    .ds-actions button,.ds-field button,.ds-section-head{border:1px solid #45413b;border-radius:7px;background:#25231f;color:#d8d2c9;min-height:30px;padding:6px 8px;font:500 10px Pretendard;cursor:pointer}.ds-actions button:hover:not(:disabled),.ds-field button:hover:not(:disabled){background:#312e29;border-color:#615b52}.ds-actions .primary{border-color:#d7920b;background:var(--a);color:#18130a;font-weight:700}.ds-actions button:disabled,.ds-field button:disabled{opacity:.38;cursor:not-allowed}
    .ds-section{border-bottom:1px solid var(--line)}.ds-section-head{width:100%;display:flex;justify-content:space-between;align-items:center;border:0;border-radius:0;background:#171614;padding:10px 16px;color:#f0ece6;font:600 11px Montserrat;letter-spacing:.03em}.ds-section-head:hover{background:#201e1b}.ds-section-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:4px 12px 14px}
    .ds-field{min-width:0;display:flex;flex-direction:column;gap:4px}.ds-field-label{display:flex;align-items:center;justify-content:space-between;gap:4px}.ds-field-label label{color:#c3bdb4;font-size:10px}.ds-field-label button{min-height:22px;width:24px;padding:2px;color:#aaa49b;background:transparent;border-color:transparent}.ds-field input,.ds-field select{min-width:0;width:100%;height:32px;border:1px solid #48443e;border-radius:7px;background:#11100f;color:#f1eee9;padding:6px 8px;font:11px Pretendard}.ds-field input:hover,.ds-field select:hover{border-color:#625d54}.ds-field input:focus-visible,.ds-field select:focus-visible,.ds-actions button:focus-visible,.ds-section-head:focus-visible{outline:2px solid var(--a);outline-offset:2px;border-color:transparent}
    .ds-number-unit,.ds-opacity{display:grid;grid-template-columns:minmax(0,1fr) 62px;gap:4px}.ds-opacity{grid-template-columns:minmax(0,1fr) 58px}.ds-opacity input[type=range]{padding:4px}.ds-color-control{display:grid;grid-template-columns:32px minmax(0,1fr);gap:4px}.ds-swatch{position:relative;border:1px solid #48443e;border-radius:7px;overflow:hidden;background:#222}.ds-swatch.empty{background:#1b1a18}.ds-swatch.empty::after{content:'—';position:absolute;inset:0;display:grid;place-items:center;color:#716b62;font-size:16px}.ds-swatch input{position:absolute;inset:-4px;width:40px;height:40px;padding:0;border:0;opacity:0;cursor:pointer}.ds-color-control>div{position:relative}.ds-input-prefix{position:absolute;left:8px;top:10px;color:#918b82;font:8px Montserrat;pointer-events:none}.ds-color-control input[type=text]{padding-left:31px}.ds-provenance{min-height:13px;color:#aaa49b;font-size:9px;line-height:1.45;overflow-wrap:anywhere}.ds-field-error{color:#ff9d91;font-size:9px;line-height:1.4}.ds-field input[aria-invalid=true]{border-color:#d96859}.ds-toggle{display:flex;align-items:center;gap:7px;min-height:32px}.ds-toggle input{width:16px;height:16px}.ds-toggle span{font-size:11px;color:#ddd}
    .cs-component-manager{padding:0;overflow:hidden}.cs-component-manager .ds-inspector{border-top:0}.cs-component-manager>.cs-status{margin:12px}.cs-component-manager .ds-section-fields{grid-template-columns:1fr}.cs-component-manager .ds-object-head{position:static}
    @media(max-width:900px){.cs-component-workspace{grid-template-columns:1fr}.cs-component-manager{order:2}}
    @media(max-width:650px){.ds-section-fields{grid-template-columns:1fr}.ds-object-head{position:static}}
  </style>
</head>
<body><ContentStudio client:load /></body>
</html>
