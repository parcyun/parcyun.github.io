---
import ContentStudio from '../../components/ContentStudio.tsx';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" /><title>Content Studio · parcyun studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Pretendard:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root{--a:#ffb11a;--bg:#161616;--panel:#202020;--line:#363636;--muted:#8c8c8c}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:#f5f5f5;font-family:Pretendard,system-ui,sans-serif}.cs-shell{min-height:100vh;display:grid;grid-template-columns:206px minmax(420px,1fr) 380px}.cs-pages,.cs-inspector{background:#1b1b1b;border-color:var(--line)}.cs-pages{padding:22px 14px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:5px}.cs-back{font:12px Montserrat;color:var(--muted);text-decoration:none;margin:0 6px 30px}.cs-brand{font:300 17px/1 Montserrat;letter-spacing:.12em;margin:0 6px 35px}.cs-brand b{color:var(--a);font-weight:600}.cs-caption,.cs-pages button,.cs-canvas header small,.cs-inspector header small{font:10px/1 Montserrat;letter-spacing:.13em;color:var(--muted)}.cs-pages button{border:0;background:transparent;color:#ddd;text-align:left;padding:11px 10px;border-radius:6px;cursor:pointer;font-size:11px}.cs-pages button span{color:#777;margin-right:8px}.cs-pages button:hover,.cs-pages button.active{background:#2a2a2a;color:#fff}.cs-pages button.active span{color:var(--a)}.cs-tip{font-size:11px;line-height:1.65;color:#777;margin:auto 7px 5px}.cs-canvas{min-width:0;display:flex;flex-direction:column;height:100vh}.cs-canvas header,.cs-inspector>header{height:64px;padding:13px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.cs-canvas header div,.cs-inspector header{display:flex;flex-direction:column;gap:5px}.cs-canvas header strong,.cs-inspector header strong{font-size:14px;font-weight:500}.cs-canvas header a{font:11px Montserrat;color:var(--a);text-decoration:none}.cs-frame{flex:1;min-height:300px;background:#0d0d0d;padding:22px}.cs-frame iframe{width:100%;height:100%;border:1px solid #444;background:#000;border-radius:8px}.cs-elements{max-height:130px;overflow:auto;padding:12px 20px;border-top:1px solid var(--line);display:flex;gap:6px;flex-wrap:wrap}.cs-elements>span{width:100%;font:9px Montserrat;letter-spacing:.12em;color:#777}.cs-elements em{font-size:12px;color:#777}.cs-elements button{border:1px solid #444;background:#252525;color:#bbb;border-radius:5px;padding:6px 8px;font-size:11px;cursor:pointer;max-width:270px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cs-elements button.chosen{border-color:var(--a);color:#fff}.cs-inspector{border-left:1px solid var(--line);height:100vh;overflow:auto}.cs-status{margin:12px 16px;padding:9px 10px;border-radius:6px;background:#2a271f;color:#f6cf79;font-size:12px}.cs-panel{border-bottom:1px solid var(--line);padding:16px}.cs-panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.cs-panel-head b{font-size:13px;font-weight:600}.cs-panel-head span,.cs-panel-head button{font:10px Montserrat;color:var(--muted);background:none;border:0;padding:0;cursor:pointer}.cs-panel textarea{width:100%;min-height:92px;resize:vertical;background:#111;border:1px solid #3a3a3a;border-radius:6px;color:#eee;padding:10px;font:13px/1.5 Pretendard}.cs-empty{margin:0;color:#777;font-size:12px;line-height:1.6}.cs-style-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.cs-style-grid label{display:flex;flex-direction:column;gap:5px;font-size:10px;color:#aaa}.cs-style-grid input,.cs-style-grid select,.cs-section input,.cs-career-row input{width:100%;border:1px solid #3d3d3d;border-radius:4px;background:#111;color:#eee;padding:7px 8px;font:12px Pretendard}.cs-style-grid input[type=color]{height:32px;padding:3px}.cs-actions{display:flex;gap:7px;margin-top:12px}.cs-save,.cs-reset,.cs-section button,.cs-career-row button,.cs-add-row,.cs-add-career{border:0;border-radius:5px;padding:8px 10px;background:var(--a);color:#161616;font:600 11px Pretendard;cursor:pointer}.cs-reset{background:#333;color:#ddd}.cs-section{border:1px solid #373737;border-radius:6px;padding:9px;margin-top:10px}.cs-section-title{display:grid;grid-template-columns:1fr auto auto;gap:5px}.cs-section-title button,.cs-career-row button{padding:5px 6px;font-size:10px;background:#333;color:#ddd}.cs-section-title button:first-of-type,.cs-career-row button:first-child{background:#645423;color:#ffe6a7}.cs-career-row{border-top:1px solid #303030;padding-top:8px;margin-top:8px;display:grid;grid-template-columns:58px 1fr;gap:5px}.cs-career-row input:nth-child(3){grid-column:2}.cs-career-row>div{grid-column:1/-1;display:flex;gap:5px;justify-content:flex-end}.cs-add-row{margin-top:8px;background:#2b2b2b;color:#ddd;width:100%}.cs-add-career{margin-top:10px;width:100%;background:#2b2b2b;color:#ddd}.cs-lock{min-height:100vh;display:grid;place-content:center;gap:14px;background:#000;color:#fff;font-family:Pretendard}.cs-lock a{color:#ffb11a;text-decoration:none}@media(max-width:980px){.cs-shell{grid-template-columns:160px minmax(360px,1fr)}.cs-inspector{grid-column:1/-1;height:auto;border-left:0;border-top:1px solid var(--line)}.cs-style-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:650px){.cs-shell{display:block}.cs-pages{border-right:0;border-bottom:1px solid var(--line);flex-direction:row;overflow:auto;padding:12px}.cs-pages .cs-brand,.cs-pages .cs-tip,.cs-pages .cs-caption{display:none}.cs-pages button{white-space:nowrap}.cs-back{margin:10px}.cs-canvas{height:72vh}.cs-frame{padding:10px}.cs-style-grid{grid-template-columns:1fr 1fr}}
  </style>
</head>
<body><ContentStudio client:load /></body>
</html>
