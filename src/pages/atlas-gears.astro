---
import ActivityBrowser from '../components/ActivityBrowser.tsx';
import { resources, ACTIVITY_TYPES } from '../data/resources';
import { icon } from '../lib/icons';
const activities = resources.filter((r) => r.category === '교육 활동 자료');
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ATLAS GEARS · 교육 활동 자료 · parcyun studio</title>
<meta name="description" content="교실에서 바로 꺼내 쓰는 교육 활동 자료 모음. 게임·인터랙티브·활동지·커리큘럼을 검색해 오늘 수업에 딱 맞는 자료를 찾아보세요. Designed by parcyun studio." />
<meta property="og:title" content="ATLAS GEARS · parcyun studio" />
<meta property="og:description" content="교실에서 바로 꺼내 쓰는 교육 활동 자료 모음." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://parcyun.github.io/atlas-gears/" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

<style is:global>

/* === parcyun studio · Cinematic Mode tokens === */
:root {
  --ps-primary:                    #FFB11A;
  --ps-primary-dark:               #E89500;

  --ps-bg-cinematic:               #000000;
  --ps-surface-cinematic-1:        #141414;
  --ps-surface-cinematic-2:        #222222;
  --ps-surface-cinematic-3:        #333333;
  --ps-text-cinematic-secondary:   #8C8C8C;

  --ps-font-body: 'Pretendard Variable', 'Pretendard', 'Montserrat', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
  --ps-font-en:   'Montserrat', 'Pretendard Variable', 'Pretendard', sans-serif;
  --ps-font-signature: 'Covered By Your Grace', cursive;

  --ps-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
}

body {
  background: var(--ps-bg-cinematic);
  color: #FFFFFF;
  font-family: var(--ps-font-body);
  font-weight: 300;
  line-height: 1.6;
  word-break: keep-all;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }

/* ===== Top corner mark ===== */
.ps-corner {
  position: fixed;
  top: 20px;
  left: 24px;
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.5px;
  color: var(--ps-text-cinematic-secondary);
  z-index: 90;
  transition: color 240ms var(--ps-ease-out);
}
.ps-corner:hover { color: var(--ps-primary); }

/* ===== Layout ===== */
.wrap {
  max-width: 1108px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 768px) {
  .wrap { padding: 0 48px; }
}

section {
  padding: 96px 0;
}
@media (min-width: 768px) {
  section { padding: 120px 0; }
}

/* ===== Bilingual Section Header ===== */
.section-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 48px;
}
@media (min-width: 768px) {
  .section-header { flex-direction: row; align-items: baseline; gap: 16px; }
}
.section-header .ko {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 300;
  letter-spacing: -1.2px;
  line-height: 1.2;
  margin: 0;
  color: #FFFFFF;
}
.section-header .en {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Mandatory parcyun footer ===== */
.ps-footer {
  position: fixed;
  bottom: 16px;
  right: 20px;
  font-family: var(--ps-font-en);
  font-weight: 300;
  font-size: 11px;
  color: var(--ps-text-cinematic-secondary);
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 6px 12px;
  border-radius: 100px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.ps-signature {
  font-family: var(--ps-font-signature);
  font-size: 15px;
  color: var(--ps-primary);
  line-height: 1;
}
.ps-ig {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: inherit;
  text-decoration: none;
  margin-left: 4px;
}
.ps-ig:hover { color: var(--ps-primary); }
.ps-ig-icon { width: 10px; height: 10px; vertical-align: middle; }

/* ===== Entry animation ===== */
section, .hero {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 800ms var(--ps-ease-out), transform 800ms var(--ps-ease-out);
}
section.in-view, .hero.in-view {
  opacity: 1;
  transform: none;
}
.hero { opacity: 1; transform: none; } /* hero is always visible */

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  section, .hero { opacity: 1; transform: none; transition: none; }
}

/* ===== Floating nav (top / bottom) ===== */
.float-nav {
  position: fixed;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 80;
}
.float-nav button {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  font-family: var(--ps-font-en);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 240ms var(--ps-ease-out), color 240ms var(--ps-ease-out), transform 240ms var(--ps-ease-out);
}
.float-nav button:hover {
  border-color: var(--ps-primary);
  color: var(--ps-primary);
  transform: translateY(-2px);
}
@media (max-width: 639px) {
  .float-nav { right: 12px; gap: 6px; }
  .float-nav button { width: 36px; height: 36px; font-size: 13px; }
}

/* ===== Footer (ps-footer) · 업무 대시보드 link ===== */
.ps-footer-link {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.3px;
  color: var(--ps-text-cinematic-secondary);
  text-decoration: none;
  padding-right: 10px;
  margin-right: 4px;
  border-right: 1px solid rgba(255, 255, 255, 0.14);
  transition: color 240ms var(--ps-ease-out);
}
.ps-footer-link:hover { color: var(--ps-primary); }
.ps-footer-coffee {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.3px;
  color: var(--ps-primary);
  background: transparent;
  border: 0;
  padding: 0 10px 0 0;
  margin-right: 4px;
  border-right: 1px solid rgba(255, 255, 255, 0.14);
  cursor: pointer;
  transition: color 240ms var(--ps-ease-out);
}
.ps-footer-coffee:hover { color: var(--ps-primary-dark); }

/* ===== 커피 후원 QR 팝업 ===== */
.coffee-modal {
  position: fixed; inset: 0; z-index: 10000;
  display: flex; align-items: center; justify-content: center; padding: 24px;
}
.coffee-modal[hidden] { display: none; }
.coffee-backdrop {
  position: absolute; inset: 0;
  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  animation: coffeeFade 0.2s var(--ps-ease-out);
}
@keyframes coffeeFade { from { opacity: 0; } to { opacity: 1; } }
.coffee-card {
  position: relative; z-index: 1;
  background: var(--ps-surface-cinematic-1);
  border: 1px solid var(--ps-primary);
  border-radius: 18px;
  padding: 32px 32px 26px;
  text-align: center; max-width: 340px; width: 100%;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(255, 177, 26, 0.12);
  animation: coffeePop 0.28s var(--ps-ease-out);
}
@keyframes coffeePop { from { opacity: 0; transform: translateY(16px) scale(0.96); } to { opacity: 1; transform: none; } }
.coffee-close {
  position: absolute; top: 12px; right: 16px;
  background: transparent; border: 0;
  color: var(--ps-text-cinematic-secondary);
  font-size: 24px; line-height: 1; cursor: pointer;
  transition: color 150ms var(--ps-ease-out);
}
.coffee-close:hover { color: var(--ps-primary); }
.coffee-emoji { font-size: 40px; line-height: 1; margin-bottom: 10px; }
.coffee-title { margin: 0 0 6px; font-size: 19px; font-weight: 500; color: #FFFFFF; }
.coffee-sub { margin: 0 0 20px; font-size: 13px; font-weight: 300; color: var(--ps-text-cinematic-secondary); line-height: 1.6; }
.coffee-qr { display: block; width: 220px; height: 220px; margin: 0 auto 14px; border-radius: 12px; background: #fff; padding: 10px; object-fit: contain; }
.coffee-qr-fallback { display: none; margin: 0 auto 14px; padding: 40px 16px; border: 1px dashed var(--ps-surface-cinematic-3); border-radius: 12px; font-family: var(--ps-font-en); font-size: 12px; color: var(--ps-text-cinematic-secondary); }
.coffee-label { font-family: var(--ps-font-signature); font-size: 20px; color: var(--ps-primary); }


  /* ===== 글로벌 · 우상단 네비 + 라인 아이콘 ===== */
  .ps-topnav{position:fixed;top:16px;right:20px;z-index:90;font-family:var(--ps-font-en);font-size:12px;letter-spacing:.04em;color:#8C8C8C;display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border-radius:100px;border:1px solid rgba(255,255,255,.1);background:rgba(0,0,0,.4);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);transition:color .18s,border-color .18s;text-decoration:none}
  .ps-topnav:hover{color:#fff;border-color:rgba(255,255,255,.25)}
  .ps-back{position:fixed;top:16px;left:20px;z-index:91;width:38px;height:38px;display:inline-flex;align-items:center;justify-content:center;border-radius:100px;border:1px solid rgba(255,255,255,.1);background:rgba(0,0,0,.4);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:#8C8C8C;cursor:pointer;padding:0;transition:color .18s,border-color .18s}
  .ps-back:hover{color:#fff;border-color:rgba(255,255,255,.25)}
  .ico{display:inline-flex;align-items:center;justify-content:center;line-height:0}
  .ico svg{display:block}
  .ps-footer-coffee .ico{margin-right:1px}

  /* ===== ATLAS GEARS · 히어로 ===== */
  .atlas-hero{padding:100px 0 22px}
  .atlas-eyebrow{font-family:var(--ps-font-en);font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--ps-primary)}
  .atlas-wordmark{font-family:var(--ps-font-en);font-weight:800;font-size:clamp(52px,13vw,140px);line-height:.86;letter-spacing:-.035em;margin:16px 0 0;text-transform:uppercase}
  .atlas-wordmark .g{color:var(--ps-primary);text-shadow:0 0 46px rgba(255,177,26,.42)}
  .atlas-tagline{margin:22px 0 0;max-width:560px;font-size:15px;line-height:1.75;color:#EDEDED;font-weight:300}
  .atlas-tagline .amber{color:var(--ps-primary);font-weight:500}
  .atlas-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}
  .atlas-pill{display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:10px;font-size:14px;font-weight:600;font-family:var(--ps-font-body);border:1px solid var(--ps-surface-cinematic-3);color:#fff;transition:all .2s var(--ps-ease-out)}
  .atlas-pill:hover{border-color:var(--ps-primary);color:var(--ps-primary)}
  .atlas-hint{font-size:13px;color:var(--ps-text-cinematic-secondary);margin:-4px 0 20px}

  /* ===== 검색/필터 (톤 통일 · 플랫) ===== */
  .ab-controls{display:flex;flex-direction:column;gap:12px;margin-bottom:6px}
  .rx-row{display:flex;flex-direction:column;gap:10px}
  .rx-search{position:relative;display:flex;align-items:center}
  .rx-search-icon{position:absolute;left:15px;color:var(--ps-text-cinematic-secondary);pointer-events:none;display:inline-flex}
  .rx-input{width:100%;padding:13px 16px 13px 44px;border-radius:12px;background:var(--ps-surface-cinematic-1);border:1px solid var(--ps-surface-cinematic-3);color:#fff;font-family:var(--ps-font-body);font-size:14px;font-weight:300;transition:border-color .2s var(--ps-ease-out)}
  .rx-input::placeholder{color:var(--ps-text-cinematic-secondary)}
  .rx-input:focus{outline:none;border-color:var(--ps-primary)}
  .rx-reset{position:absolute;right:9px;padding:6px 12px;border:0;border-radius:100px;cursor:pointer;background:var(--ps-surface-cinematic-3);color:#fff;font-size:12px;font-family:var(--ps-font-body);white-space:nowrap;transition:all .18s var(--ps-ease-out)}
  .rx-reset:hover{background:var(--ps-primary);color:#000}
  .rx-tabs{display:flex;gap:7px;flex-wrap:wrap}
  .rx-tab{padding:8px 15px;border-radius:100px;cursor:pointer;font-size:13px;font-weight:500;background:transparent;border:1px solid var(--ps-surface-cinematic-3);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-body);transition:all .18s var(--ps-ease-out)}
  .rx-tab:hover{border-color:var(--ps-primary);color:#fff}
  .rx-tab.on{background:var(--ps-primary);border-color:var(--ps-primary);color:#000;font-weight:700}
  .rx-tags{display:flex;gap:6px;flex-wrap:wrap}
  .rx-chip{padding:5px 11px;border-radius:100px;cursor:pointer;font-size:11.5px;background:transparent;border:1px solid var(--ps-surface-cinematic-2);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-en);transition:all .16s var(--ps-ease-out)}
  .rx-chip:hover{border-color:var(--ps-primary);color:#fff}
  .rx-chip.on{background:rgba(255,177,26,.14);border-color:var(--ps-primary);color:var(--ps-primary);font-weight:700}
  .rx-count{font-family:var(--ps-font-en);font-size:12px;letter-spacing:.08em;color:var(--ps-text-cinematic-secondary);text-transform:uppercase;margin:16px 0 4px}
  .rx-count b{color:var(--ps-primary);font-weight:700;font-size:14px;margin-right:4px}
  .rx-empty{text-align:center;padding:48px 20px;border:1px dashed var(--ps-surface-cinematic-3);border-radius:14px;margin-top:10px}
  .rx-empty-big{font-family:var(--ps-font-en);font-size:18px;font-weight:600;color:#fff;margin:0 0 8px}
  .rx-empty-sub{font-size:13px;color:var(--ps-text-cinematic-secondary);margin:0 0 18px}

  /* ===== 컴팩트 카드 (썸네일=라인 아이콘) ===== */
  .act-grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:2px}
  @media(min-width:640px){.act-grid{grid-template-columns:1fr 1fr}}
  .act-card{display:flex;gap:15px;padding:15px;border-radius:14px;background:var(--ps-surface-cinematic-1);border:1px solid var(--ps-surface-cinematic-3);text-decoration:none;transition:transform .22s var(--ps-ease-out),border-color .22s}
  .act-card:hover{border-color:var(--ps-primary);transform:translateY(-3px)}
  .act-thumb{flex:0 0 60px;width:60px;height:60px;border-radius:12px;display:grid;place-items:center;color:var(--ps-primary);background:var(--ps-surface-cinematic-2);border:1px solid var(--ps-surface-cinematic-3)}
  .act-body{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
  .act-type{align-self:flex-start;font-family:var(--ps-font-en);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ps-primary);border:1px solid rgba(255,177,26,.35);padding:2px 8px;border-radius:100px}
  .act-title{margin:3px 0 0;font-size:15px;font-weight:700;color:#fff;line-height:1.3}
  .act-desc{margin:0;font-size:12px;line-height:1.55;color:var(--ps-text-cinematic-secondary);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .act-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:5px}
  .tag-pill.sm{font-size:10px;padding:2px 8px}
  .act-card.placeholder{align-items:center;justify-content:center;min-height:90px;border-style:dashed;opacity:.5}
  .act-card.placeholder span{font-size:12.5px;color:var(--ps-text-cinematic-secondary)}

  /* ===== 타입 카테고리 헤더 ===== */
  .type-section{margin-bottom:32px}
  .ab .type-section:first-of-type{margin-top:20px}
  .type-head{display:flex;align-items:center;gap:9px;margin:0 0 14px;padding-bottom:11px;border-bottom:1px solid var(--ps-surface-cinematic-2)}
  .type-head .type-ico{color:var(--ps-primary)}
  .type-head .ko{font-size:17px;font-weight:700;color:#fff}
  .type-head .en{font-family:var(--ps-font-en);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ps-text-cinematic-secondary)}
  .type-head .cnt{margin-left:auto;font-family:var(--ps-font-en);font-size:11px;color:var(--ps-text-cinematic-secondary)}
  .type-head .cnt b{color:var(--ps-primary)}

</style>
</head>
<body>

<button type="button" class="ps-back" aria-label="뒤로 가기" onclick="if(history.length>1){history.back()}else{location.href='/'}"><span class="ico" set:html={icon('arrowLeft', 18)}></span></button>

<a href="/" class="ps-topnav"><span class="ico" set:html={icon('home', 15)}></span> parcyun studio</a>

<!-- ===== HERO ===== -->
<section class="hero atlas-hero">
  <div class="wrap">
    <div class="atlas-eyebrow">Classroom Activity Kit</div>
    <h1 class="atlas-wordmark">ATLAS <span class="g">GEARS</span></h1>
    <p class="atlas-tagline">
      교실에서 바로 꺼내 쓰는 <span class="amber">교육 활동 자료</span> 모음이에요.<br>
      게임 · 인터랙티브 · 활동지 · 커리큘럼을 검색해 오늘 수업에 딱 맞는 걸 골라보세요.
    </p>
    <div class="atlas-actions">
      <a href="/academica/" class="atlas-pill">강의 자료 · ACADEMICA <span class="ico" set:html={icon('arrowRight', 16)}></span></a>
    </div>
  </div>
</section>

<!-- ===== 활동 자료 (검색 + 카테고리별 · 단일 아일랜드) ===== -->
<section id="browse">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">활동 자료</h2>
      <span class="en">Activities</span>
    </header>
    <p class="atlas-hint">검색하거나 카테고리·태그로 골라보세요. 아래 목록이 바로 필터돼요.</p>
    <ActivityBrowser client:load resources={activities} types={ACTIVITY_TYPES} />
  </div>
</section>

<!-- ===== footer (플로팅) ===== -->
<footer class="ps-footer">
  <button class="ps-footer-coffee" id="ps-coffee"><span class="ico" set:html={icon('coffee', 15)}></span> 커피 사주기</button>
  Designed by
  <span class="ps-signature">parcyun studio</span>
  <a href="https://www.instagram.com/parcyun" class="ps-ig" target="_blank" rel="noopener">
    <svg class="ps-ig-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4 1 .5.4.8.8 1 1.4.2.4.3 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-1 1.4-.4.5-.8.8-1.4 1-.4.2-1 .3-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-1-.5-.4-.8-.8-1-1.4-.2-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 1-1.4.4-.5.8-.8 1.4-1 .4-.2 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 5.5a4.3 4.3 0 100 8.6 4.3 4.3 0 000-8.6zm5.4-.3a1 1 0 11-2 0 1 1 0 012 0zM12 9.5a2.5 2.5 0 110 5 2.5 2.5 0 010-5z"/></svg>
    @parcyun
  </a>
</footer>

<!-- 커피 후원 QR 팝업 -->
<div class="coffee-modal" id="coffee-modal" hidden>
  <div class="coffee-backdrop" data-coffee-close></div>
  <div class="coffee-card" role="dialog" aria-modal="true" aria-labelledby="coffee-title">
    <button class="coffee-close" id="coffee-close" type="button" aria-label="닫기">×</button>
    <div class="coffee-emoji ico" set:html={icon('coffee', 40)}></div>
    <h3 class="coffee-title" id="coffee-title">개발자에게 커피 한 잔</h3>
    <p class="coffee-sub">QR을 스캔해 후원할 수 있어요. 감사합니다!</p>
    <img class="coffee-qr" src="/images/coffee-qr.png" alt="parcyun studio 후원 QR" onerror="this.style.display='none';this.nextElementSibling.style.display='block'" />
    <div class="coffee-qr-fallback">QR 이미지를 불러올 수 없습니다.</div>
    <div class="coffee-label">parcyun studio</div>
  </div>
</div>

<script is:inline>
(function(){var m=document.getElementById('coffee-modal');function o(){m.hidden=false}function c(){m.hidden=true}document.getElementById('ps-coffee').addEventListener('click',o);document.getElementById('coffee-close').addEventListener('click',c);m.addEventListener('click',function(e){if(e.target.hasAttribute('data-coffee-close'))c()});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!m.hidden)c()});})();
(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { document.querySelectorAll('section').forEach(function(el){ el.classList.add('in-view'); }); return; }
  var io = new IntersectionObserver(function(entries){ entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -15% 0px', threshold: 0.05 });
  document.querySelectorAll('section').forEach(function(el){ io.observe(el); });
})();
</script>
<script is:inline src="/share-widget.js" defer></script>
<script is:inline src="/visitor-counter.js" defer></script>
</body>
</html>
