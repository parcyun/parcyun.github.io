---
import ResourceExplorer from '../components/ResourceExplorer.tsx';
import ResourceCard from '../components/ResourceCard.astro';
import { resources } from '../data/resources';
const activities = resources.filter((r) => r.category === '교육 활동 자료');
const bySubject = (s: string) => activities.filter((r) => r.subject === s);
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ATLAS GEARS · 교육 활동 자료 · parcyun studio</title>
<meta name="description" content="교실에서 바로 꺼내 쓰는 교육 활동 자료 모음. 검색해서 오늘 수업에 딱 맞는 자료를 찾아보세요. Designed by parcyun studio." />
<meta property="og:title" content="ATLAS GEARS · parcyun studio" />
<meta property="og:description" content="교실에서 바로 꺼내 쓰는 교육 활동 자료 모음." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://parcyun.github.io/atlas-gears/" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

<style is:global>

/* === parcyun studio · Cinematic Mode tokens === */
:root {
  --ps-primary:                    #FFB11A;
  --ps-primary-dark:               #E89500;

  --ps-bg-cinematic:               #000000;
  --ps-surface-cinematic-1:        #141414;
  --ps-surface-cinematic-2:        #222222;
  --ps-surface-cinematic-3:        #333333;
  --ps-text-cinematic-secondary:   #8C8C8C;

  --ps-font-body: 'Pretendard Variable', 'Pretendard', 'Montserrat', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
  --ps-font-en:   'Montserrat', 'Pretendard Variable', 'Pretendard', sans-serif;
  --ps-font-signature: 'Covered By Your Grace', cursive;

  --ps-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
}

body {
  background: var(--ps-bg-cinematic);
  color: #FFFFFF;
  font-family: var(--ps-font-body);
  font-weight: 300;
  line-height: 1.6;
  word-break: keep-all;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }

/* ===== Top corner mark ===== */
.ps-corner {
  position: fixed;
  top: 20px;
  left: 24px;
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.5px;
  color: var(--ps-text-cinematic-secondary);
  z-index: 90;
  transition: color 240ms var(--ps-ease-out);
}
.ps-corner:hover { color: var(--ps-primary); }

/* ===== Layout ===== */
.wrap {
  max-width: 1108px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 768px) {
  .wrap { padding: 0 48px; }
}

section {
  padding: 96px 0;
}
@media (min-width: 768px) {
  section { padding: 120px 0; }
}

/* ===== Bilingual Section Header ===== */
.section-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 48px;
}
@media (min-width: 768px) {
  .section-header { flex-direction: row; align-items: baseline; gap: 16px; }
}
.section-header .ko {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 300;
  letter-spacing: -1.2px;
  line-height: 1.2;
  margin: 0;
  color: #FFFFFF;
}
.section-header .en {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Mandatory parcyun footer ===== */
.ps-footer {
  position: fixed;
  bottom: 16px;
  right: 20px;
  font-family: var(--ps-font-en);
  font-weight: 300;
  font-size: 11px;
  color: var(--ps-text-cinematic-secondary);
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 6px 12px;
  border-radius: 100px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.ps-signature {
  font-family: var(--ps-font-signature);
  font-size: 15px;
  color: var(--ps-primary);
  line-height: 1;
}
.ps-ig {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: inherit;
  text-decoration: none;
  margin-left: 4px;
}
.ps-ig:hover { color: var(--ps-primary); }
.ps-ig-icon { width: 10px; height: 10px; vertical-align: middle; }

/* ===== Entry animation ===== */
section, .hero {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 800ms var(--ps-ease-out), transform 800ms var(--ps-ease-out);
}
section.in-view, .hero.in-view {
  opacity: 1;
  transform: none;
}
.hero { opacity: 1; transform: none; } /* hero is always visible */

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  section, .hero { opacity: 1; transform: none; transition: none; }
}

/* ===== Floating nav (top / bottom) ===== */
.float-nav {
  position: fixed;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 80;
}
.float-nav button {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  font-family: var(--ps-font-en);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 240ms var(--ps-ease-out), color 240ms var(--ps-ease-out), transform 240ms var(--ps-ease-out);
}
.float-nav button:hover {
  border-color: var(--ps-primary);
  color: var(--ps-primary);
  transform: translateY(-2px);
}
@media (max-width: 639px) {
  .float-nav { right: 12px; gap: 6px; }
  .float-nav button { width: 36px; height: 36px; font-size: 13px; }
}

/* ===== Footer (ps-footer) · 업무 대시보드 link ===== */
.ps-footer-link {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.3px;
  color: var(--ps-text-cinematic-secondary);
  text-decoration: none;
  padding-right: 10px;
  margin-right: 4px;
  border-right: 1px solid rgba(255, 255, 255, 0.14);
  transition: color 240ms var(--ps-ease-out);
}
.ps-footer-link:hover { color: var(--ps-primary); }
.ps-footer-coffee {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.3px;
  color: var(--ps-primary);
  background: transparent;
  border: 0;
  padding: 0 10px 0 0;
  margin-right: 4px;
  border-right: 1px solid rgba(255, 255, 255, 0.14);
  cursor: pointer;
  transition: color 240ms var(--ps-ease-out);
}
.ps-footer-coffee:hover { color: var(--ps-primary-dark); }

/* ===== 커피 후원 QR 팝업 ===== */
.coffee-modal {
  position: fixed; inset: 0; z-index: 10000;
  display: flex; align-items: center; justify-content: center; padding: 24px;
}
.coffee-modal[hidden] { display: none; }
.coffee-backdrop {
  position: absolute; inset: 0;
  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  animation: coffeeFade 0.2s var(--ps-ease-out);
}
@keyframes coffeeFade { from { opacity: 0; } to { opacity: 1; } }
.coffee-card {
  position: relative; z-index: 1;
  background: var(--ps-surface-cinematic-1);
  border: 1px solid var(--ps-primary);
  border-radius: 18px;
  padding: 32px 32px 26px;
  text-align: center; max-width: 340px; width: 100%;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(255, 177, 26, 0.12);
  animation: coffeePop 0.28s var(--ps-ease-out);
}
@keyframes coffeePop { from { opacity: 0; transform: translateY(16px) scale(0.96); } to { opacity: 1; transform: none; } }
.coffee-close {
  position: absolute; top: 12px; right: 16px;
  background: transparent; border: 0;
  color: var(--ps-text-cinematic-secondary);
  font-size: 24px; line-height: 1; cursor: pointer;
  transition: color 150ms var(--ps-ease-out);
}
.coffee-close:hover { color: var(--ps-primary); }
.coffee-emoji { font-size: 40px; line-height: 1; margin-bottom: 10px; }
.coffee-title { margin: 0 0 6px; font-size: 19px; font-weight: 500; color: #FFFFFF; }
.coffee-sub { margin: 0 0 20px; font-size: 13px; font-weight: 300; color: var(--ps-text-cinematic-secondary); line-height: 1.6; }
.coffee-qr { display: block; width: 220px; height: 220px; margin: 0 auto 14px; border-radius: 12px; background: #fff; padding: 10px; object-fit: contain; }
.coffee-qr-fallback { display: none; margin: 0 auto 14px; padding: 40px 16px; border: 1px dashed var(--ps-surface-cinematic-3); border-radius: 12px; font-family: var(--ps-font-en); font-size: 12px; color: var(--ps-text-cinematic-secondary); }
.coffee-label { font-family: var(--ps-font-signature); font-size: 20px; color: var(--ps-primary); }


  /* ===== Resource Explorer (동적 검색·필터) ===== */
  .rx-controls{display:flex;flex-direction:column;gap:14px;margin-bottom:20px}
  .rx-search{position:relative;display:flex;align-items:center}
  .rx-search-icon{position:absolute;left:16px;font-size:18px;color:var(--ps-text-cinematic-secondary);pointer-events:none}
  .rx-input{width:100%;padding:15px 16px 15px 44px;border-radius:14px;background:var(--ps-surface-cinematic-1);
    border:1px solid var(--ps-surface-cinematic-3);color:#fff;font-family:var(--ps-font-body);font-size:15px;font-weight:300;
    transition:border-color .2s var(--ps-ease-out)}
  .rx-input::placeholder{color:var(--ps-text-cinematic-secondary)}
  .rx-input:focus{outline:none;border-color:var(--ps-primary)}
  .rx-reset{position:absolute;right:10px;padding:7px 13px;border:0;border-radius:100px;cursor:pointer;
    background:var(--ps-surface-cinematic-3);color:#fff;font-size:12px;font-family:var(--ps-font-body);white-space:nowrap;
    transition:all .18s var(--ps-ease-out)}
  .rx-reset:hover{background:var(--ps-primary);color:#000}
  .rx-tabs{display:flex;gap:8px;flex-wrap:wrap}
  .rx-tab{padding:9px 16px;border-radius:100px;cursor:pointer;font-size:13px;font-weight:500;background:transparent;
    border:1px solid var(--ps-surface-cinematic-3);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-body);
    transition:all .18s var(--ps-ease-out)}
  .rx-tab:hover{border-color:var(--ps-primary);color:#fff}
  .rx-tab.on{background:var(--ps-primary);border-color:var(--ps-primary);color:#000;font-weight:700}
  .rx-tags{display:flex;gap:8px;flex-wrap:wrap}
  .rx-chip{padding:6px 12px;border-radius:100px;cursor:pointer;font-size:12px;background:var(--ps-surface-cinematic-1);
    border:1px solid var(--ps-surface-cinematic-3);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-en);
    transition:all .16s var(--ps-ease-out)}
  .rx-chip:hover{border-color:var(--ps-primary);color:#fff}
  .rx-chip.on{background:rgba(255,177,26,.14);border-color:var(--ps-primary);color:var(--ps-primary);font-weight:700}
  .rx-count{font-family:var(--ps-font-en);font-size:12px;letter-spacing:.08em;color:var(--ps-text-cinematic-secondary);
    text-transform:uppercase;margin-bottom:18px}
  .rx-count b{color:var(--ps-primary);font-weight:700;font-size:14px;margin-right:4px}
  .tag-pill.on{background:var(--ps-primary);color:#000;border-color:var(--ps-primary)}
  .rx-empty{text-align:center;padding:56px 20px;border:1px dashed var(--ps-surface-cinematic-3);border-radius:16px}
  .rx-empty-big{font-family:var(--ps-font-en);font-size:20px;font-weight:600;color:#fff;margin:0 0 8px}
  .rx-empty-sub{font-size:13px;color:var(--ps-text-cinematic-secondary);margin:0 0 20px}


/* ===== Hero ===== */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 120px 24px 80px;
  position: relative;
}
@media (min-width: 768px) {
  .hero { padding: 120px 48px 80px; }
}
.hero-inner {
  max-width: 1108px;
  margin: 0 auto;
  width: 100%;
}
.hero-eyebrow {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--ps-primary);
  margin-bottom: 32px;
}
.hero-wordmark {
  font-family: var(--ps-font-signature);
  font-size: clamp(72px, 14vw, 180px);
  font-weight: 400;
  letter-spacing: -2px;
  line-height: 1.15;
  margin: 0 0 24px;
  color: var(--ps-primary);
}
.hero-name {
  font-family: var(--ps-font-en);
  font-size: clamp(13px, 1.3vw, 16px);
  font-weight: 300;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
  margin: 0 0 48px;
}
.hero-tagline {
  font-size: clamp(20px, 2.5vw, 32px);
  font-weight: 300;
  letter-spacing: -0.8px;
  line-height: 1.4;
  max-width: 720px;
  margin: 0 0 48px;
  color: #FFFFFF;
}
.hero-tagline strong {
  font-weight: 500;
  color: var(--ps-primary);
}
.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  font-family: var(--ps-font-en);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.3px;
  border-radius: 100px;
  transition: all 240ms var(--ps-ease-out);
  cursor: pointer;
  border: 1px solid transparent;
}
.btn.primary {
  background: var(--ps-primary);
  color: #000;
}
.btn.primary:hover {
  background: var(--ps-primary-dark);
  transform: translateY(-2px);
}
.btn.ghost {
  background: transparent;
  border-color: var(--ps-surface-cinematic-3);
  color: #FFFFFF;
}
.btn.ghost:hover {
  border-color: var(--ps-primary);
  color: var(--ps-primary);
}
.btn .arrow {
  font-size: 16px;
  line-height: 1;
}

/* ===== About / Manifesto ===== */
.about {
  border-top: 1px solid var(--ps-surface-cinematic-3);
  border-bottom: 1px solid var(--ps-surface-cinematic-3);
}
.manifesto {
  font-size: clamp(22px, 2.5vw, 32px);
  font-weight: 300;
  letter-spacing: -0.6px;
  line-height: 1.5;
  max-width: 840px;
  margin: 0;
  color: #FFFFFF;
}
.manifesto .highlight {
  color: var(--ps-primary);
  font-weight: 500;
}
.identity-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 48px;
}
.tag-pill {
  display: inline-flex;
  align-items: center;
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  color: #FFFFFF;
  background: transparent;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 100px;
  padding: 5px 12px 6px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* ===== Lectures grid ===== */
.lecture-section {
  margin-bottom: 80px;
}
.lecture-section:last-child {
  margin-bottom: 0;
}
.lecture-subsection-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 28px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--ps-surface-cinematic-3);
}
@media (min-width: 640px) {
  .lecture-subsection-header {
    flex-direction: row;
    align-items: baseline;
    gap: 14px;
  }
}
.lecture-subsection-header .ko {
  font-size: clamp(20px, 2vw, 24px);
  font-weight: 400;
  letter-spacing: -0.5px;
  line-height: 1.3;
  margin: 0;
  color: #FFFFFF;
}
.lecture-subsection-header .en {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

.lecture-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
@media (min-width: 768px) {
  .lecture-grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
}
@media (min-width: 1024px) {
  .lecture-grid { grid-template-columns: repeat(3, 1fr); }
}

.lecture-card {
  display: block;
  text-decoration: none;
  color: #FFFFFF;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 16px;
  overflow: hidden;
  transition: border-color 320ms var(--ps-ease-out), transform 320ms var(--ps-ease-out);
}
.lecture-card:hover {
  border-color: var(--ps-primary);
  transform: translateY(-4px);
}
.lecture-card-poster {
  aspect-ratio: 370 / 220;
  background: var(--ps-surface-cinematic-1);
  position: relative;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}
/* Typographic poster (no external image needed) */
.lecture-card-poster::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(at 80% 20%, rgba(255, 177, 26, 0.08) 0%, transparent 50%),
    radial-gradient(at 20% 80%, rgba(255, 177, 26, 0.04) 0%, transparent 50%);
  pointer-events: none;
}
.lecture-card-poster .lid {
  position: relative;
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--ps-primary);
}
.lecture-card-poster .ptitle {
  position: relative;
  font-size: clamp(18px, 1.8vw, 22px);
  font-weight: 300;
  letter-spacing: -0.6px;
  line-height: 1.25;
  color: #FFFFFF;
  margin: 0;
}
.lecture-card-poster .ptitle strong {
  font-weight: 700;
  color: var(--ps-primary);
}
.lecture-card-body {
  padding: 20px 24px 24px;
  background: var(--ps-bg-cinematic);
}
.lecture-card-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 1px;
  color: var(--ps-text-cinematic-secondary);
  margin-bottom: 12px;
}
.lecture-card-meta .dot {
  width: 4px; height: 4px;
  background: var(--ps-text-cinematic-secondary);
  border-radius: 50%;
}
.lecture-card-title {
  font-size: 17px;
  font-weight: 500;
  letter-spacing: -0.4px;
  margin: 0 0 12px;
  color: #FFFFFF;
  line-height: 1.4;
}
.lecture-card-desc {
  font-size: 13px;
  font-weight: 300;
  line-height: 1.6;
  color: var(--ps-text-cinematic-secondary);
  margin: 0 0 16px;
}
.lecture-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

/* Coming soon placeholder card */
.lecture-card.placeholder {
  border-style: dashed;
  border-color: rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 280px;
  text-align: center;
  padding: 32px 24px;
  gap: 12px;
}
.lecture-card.placeholder:hover {
  transform: none;
  border-color: var(--ps-text-cinematic-secondary);
  cursor: default;
}
.lecture-card.placeholder .topic {
  font-size: 16px;
  font-weight: 400;
  letter-spacing: -0.3px;
  color: #FFFFFF;
  margin: 0;
  line-height: 1.4;
  word-break: keep-all;
}
.lecture-card.placeholder .cs-label {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Career / Timeline ===== */
.career-list {
  margin-top: 48px;
  border-top: 1px solid var(--ps-surface-cinematic-3);
  padding-top: 8px;
}
.career-item {
  display: grid;
  grid-template-columns: 72px 1fr auto;
  align-items: baseline;
  gap: 0 24px;
  padding: 18px 0;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.career-item:last-child { border-bottom: none; }
.career-category-header {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
  padding: 28px 0 10px;
  border-bottom: 1px solid var(--ps-surface-cinematic-3);
}
.career-category-header:first-child { padding-top: 8px; }
.career-year {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 1px;
  color: var(--ps-primary);
}
.career-role {
  font-size: 15px;
  font-weight: 400;
  letter-spacing: -0.3px;
  color: #FFFFFF;
}
.career-org {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 300;
  letter-spacing: 0.5px;
  color: var(--ps-text-cinematic-secondary);
  text-align: right;
}
@media (max-width: 639px) {
  .career-item { grid-template-columns: 64px 1fr; grid-template-rows: auto auto; }
  .career-org { grid-column: 2; text-align: left; padding-top: 2px; }
}

/* ===== Connect ===== */
.connect-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
@media (min-width: 640px) {
  .connect-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
  .connect-grid { grid-template-columns: repeat(4, 1fr); }
}
.connect-link {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 32px 28px;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 16px;
  transition: border-color 240ms var(--ps-ease-out), background 240ms var(--ps-ease-out);
}
.connect-link:hover {
  border-color: var(--ps-primary);
  background: var(--ps-surface-cinematic-1);
}
.connect-link .label {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--ps-primary);
}
.connect-link .handle {
  font-family: var(--ps-font-en);
  font-size: 20px;
  font-weight: 500;
  letter-spacing: -0.3px;
  color: #FFFFFF;
}
.connect-link .desc {
  font-size: 13px;
  font-weight: 300;
  color: var(--ps-text-cinematic-secondary);
  margin-top: auto;
}

/* ===== Hero CTAs (multi-row) ===== */
.hero-ctas + .hero-ctas { margin-top: 12px; }

/* ===== Arcade CTA (below activities) ===== */
.arcade-cta {
  margin-top: 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
  padding: 28px 32px;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 16px;
  background:
    repeating-linear-gradient(90deg, transparent 0 6px, rgba(255,177,26,.03) 6px 7px),
    var(--ps-surface-cinematic-1);
  position: relative;
  overflow: hidden;
  transition: border-color 320ms var(--ps-ease-out), transform 320ms var(--ps-ease-out);
}
.arcade-cta::before {
  content: '';
  position: absolute; left: 0; top: 0; height: 3px; width: 100%;
  background: repeating-linear-gradient(90deg, var(--ps-primary) 0 12px, transparent 12px 20px);
  opacity: .5;
}
.arcade-cta:hover { border-color: var(--ps-primary); transform: translateY(-3px); }
.arcade-cta-inner { display: flex; flex-direction: column; gap: 8px; }
.arcade-cta-eyebrow {
  font-family: 'JetBrains Mono', var(--ps-font-en), monospace;
  font-size: 11px; font-weight: 700; letter-spacing: 2px;
  color: var(--ps-primary);
  animation: arcadeBlink 1.6s steps(1) infinite;
}
@keyframes arcadeBlink { 0%,60%{opacity:1} 61%,100%{opacity:.35} }
.arcade-cta-title {
  font-family: 'JetBrains Mono', var(--ps-font-en), monospace;
  font-size: clamp(22px, 3vw, 30px); font-weight: 400; letter-spacing: -0.5px; color: #FFFFFF;
}
.arcade-cta-title strong { color: var(--ps-primary); font-weight: 700; }
.arcade-cta-desc { font-size: 13px; font-weight: 300; color: var(--ps-text-cinematic-secondary); max-width: 520px; }
.arcade-cta-play {
  font-family: 'JetBrains Mono', var(--ps-font-en), monospace;
  font-size: 14px; font-weight: 700; letter-spacing: 1px;
  color: #000; background: var(--ps-primary);
  padding: 14px 24px; border-radius: 100px; white-space: nowrap;
  transition: background 240ms var(--ps-ease-out);
}
.arcade-cta:hover .arcade-cta-play { background: var(--ps-primary-dark); }
@media (prefers-reduced-motion: reduce) {
  .arcade-cta-eyebrow { animation: none; }
}

/* ===== Career section · collapsible ===== */
.career-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: 1px solid var(--ps-surface-cinematic-3);
  color: var(--ps-text-cinematic-secondary);
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  border-radius: 100px;
  padding: 8px 16px;
  cursor: pointer;
  margin-top: 32px;
  transition: border-color 240ms var(--ps-ease-out), color 240ms var(--ps-ease-out);
}
.career-toggle:hover { border-color: var(--ps-primary); color: var(--ps-primary); }
.career-toggle .chev {
  display: inline-block;
  transition: transform 240ms var(--ps-ease-out);
  font-size: 12px;
  line-height: 1;
}
.career-toggle[aria-expanded="true"] .chev { transform: rotate(180deg); }
.career-list.collapsed .career-category-header,
.career-list.collapsed .career-item { display: none; }
.career-list.collapsed { border-top: none; padding-top: 0; margin-top: 0; }

/* ===== List-style compact lecture card (for featured archive link) ===== */
.lecture-card.compact {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 18px 24px;
  border-radius: 12px;
  background: var(--ps-surface-cinematic-1);
}
.lecture-card.compact:hover { transform: none; }
.lecture-card.compact .lc-id {
  flex: 0 0 auto;
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--ps-primary);
  min-width: 92px;
}
.lecture-card.compact .lc-title {
  flex: 1 1 auto;
  font-size: 15px;
  font-weight: 400;
  letter-spacing: -0.3px;
  color: #FFFFFF;
  line-height: 1.4;
}
.lecture-card.compact .lc-title strong { font-weight: 600; color: var(--ps-primary); }
.lecture-card.compact .lc-arrow {
  flex: 0 0 auto;
  font-family: var(--ps-font-en);
  font-size: 14px;
  color: var(--ps-text-cinematic-secondary);
  transition: color 240ms var(--ps-ease-out), transform 240ms var(--ps-ease-out);
}
.lecture-card.compact:hover .lc-arrow { color: var(--ps-primary); transform: translateX(4px); }
@media (max-width: 639px) {
  .lecture-card.compact { gap: 14px; padding: 14px 18px; }
  .lecture-card.compact .lc-id { min-width: 0; }
}

/* ===== Sub-sub-section header (under a subsection) ===== */
.lecture-subsubsection-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin: 8px 0 18px;
}
@media (min-width: 640px) {
  .lecture-subsubsection-header { flex-direction: row; align-items: baseline; gap: 12px; }
}
.lecture-subsubsection-header .ko {
  font-size: 16px;
  font-weight: 500;
  letter-spacing: -0.3px;
  color: #FFFFFF;
  margin: 0;
}
.lecture-subsubsection-header .en {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}



  /* ===== ATLAS GEARS · 캐주얼 톤 ===== */
  .ps-corner{font-family:var(--ps-font-en);font-size:12px;letter-spacing:.04em}
  .atlas-hero{padding:104px 0 26px}
  .atlas-eyebrow{font-family:var(--ps-font-en);font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--ps-primary)}
  .atlas-wordmark{font-family:var(--ps-font-en);font-weight:800;font-size:clamp(52px,13vw,140px);line-height:.86;letter-spacing:-.035em;margin:16px 0 0;text-transform:uppercase}
  .atlas-wordmark .g{color:var(--ps-primary);text-shadow:0 0 46px rgba(255,177,26,.42)}
  .atlas-tagline{margin:22px 0 0;max-width:560px;font-size:15px;line-height:1.75;color:#EDEDED;font-weight:300}
  .atlas-tagline .amber{color:var(--ps-primary);font-weight:500}
  .atlas-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}
  .atlas-pill{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:100px;font-size:14px;font-weight:600;
    font-family:var(--ps-font-body);transition:all .2s var(--ps-ease-out)}
  .atlas-pill.solid{background:var(--ps-primary);color:#000}
  .atlas-pill.solid:hover{background:var(--ps-primary-dark);transform:translateY(-2px)}
  .atlas-pill.ghost{border:1px solid var(--ps-surface-cinematic-3);color:#fff}
  .atlas-pill.ghost:hover{border-color:var(--ps-primary);color:var(--ps-primary)}
  .subject-emoji{margin-right:8px;font-size:.85em}
  #explore{padding-top:8px}
  .atlas-hint{font-size:13px;color:var(--ps-text-cinematic-secondary);margin:-6px 0 18px}

</style>
</head>
<body>

<a href="/" class="ps-corner">← parcyun studio</a>

<!-- ===== HERO ===== -->
<section class="hero atlas-hero">
  <div class="wrap">
    <div class="atlas-eyebrow">Classroom Activity Kit</div>
    <h1 class="atlas-wordmark">ATLAS <span class="g">GEARS</span></h1>
    <p class="atlas-tagline">
      교실에서 바로 꺼내 쓰는 <span class="amber">교육 활동 자료</span> 모음이에요. ⚙️<br>
      위에서 검색해 오늘 수업에 딱 맞는 걸 골라보세요.
    </p>
    <div class="atlas-actions">
      <a href="#explore" class="atlas-pill solid">자료 검색하러 가기 <span>↓</span></a>
      <a href="/" class="atlas-pill ghost">← parcyun studio 메인</a>
    </div>
  </div>
</section>

<!-- ===== EXPLORE (활동 자료 검색 · React 아일랜드) ===== -->
<section id="explore">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">활동 자료 찾기</h2>
      <span class="en">Search</span>
    </header>
    <p class="atlas-hint">키워드나 태그로 검색하면 아래에서 바로 찾아줘요. (예: 맞춤법, 부피, 지도)</p>
    <ResourceExplorer client:load resources={activities} showCategoryTabs={false} placeholder="활동 자료 검색 — 과목·주제·태그 (예: 국어, 부피, 세계지도)" unit="활동" />
  </div>
</section>

<!-- ===== 전체 활동 (과목별) ===== -->
<section id="activities">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">과목별 모아보기</h2>
      <span class="en">By Subject</span>
    </header>

    <!-- ── 국어 ── -->
    <div class="lecture-section">
      <header class="lecture-subsection-header">
        <h3 class="ko"><span class="subject-emoji">📖</span>국어</h3>
        <span class="en">Korean</span>
      </header>
      <div class="lecture-grid">
        {bySubject('국어').map((r) => <ResourceCard r={r} />)}
        <div class="lecture-card placeholder"><p class="topic">국어 활동 자료 추가 예정</p><span class="cs-label">Coming Soon</span></div>
        <div class="lecture-card placeholder"><p class="topic">국어 활동 자료 추가 예정</p><span class="cs-label">Coming Soon</span></div>
      </div>
    </div>

    <!-- ── 수학 ── -->
    <div class="lecture-section">
      <header class="lecture-subsection-header">
        <h3 class="ko"><span class="subject-emoji">📐</span>수학</h3>
        <span class="en">Math</span>
      </header>
      <header class="lecture-subsubsection-header">
        <h4 class="ko">도형과 기하</h4>
        <span class="en">Geometry</span>
      </header>
      <div class="lecture-grid">
        {bySubject('수학 · 도형과 기하').map((r) => <ResourceCard r={r} />)}
        <div class="lecture-card placeholder"><p class="topic">도형과 기하 활동 자료 추가 예정</p><span class="cs-label">Coming Soon</span></div>
        <div class="lecture-card placeholder"><p class="topic">도형과 기하 활동 자료 추가 예정</p><span class="cs-label">Coming Soon</span></div>
      </div>
    </div>

    <!-- ── 사회 ── -->
    <div class="lecture-section">
      <header class="lecture-subsection-header">
        <h3 class="ko"><span class="subject-emoji">🌍</span>사회</h3>
        <span class="en">Social Studies</span>
      </header>
      <div class="lecture-grid">
        {bySubject('사회').map((r) => <ResourceCard r={r} />)}
        <div class="lecture-card placeholder"><p class="topic">사회 활동 자료 추가 예정</p><span class="cs-label">Coming Soon</span></div>
        <div class="lecture-card placeholder"><p class="topic">사회 활동 자료 추가 예정</p><span class="cs-label">Coming Soon</span></div>
      </div>
    </div>

    <!-- ── AI 활용 수업 ── -->
    <div class="lecture-section">
      <header class="lecture-subsection-header">
        <h3 class="ko"><span class="subject-emoji">🤖</span>AI 활용 수업</h3>
        <span class="en">AI in Classroom</span>
      </header>
      <div class="lecture-grid">
        {bySubject('AI 활용 수업').map((r) => <ResourceCard r={r} />)}
      </div>
    </div>
  </div>
</section>

<!-- ===== footer ===== -->
<footer class="ps-footer">
  <a href="/" class="ps-footer-link">← parcyun studio</a>
  Designed by
  <span class="ps-signature">parcyun studio</span>
  <a href="https://www.instagram.com/parcyun" class="ps-ig" target="_blank" rel="noopener">
    <svg class="ps-ig-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4 1 .5.4.8.8 1 1.4.2.4.3 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-1 1.4-.4.5-.8.8-1.4 1-.4.2-1 .3-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-1-.5-.4-.8-.8-1-1.4-.2-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 1-1.4.4-.5.8-.8 1.4-1 .4-.2 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 5.5a4.3 4.3 0 100 8.6 4.3 4.3 0 000-8.6zm5.4-.3a1 1 0 11-2 0 1 1 0 012 0zM12 9.5a2.5 2.5 0 110 5 2.5 2.5 0 010-5z"/></svg>
    @parcyun
  </a>
</footer>

<script is:inline>
(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('section').forEach(function(el){ el.classList.add('in-view'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -15% 0px', threshold: 0.05 });
  document.querySelectorAll('section').forEach(function(el){ io.observe(el); });
})();
</script>

<script is:inline src="/share-widget.js" defer></script>
<script is:inline src="/visitor-counter.js" defer></script>
</body>
</html>
