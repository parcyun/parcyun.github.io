---
import SeoHead from '../../../components/SeoHead.astro';
import PsFooter from '../../../components/PsFooter.astro';
import GameGuideArticle from '../../../components/GameGuideArticle.astro';
import {gameGuides} from '../../../data/gameGuides';
import {dexterityPosts,dexterityAuthor} from '../../../data/dexterity';
export function getStaticPaths(){return gameGuides.map(guide=>({params:{service:guide.id},props:{guide}}));}
const {guide}=Astro.props;
const post=dexterityPosts.find(post=>post.href===`/dexterity/guidebook/${guide.id}/`)!;
const canonical=`https://parcyun.github.io${post.href}`;
const structuredData={'@context':'https://schema.org','@type':'BlogPosting',headline:guide.title,description:guide.description,url:canonical,mainEntityOfPage:canonical,author:dexterityAuthor,datePublished:post.datePublished,dateModified:post.dateModified,articleSection:'가이드북',inLanguage:'ko-KR',image:`https://parcyun.github.io${guide.thumbnail}`,isPartOf:{'@id':'https://parcyun.github.io/dexterity/#blog'}};
---
<!doctype html><html lang="ko" data-theme="dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><SeoHead title={`${guide.name} 가이드북 | parcyun dexterity`} description={guide.description} canonical={canonical} image={`https://parcyun.github.io${guide.thumbnail}`} imageAlt={`${guide.name} 사용 안내`} type="article" siteName="parcyun dexterity" structuredData={structuredData}/><meta name="author" content="parcyun"/><meta name="service-url" content={canonical}/><meta property="article:published_time" content={post.datePublished}/><meta property="article:modified_time" content={post.dateModified}/><meta property="article:section" content="가이드북"/><link rel="icon" href="/favicon.svg"/><link rel="alternate" type="application/rss+xml" title="parcyun dexterity" href="/dexterity/feed.xml"/><link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;500;600&display=swap" rel="stylesheet"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"/><link rel="stylesheet" href="/dexterity.css?v=20261116-1"/><link rel="stylesheet" href="/game-guidebooks.css?v=20261119-1"/></head><body class="game-guide-page"><header class="dexterity-header"><a class="dexterity-logo" href="/dexterity/">parcyun dexterity</a><button class="game-guide-theme" type="button" aria-label="밝은 화면으로 보기" aria-pressed="false">밝은 화면</button></header><main class="game-guide-page-main"><a class="game-guide-back" href="/dexterity/#guidebooks">← 가이드북 목록</a><div id="visitor-stats" class="ps-visits article-visits" aria-live="polite"></div><GameGuideArticle guide={guide}/><nav class="game-guide-related" aria-label="다른 가이드북">{gameGuides.filter(item=>item.id!==guide.id).map(item=><a href={`/dexterity/guidebook/${item.id}/`}>{item.name} 가이드북 ↗</a>)}</nav><section class="article-actions" aria-label="글 반응과 공유">
<div class="article-actions-buttons">
<button type="button" id="article-like" aria-label="좋아요" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></button>
<button type="button" id="article-share" aria-label="공유"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M5 13v7h14v-7"/></svg></button>
</div>
<p id="article-action-status" role="status" aria-live="polite"></p>
</section></main><PsFooter showLinks={false} showFeedback={false} showReview={false}/><script is:inline>document.querySelector('.game-guide-theme').addEventListener('click',function(){const light=document.documentElement.dataset.theme!=='light';document.documentElement.dataset.theme=light?'light':'dark';this.textContent=light?'어두운 화면':'밝은 화면';this.setAttribute('aria-pressed',String(light));this.setAttribute('aria-label',light?'어두운 화면으로 보기':'밝은 화면으로 보기');});</script><script is:inline src="/visitor-counter.js?v=20261116-hierarchy-1" defer></script><script is:inline src="/dexterity-actions.js?v=20261116-3" defer></script></body></html>
