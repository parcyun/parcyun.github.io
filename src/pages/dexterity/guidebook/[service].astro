---
import DexterityControls from "../../../components/DexterityControls.astro";
import SeoHead from '../../../components/SeoHead.astro';
import GameGuideArticle from '../../../components/GameGuideArticle.astro';
import {gameGuides} from '../../../data/gameGuides';
import {dexterityPosts,dexterityAuthor} from '../../../data/dexterity';
export function getStaticPaths(){return gameGuides.map(guide=>({params:{service:guide.id},props:{guide}}));}
const {guide}=Astro.props;
const post=dexterityPosts.find(post=>post.href===`/dexterity/guidebook/${guide.id}/`)!;
const canonical=`https://parcyun.github.io${post.href}`;
const seoTitles={geoweb:'지오웹 사용법: 세계 인구 지도·지리 퀴즈·대항전 가이드', 'spell-drill':'스펠드릴 사용법: 맞춤법·띄어쓰기 연습과 우리 반 대항전', satury:'사투리 검색 사용법: 지역별 방언과 표준국어대사전 가이드'};
const articleData={'@type':'BlogPosting',headline:guide.title,description:guide.description,url:canonical,mainEntityOfPage:canonical,author:dexterityAuthor,datePublished:post.datePublished,dateModified:post.dateModified,articleSection:'가이드북',inLanguage:'ko-KR',image:`https://parcyun.github.io${guide.thumbnail}`,isPartOf:{'@id':'https://parcyun.github.io/dexterity/#blog'},about:{'@type':'WebApplication',name:guide.name,url:`https://parcyun.github.io${guide.path}`}};
const structuredData={'@context':'https://schema.org','@graph':[articleData,{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'parcyun dexterity',item:'https://parcyun.github.io/dexterity/'},{'@type':'ListItem',position:2,name:`${guide.name} 가이드북`,item:canonical}]}]};
---
<!doctype html><html lang="ko" data-theme="dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><SeoHead title={`${seoTitles[guide.id]} | parcyun dexterity`} description={guide.description} canonical={canonical} image={`https://parcyun.github.io${guide.thumbnail}`} imageAlt={`${guide.name} 사용 안내`} type="article" siteName="parcyun dexterity" structuredData={structuredData}/><meta name="author" content="parcyun"/><meta name="service-url" content={canonical}/><meta property="article:published_time" content={post.datePublished}/><meta property="article:modified_time" content={post.dateModified}/><meta property="article:section" content="가이드북"/><link rel="icon" href="/favicon.svg"/><link rel="alternate" type="application/rss+xml" title="parcyun dexterity" href="/dexterity/feed.xml"/><link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;500;600&display=swap" rel="stylesheet"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"/><link rel="stylesheet" href="/dexterity.css?v=20261120-reading-1"/><link rel="stylesheet" href="/game-guidebooks.css?v=20261120-1"/></head><body class="game-guide-page"><header class="dexterity-header"><a class="dexterity-logo" href="/dexterity/">parcyun dexterity</a><button class="game-guide-theme" type="button" aria-label="밝은 화면" aria-pressed="false">밝은 화면</button></header><main class="game-guide-page-main"><a class="game-guide-back" href="/dexterity/#guidebooks">← 가이드북 목록</a><GameGuideArticle guide={guide}/><section class="article-actions" aria-label="글 반응과 공유">
<div class="article-actions-buttons">
<button type="button" id="article-like" aria-label="좋아요" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></button>
<button type="button" id="article-share" aria-label="공유"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M5 13v7h14v-7"/></svg></button>
</div>
<p id="article-action-status" role="status" aria-live="polite"></p>
</section><section class="guide-carousel" aria-label="다른 가이드북"><hr/><header><h2>다른 가이드북</h2><div><button type="button" data-guide-prev aria-label="이전 가이드북">←</button><button type="button" data-guide-next aria-label="다음 가이드북">→</button></div></header><nav class="guide-carousel-track" aria-label="다른 가이드북 목록" tabindex="0">{gameGuides.filter(item=>item.id!==guide.id).map(item=><a href={`/dexterity/guidebook/${item.id}/`}><img src={item.thumbnail} alt={`${item.name} 화면`} loading="lazy" width="640" height="336"/><small>{item.english} · GUIDEBOOK</small><h3>{item.title}</h3><p>{item.description}</p><span>{item.name} 가이드북 보기 ↗</span></a>)}</nav></section><nav class="article-back" aria-label="글 목록으로 돌아가기"><a href="/dexterity/#guidebooks">← 가이드북 목록</a></nav></main><DexterityControls/><script is:inline>document.querySelector('.game-guide-theme').addEventListener('click',function(){const light=document.documentElement.dataset.theme!=='light';document.documentElement.dataset.theme=light?'light':'dark';this.setAttribute('aria-pressed',String(light));});</script><script is:inline src="/dexterity-actions.js?v=20261116-3" defer></script><script is:inline>const track=document.querySelector('.guide-carousel-track');const previous=document.querySelector('[data-guide-prev]'),next=document.querySelector('[data-guide-next]');function update(){previous.disabled=track.scrollLeft<2;next.disabled=track.scrollLeft+track.clientWidth>=track.scrollWidth-2;}for(const [button,direction] of [[previous,-1],[next,1]])button.addEventListener('click',()=>track.scrollBy({left:direction*track.clientWidth*.88,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'}));track.addEventListener('scroll',update,{passive:true});addEventListener('resize',update);update();</script></body></html>
