---
import DexterityControls from "../../components/DexterityControls.astro";
import SeoHead from '../../components/SeoHead.astro';
import { dexterityPosts, dexterityAuthor } from '../../data/dexterity';
const post = dexterityPosts.find(post => post.slug === 'hyangmisa')!;
const url = new URL(post.href, 'https://parcyun.github.io').href;
const image = new URL(post.image, 'https://parcyun.github.io').href;
const structuredData = {
  '@context': 'https://schema.org', '@graph': [{
    '@type': 'BlogPosting', '@id': `${url}#article`, mainEntityOfPage: url, url,
    headline: post.title, description: post.description, image: [image],
    author: dexterityAuthor, publisher: { '@id': 'https://parcyun.github.io/#organization' },
    datePublished: post.datePublished, dateModified: post.dateModified,
    articleSection: post.category, inLanguage: 'ko-KR',
    isPartOf: { '@id': 'https://parcyun.github.io/dexterity/#blog' },
    about: { '@type': 'Place', name: '향미사', address: '경주시 태종로 734' },
  }, {
    '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'parcyun studio', item: 'https://parcyun.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'parcyun dexterity', item: 'https://parcyun.github.io/dexterity/' },
      { '@type': 'ListItem', position: 3, name: post.title, item: url },
    ],
  }],
};
---
<!doctype html>
<html lang="ko" data-theme="dark">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<SeoHead title="경주 카페 향미사 — 경주체육관 간판 아래 | parcyun dexterity"
  description={post.description} canonical={url} image={image} imageAlt={post.imageAlt}
  siteName="parcyun dexterity" type="article" structuredData={structuredData} />
<meta name="author" content="parcyun(박윤)" />
<meta property="article:published_time" content={post.datePublished} />
<meta property="article:modified_time" content={post.dateModified} />
<meta property="article:section" content={post.category} />
<meta property="article:author" content="https://parcyun.github.io/#parcyun" />
<link rel="alternate" type="application/rss+xml" title="parcyun dexterity" href="/dexterity/feed.xml" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style is:global>
/* Adapted from parcyun studio webpage_base.html: reading-focused preview. */
:root{--ps-primary:#FFB11A;--ps-bg:#FAFAF7;--ps-text:#0F1419;--ps-text-secondary:#5A6478;--ps-border:#E5E8ED}
[data-theme=dark]{--ps-bg:#000000;--ps-text:#FFFFFF;--ps-text-secondary:#8C8C8C;--ps-border:#333333}
*{box-sizing:border-box}body{margin:0;background:var(--ps-bg);color:var(--ps-text);font-family:'Montserrat','Pretendard Variable',sans-serif;font-weight:300;word-break:keep-all;overflow-wrap:break-word;-webkit-font-smoothing:antialiased}
a{color:inherit}header{max-width:1120px;margin:auto;padding:25px 24px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--ps-border)}.brand{text-decoration:none;font-size:18px;letter-spacing:-.6px}.brand span{color:var(--ps-primary)}button{font:inherit;border:1px solid var(--ps-border);background:transparent;color:inherit;border-radius:999px;padding:10px 16px;cursor:pointer;min-height:44px}button:focus-visible,a:focus-visible{outline:2px solid var(--ps-primary);outline-offset:4px}
main{padding:64px 24px 120px;max-width:1000px;margin:auto}.heading,.prose,.notes{max-width:640px;margin:auto}.eyebrow{font-size:11px;font-weight:500;letter-spacing:2px;color:var(--ps-text-secondary);margin:0 0 20px}h1{font-size:clamp(32px,5vw,52px);line-height:1.2;font-weight:500;letter-spacing:-2px;margin:0 0 24px}.meta{flex-wrap:wrap;font-size:13px;color:var(--ps-text-secondary);display:flex;gap:16px}.status{margin:24px 0 0;font-size:12px;line-height:1.7;color:var(--ps-text-secondary)}figure{margin:48px auto;max-width:760px}img{display:block;width:100%;height:auto;border-radius:3px}figcaption{font-size:12px;color:var(--ps-text-secondary);margin-top:12px}.prose{font-size:18px;line-height:1.95;letter-spacing:-.25px}.prose p{margin:0 0 30px}.prose .pause{margin:46px 0;font-size:21px}.notes{border-top:1px solid var(--ps-border);margin-top:56px;padding-top:24px;color:var(--ps-text-secondary);font-size:14px;line-height:1.8}.notes h2{font-size:16px;font-weight:500;color:var(--ps-text)}.notes dt{font-weight:500;margin-top:18px}.notes dd{margin:4px 0 0}.ps-footer{position:fixed;right:16px;bottom:12px;background:var(--ps-bg);padding:8px 12px;display:flex;gap:7px;align-items:center;font-size:10px;color:var(--ps-text-secondary);border:1px solid var(--ps-border);border-radius:999px}.ps-signature{font-family:'Covered By Your Grace',cursive;font-size:15px;color:var(--ps-text)}.ps-ig{text-decoration:none;display:flex;gap:3px;align-items:center}
@media(max-width:639px){main{padding-top:40px}.prose{font-size:17px}figure{margin:32px -24px}img{border-radius:0}figcaption{padding:0 24px}h1{letter-spacing:-1.2px}.ps-footer{right:8px;bottom:8px}}@media(min-width:1024px){main{padding-top:88px}}@media(min-width:1280px){main{max-width:1100px}}
</style>
<link rel="stylesheet" href="/dexterity.css?v=20261120-reading-1">
</head>
<body>
<header><a class="brand dexterity-logo" href="/dexterity/">parcyun dexterity</a><button id="theme" type="button" aria-label="밝은 화면" aria-pressed="false">밝은 화면</button></header>
<main><article>
<div class="heading"><p class="eyebrow">GYEONGJU · COFFEE</p><h1>경주체육관 간판 아래,<br>향미사</h1><div class="meta"><a href="/#parcyun" rel="author">글 · parcyun(박윤)</a><time datetime={post.datePublished}>2026.11.15</time><span>사진 9장</span></div></div>
<figure><a href="/images/dexterity/hyangmisa/hyangmisa-exterior.png" aria-label="경주체육관 외관 사진 크게 보기"><img class="photo-square" style="object-position:50% 75%" src="/images/dexterity/hyangmisa/hyangmisa-exterior.png" fetchpriority="high" width="1086" height="1448" alt="밝은 타일 외벽에 경주체육관 간판이 남아 있는 향미사 입구."></a></figure>
<div class="prose">
<p>미팅이 있어 경주에 들렀다. 전날은 하루 종일 비가 쏟아졌고, 다음 날 오전이 되어서야 비가 그쳤다. 미팅에 함께 참석한 동료와 걷다가 향미사에 들렀다.</p>
<p>말끔해진 공기와 찬 바람.<br>가게에서 뿜어져 나오는 커피 향이 일대 거리를 적셨다.</p>
<p>간판은 경주체육관, 지금은 카페 향미사.</p>
</div>
<figure><a href="/images/dexterity/hyangmisa/hyangmisa-roaster.png" aria-label="유리창 너머 커피 장비 사진 크게 보기"><img class="photo-square" style="object-position:50% 45%" src="/images/dexterity/hyangmisa/hyangmisa-roaster.png" width="1086" height="1448" loading="lazy" alt="유리창 너머의 커피 장비와 선반에 거리 풍경이 겹쳐 비친다."></a></figure>
<div class="prose"><p>매대 앞의 바 좌석이 독특했다. 위스키 바에서 보던, 서 있는 사람과 높이를 맞춘 높은 바와는 조금 다르다. 높이가 낮아 편하게 팔을 기대고 대화하기 좋아 보이는 구성이다.</p>
<p>국내 카페, 더구나 실내에서는 처음 보는 좌석 배치였다. 실용적이면서도 독특한 인상을 준다.</p></div>
<figure><a href="/images/dexterity/hyangmisa/hyangmisa-bar-seats.png" aria-label="매대 앞 바 좌석 사진 크게 보기"><img class="photo-square" style="object-position:50% 55%" src="/images/dexterity/hyangmisa/hyangmisa-bar-seats.png" width="1086" height="1448" loading="lazy" alt="매대 바로 앞의 바 좌석과 붉은 조명, 쌓인 접시와 커피 장비."></a></figure>
<figure><a href="/images/dexterity/hyangmisa/hyangmisa-bar.png" aria-label="매대와 바 공간 사진 크게 보기"><img class="photo-square" style="object-position:50% 80%" src="/images/dexterity/hyangmisa/hyangmisa-bar.png" width="1086" height="1448" loading="lazy" alt="나무 매대 위에 드리퍼와 서버, 커피 도구가 놓여 있고 주황색 조명이 달려 있다."></a></figure>
<figure><a href="/images/dexterity/hyangmisa/hyangmisa-counter-wide.png" aria-label="매대와 좌석이 나란히 이어지는 공간. 크게 보기"><img class="photo-square" style="object-position:50% 70%" src="/images/dexterity/hyangmisa/hyangmisa-counter-wide.png" width="1087" height="1447" loading="lazy" alt="긴 나무 매대와 나란히 놓인 바 의자, 커피를 만드는 공간."></a></figure>
<figure><a href="/images/dexterity/hyangmisa/hyangmisa-menu.jpg" aria-label="방문 당시 메뉴판. 사진을 누르면 크게 볼 수 있다. 크게 보기"><img src="/images/dexterity/hyangmisa/hyangmisa-menu.jpg" width="2880" height="3840" loading="lazy" alt="향미사 필터커피·에스프레소 커피·논커피와 티라미수 메뉴판 원본."></a><figcaption>방문 당시 메뉴판. 사진을 누르면 크게 볼 수 있다.</figcaption></figure>
<div class="prose"><p>커피는 따뜻한 아메리카노를 테이크아웃했다. 당시 살펴본 필터커피 원두들이 산미 있는 쪽이라 머신 커피로 주문했다.</p>
<p>직접 로스팅하는 카페에서 기대하는 부드럽고 신선한 맛과 향. 진하거나 강렬한 쪽은 아니지만 거칠지 않고 섬세했다.</p>
<p>아메리카노는 원두에 따라 ‘균형’ 4,800원, ‘단아’ 5,300원. 커피 외에는 로열 밀크티와 말차 라떼, 레몬 에이드가 있고 홈메이드 티라미수는 6,800원이다.</p>
</div>
<figure><a href="/images/dexterity/hyangmisa/hyangmisa-beans-display.png" aria-label="포장된 상품들이 놓인 진열대. 크게 보기"><img class="photo-square" style="object-position:50% 85%" src="/images/dexterity/hyangmisa/hyangmisa-beans-display.png" width="1086" height="1448" loading="lazy" alt="보라색과 청록색 포장지로 감싼 상품이 놓인 흰색 진열대와 식물."></a></figure>
<div class="prose"><p>매장에서는 향미사 원두도 판매하고 있었다.<br>케냐 캄완기 AA TOP 워시드를 구매했다.</p>
<p>케냐 AA는 워낙 유명한 이름이기도 하고, 메뉴에서도 가장 앞에 있어 골라봤다.</p>
</div>
<figure><a href="/images/dexterity/hyangmisa/hyangmisa-beans-list.jpg" aria-label="방문 당시 원두 판매표. 크게 보기"><img src="/images/dexterity/hyangmisa/hyangmisa-beans-list.jpg" width="2880" height="3840" loading="lazy" alt="향미사 원두 판매 목록 원본. 케냐 캄완기 AA TOP 워시드 200g에 18,0 표기."></a><figcaption>방문 당시 원두 판매표.</figcaption></figure>
<div class="prose"><p>200g에 18,000원인 라이트 로스트 원두. 향미사에서 소개하는 향미는 루이보스, 백포도, 오렌지, 라즈베리, 꿀이다.</p>
</div>
<figure><a href="/images/dexterity/hyangmisa/hyangmisa-room.png" aria-label="창가 좌석 사진 크게 보기"><img class="photo-square" style="object-position:50% 65%" src="/images/dexterity/hyangmisa/hyangmisa-room.png" width="1086" height="1448" loading="lazy" alt="큰 창 앞에 놓인 테이블과 의자, 창밖 단풍나무."></a></figure>
<aside class="notes" aria-label="장소 정보"><h2>향미사</h2><p>경주시 태종로 734<br>메뉴·가격: 방문 당시 메뉴판 기준</p><p><a href="https://www.gyeongju.go.kr/tour/page.do?cmd=2&amp;con_uid=374&amp;listType=thumb&amp;mnu_uid=4812&amp;pageNo=5&amp;sortKwd=&amp;srchKwd=" target="_blank" rel="noopener noreferrer">경주시 공식 소개 ↗</a> · <a href="https://www.instagram.com/hyangmisa/" target="_blank" rel="noopener noreferrer">향미사 공식 계정 ↗</a></p><div class="naver-place"><span class="map-label">NAVER MAP</span><div class="place-map-preview"><div id="dexterity-map" role="region" aria-label="향미사 네이버 지도" aria-busy="false"></div><a class="place-map-open" data-naver-place href="https://map.naver.com/p/search/경주%20향미사" aria-label="네이버 지도 앱에서 향미사 열기"></a></div><p id="dexterity-map-status" role="status">위치를 불러오는 중…</p><a data-naver-place href="https://map.naver.com/p/search/경주%20향미사"><strong>향미사</strong><span>경주시 태종로 734</span><span class="map-action">네이버 지도 앱에서 열기 ↗</span></a></div></aside>
</article>
<section class="article-actions" aria-label="글 반응과 공유">
<div class="article-actions-buttons">
<button type="button" id="article-like" aria-label="좋아요" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></button>
<button type="button" id="article-share" aria-label="공유"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M5 13v7h14v-7"/></svg></button>
</div>
<p id="article-action-status" role="status" aria-live="polite"></p>
</section><nav class="article-back" aria-label="글 목록으로 돌아가기"><a href="/dexterity/#category-3">← 카페 기록</a></nav></main>
<DexterityControls/>
<script is:inline>document.getElementById('theme').addEventListener('click',function(){const light=document.documentElement.dataset.theme!=='light';document.documentElement.dataset.theme=light?'light':'dark';this.setAttribute('aria-pressed',String(light));});</script>
<script is:inline src="/dexterity-actions.js?v=20261116-3" defer></script>
<script is:inline src="/dexterity-map.js?v=20261116-1" defer></script>
<script is:inline src="/dexterity-place.js?v=20261116-1" defer></script>
</body></html>
