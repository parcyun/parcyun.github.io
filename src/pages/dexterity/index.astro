---
import DexterityControls from "../../components/DexterityControls.astro";
import SeoHead from '../../components/SeoHead.astro';
import StudioMusicPlayer from '../../components/StudioMusicPlayer.astro';
import { dexterityPosts, dexterityAuthor } from '../../data/dexterity';
const categories = ['가이드북', '일상', '여행', '카페', '생각', '인사이트', 'AI', '디지털', '디자인', '건축'];
const posts = dexterityPosts;
const cardTitles: Record<string,string> = {
  'hyangmisa': '경주 향미사 · 커피와 원두',
  'guidebook/geoweb': '지오웹 · 세계 지도와 지리 퀴즈',
  'guidebook/spell-drill': '스펠 드릴 · 맞춤법 퀴즈',
  'guidebook/satury': '사투리 · 지역별 방언 찾기',
};
const description = 'parcyun(박윤)의 일상·여행·카페 기록, 디자인 관찰과 직접 만든 서비스의 가이드북을 parcyun dexterity에 기록합니다.';
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Blog', '@id': 'https://parcyun.github.io/dexterity/#blog',
  name: 'parcyun dexterity', url: 'https://parcyun.github.io/dexterity/', description,
  inLanguage: 'ko-KR', author: dexterityAuthor,
  blogPost: posts.map(post => ({ '@type': 'BlogPosting', headline: post.title,
    url: new URL(post.href, 'https://parcyun.github.io').href, author: dexterityAuthor,
    datePublished: post.datePublished, dateModified: post.dateModified,
    image: new URL(post.image, 'https://parcyun.github.io').href })),
};
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<SeoHead title="parcyun dexterity | 박윤의 기록과 서비스 가이드북" description={description}
  siteName="parcyun dexterity" image={new URL(posts[0].image, 'https://parcyun.github.io').href}
  imageAlt={posts[0].imageAlt} structuredData={structuredData} />
<link rel="alternate" type="application/rss+xml" title="parcyun dexterity" href="/dexterity/feed.xml" />
<link rel="icon" href="/favicon.svg" />
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/dexterity.css?v=20261120-reading-1" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</head>
<body class="dexterity-home">
<StudioMusicPlayer/>
<header class="dexterity-header"><h1 style="margin:0;font:inherit"><a class="dexterity-logo" href="/dexterity/">parcyun dexterity</a></h1><a class="dexterity-home-link" href="/" aria-label="parcyun studio 메인홈으로 이동" title="parcyun studio 메인홈"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v10H3Z"/><path d="M9 20v-7h6v7"/></svg></a></header>
<main aria-label="parcyun dexterity">
{categories.filter(category => posts.some(post => post.category === category)).map(category => (
<section aria-label={category} id={category==='가이드북'?'guidebooks':`category-${categories.indexOf(category)}`} data-category-section>
<h2>{category}</h2>
<div class="gallery">
{posts.filter(post => post.category === category).map(post => {
const title = cardTitles[post.slug] ?? post.title;
const lastSpace = title.lastIndexOf(' ');
return (
<a href={post.href} class="entry" data-category={category} data-visit-path={post.href}>
<img src={post.image} alt="" width="1086" height="1448" />
<div class="entry-caption"><h3>{lastSpace < 0 ? '' : title.slice(0,lastSpace)} <span class="entry-tail">{title.slice(lastSpace+1)}
<span class="entry-views" role="img" aria-label="누적 조회수 불러오는 중"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><span data-card-view-value>—</span></span>
</span></h3></div>
</a>
);})}
</div>
</section>
))}
</main>
<nav class="category-position" aria-label="카테고리 이동">
{categories.filter(category=>posts.some(post=>post.category===category)).map((category,index)=><a href={category==='가이드북'?'#guidebooks':`#category-${categories.indexOf(category)}`} aria-label={category} aria-current={index===0?'location':undefined}><span>{category}</span><i aria-hidden="true"></i></a>)}
</nav>
<script>
import {sbRpc} from '../../lib/supabase';
const viewCards=Array.from(document.querySelectorAll<HTMLAnchorElement>('.entry[data-visit-path]'));
const visitPaths=[...new Set(viewCards.map(card=>card.dataset.visitPath!))];
function alignViewCounts(){
  viewCards.forEach(card=>{
    const count=card.querySelector<HTMLElement>('.entry-views')!;
    count.style.setProperty('--views-shift','0px');
    const right=card.querySelector('.entry-caption')!.getBoundingClientRect().right;
    count.style.setProperty('--views-shift',`${Math.max(0,right-count.getBoundingClientRect().right)}px`);
  });
}
const countLayout=new ResizeObserver(alignViewCounts);
viewCards.forEach(card=>{countLayout.observe(card.querySelector('.entry-caption')!);countLayout.observe(card.querySelector('.entry-views')!);});
document.fonts.ready.then(alignViewCounts);
alignViewCounts();
sbRpc<Array<{path:string;total:number}>>('list_page_visit_totals',{p_paths:visitPaths}).then(rows=>{
  const totals=new Map((rows||[]).map(row=>[row.path,Number(row.total)||0]));
  viewCards.forEach(card=>{
    const count=totals.get(card.dataset.visitPath!)||0;
    const text=new Intl.NumberFormat('ko-KR').format(count);
    card.querySelector('[data-card-view-value]')!.textContent=text;
    card.querySelector('.entry-views')!.setAttribute('aria-label',`누적 조회수 ${text}회`);
  });
}).catch(()=>{
  viewCards.forEach(card=>card.querySelector('.entry-views')!.setAttribute('aria-label','누적 조회수를 불러오지 못했습니다.'));
});
const sections=Array.from(document.querySelectorAll('[data-category-section]'));
const markers=Array.from(document.querySelectorAll('.category-position a'));
let scheduled=false;
function updateCategory(){
  let current=0;
  sections.forEach((section,index)=>{if(section.getBoundingClientRect().top<=window.innerHeight*.25)current=index;});
  if(window.scrollY>0 && window.innerHeight+window.scrollY>=document.documentElement.scrollHeight-2)current=sections.length-1;
  markers.forEach((marker,index)=>{if(index===current)marker.setAttribute('aria-current','location');else marker.removeAttribute('aria-current');});
  scheduled=false;
}
function schedule(){if(!scheduled){scheduled=true;requestAnimationFrame(updateCategory);}}
window.addEventListener('scroll',schedule,{passive:true});window.addEventListener('resize',schedule);updateCategory();
</script>
<footer class="dexterity-home-footer" aria-label="Dexterity 하단 푸터">
 <div class="dexterity-footer-inner"><a class="dexterity-logo" href="/">parcyun studio</a><nav aria-label="스튜디오 바로가기"><a href="/">메인홈</a><a href="/atlas-gears/">아틀라스 기어즈</a><a href="/academica/">아카데미카</a></nav></div>
 <div class="dexterity-footer-slot" data-dexterity-footer-slot><DexterityControls/></div>
</footer>
</body>
</html>
<style is:global>
html{scrollbar-width:none;scroll-behavior:smooth}html::-webkit-scrollbar,body::-webkit-scrollbar{display:none}
.dexterity-home .dexterity-header{display:flex;align-items:center;justify-content:space-between;gap:16px}
.dexterity-home-link{display:grid;place-items:center;flex:none;width:48px;height:48px;border:1px solid #ffffff40;border-radius:50%;background:#111;color:#fff;transition:color .18s,border-color .18s}
.dexterity-home-link:hover{color:#FFB11A;border-color:#FFB11A}.dexterity-home-link:focus-visible{outline:2px solid #FFB11A;outline-offset:4px}
.dexterity-home .dexterity-home-link{margin-right:260px}
@media(max-width:640px){.dexterity-home .studio-music-player{top:80px}.dexterity-home .dexterity-header{padding-bottom:48px}.dexterity-home .dexterity-home-link{margin-right:0}}
.dexterity-home-footer{border-top:1px solid #ffffff26;margin-top:32px;padding:48px max(var(--dexterity-gutter),env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(var(--dexterity-gutter),env(safe-area-inset-left))}
.dexterity-footer-inner{max-width:1136px;margin:0 auto 40px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:24px}
.dexterity-footer-inner nav{display:flex;flex-wrap:wrap;gap:24px}.dexterity-footer-inner nav a{color:#aaa;font-size:14px;text-decoration:none}.dexterity-footer-inner nav a:hover{color:#FFB11A}
.dexterity-footer-slot{position:relative;min-height:96px}
.category-position{position:fixed;right:12px;top:50%;transform:translateY(-50%);z-index:10;display:flex;flex-direction:column;gap:2px}
.category-position a{display:flex;align-items:center;justify-content:flex-end;position:relative;width:36px;height:32px;text-decoration:none;color:#fff}
.category-position i{width:20px;height:2px;border-radius:2px;background:#969696;transition:background .2s,width .2s}
.category-position a[aria-current] i{background:#fff;width:28px}
.category-position span{position:absolute;right:44px;white-space:nowrap;font-size:13px;background:rgba(0,0,0,.85);border-radius:8px;padding:6px 10px;opacity:0;visibility:hidden;transition:opacity .15s;pointer-events:none}
.category-position a:hover span,.category-position a:focus-visible span{opacity:1;visibility:visible}.category-position a:focus-visible{outline:1px solid #fff;outline-offset:2px;border-radius:4px}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.category-position i,.category-position span{transition:none}}
*{box-sizing:border-box}html,body{margin:0;background:#000;color:#fff}
body{font-family:'Pretendard Variable',sans-serif;word-break:keep-all}
main{max-width:1200px;margin:auto;padding:64px 32px 96px}
section+section{margin-top:64px;border-top:1px solid rgba(255,255,255,.18);padding-top:48px}h2{font-size:22px;font-weight:500;margin:0 0 24px;letter-spacing:-.04em}
.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.entry{position:relative;display:block;aspect-ratio:1;overflow:hidden;color:white;text-decoration:none;background:#141414}
.entry{transition:transform .25s ease,box-shadow .25s ease}.entry img{transition:transform .35s ease;position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.entry::after{content:"";position:absolute;inset:30% 0 0;background:linear-gradient(180deg,transparent 0%,rgba(0,0,0,.3) 40%,rgba(0,0,0,.88) 100%);pointer-events:none;z-index:1}
.entry-caption{position:absolute;left:24px;right:24px;bottom:24px;z-index:2;font-size:28px;line-height:1.25}
h3{display:inline;margin:0;font-size:inherit;font-weight:800;line-height:inherit;letter-spacing:-.04em}
.entry-tail{white-space:nowrap}
.entry-views{display:inline-flex;vertical-align:baseline;margin-left:12px;align-items:center;gap:6px;white-space:nowrap;color:#eee;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums;transform:translateX(var(--views-shift,0px))}.entry-views svg{flex:none}
.entry[data-category="가이드북"]{border-radius:24px;border:1px solid rgba(255,255,255,.18)}.entry[data-category="가이드북"] img{object-fit:cover;object-position:center;background:#000}.entry:focus-visible{outline:3px solid #FFB11A;outline-offset:5px}
@media(hover:hover){.entry:hover{transform:translateY(-6px);box-shadow:0 12px 32px rgba(255,177,26,.14)}.entry:hover img{transform:scale(1.035)}}
@media(prefers-reduced-motion:reduce){.entry,.entry img{transition:none}.entry:hover,.entry:hover img{transform:none}}
@media(max-width:900px){.gallery{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:540px){main{padding:40px 20px 64px}.gallery{grid-template-columns:1fr}h2{font-size:20px;margin-bottom:20px}h3{font-size:28px}}
</style>
