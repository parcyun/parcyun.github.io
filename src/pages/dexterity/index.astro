---
import SeoHead from '../../components/SeoHead.astro';
import { dexterityPosts, dexterityAuthor } from '../../data/dexterity';
const categories = ['가이드북', '일상', '여행', '카페', '생각', '인사이트', 'AI', '디지털', '디자인', '건축'];
const posts = dexterityPosts;
const description = 'parcyun(박윤)의 일상·여행·카페 기록, 디자인 관찰과 직접 만든 서비스의 가이드북을 parcyun dexterity에 기록합니다.';
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Blog', '@id': 'https://parcyun.github.io/dexterity/#blog',
  name: 'parcyun dexterity', url: 'https://parcyun.github.io/dexterity/', description,
  inLanguage: 'ko-KR', author: dexterityAuthor,
  blogPost: posts.map(post => ({ '@type': 'BlogPosting', headline: post.title,
    url: new URL(post.href, 'https://parcyun.github.io').href, author: dexterityAuthor,
    datePublished: post.datePublished, dateModified: post.dateModified,
    image: new URL(post.image, 'https://parcyun.github.io').href })),
};
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<SeoHead title="parcyun dexterity | 박윤의 기록과 서비스 가이드북" description={description}
  siteName="parcyun dexterity" image={new URL(posts[0].image, 'https://parcyun.github.io').href}
  imageAlt={posts[0].imageAlt} structuredData={structuredData} />
<link rel="alternate" type="application/rss+xml" title="parcyun dexterity" href="/dexterity/feed.xml" />
<link rel="icon" href="/favicon.svg" />
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/dexterity.css?v=20261116-1" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</head>
<body>
<header class="dexterity-header"><h1 style="margin:0;font:inherit"><a class="dexterity-logo" href="/dexterity/">parcyun dexterity</a></h1></header>
<main aria-label="parcyun dexterity">
{categories.filter(category => posts.some(post => post.category === category)).map(category => (
<section aria-label={category} id={category==='가이드북'?'guidebooks':`category-${categories.indexOf(category)}`} data-category-section>
<h2>{category}</h2>
<div class="gallery">
{posts.filter(post => post.category === category).map(post => (
<a href={post.href} class="entry" data-category={category}>
<img src={post.image} alt="" width="1086" height="1448" />
<h3>{post.title}</h3>
</a>
))}
</div>
</section>
))}
</main>
<nav class="category-position" aria-label="카테고리 이동">
{categories.filter(category=>posts.some(post=>post.category===category)).map((category,index)=><a href={category==='가이드북'?'#guidebooks':`#category-${categories.indexOf(category)}`} aria-label={category} aria-current={index===0?'location':undefined}><span>{category}</span><i aria-hidden="true"></i></a>)}
</nav>
<script>
const sections=Array.from(document.querySelectorAll('[data-category-section]'));
const markers=Array.from(document.querySelectorAll('.category-position a'));
let scheduled=false;
function updateCategory(){
  let current=0;
  sections.forEach((section,index)=>{if(section.getBoundingClientRect().top<=window.innerHeight*.25)current=index;});
  if(window.scrollY>0 && window.innerHeight+window.scrollY>=document.documentElement.scrollHeight-2)current=sections.length-1;
  markers.forEach((marker,index)=>{if(index===current)marker.setAttribute('aria-current','location');else marker.removeAttribute('aria-current');});
  scheduled=false;
}
function schedule(){if(!scheduled){scheduled=true;requestAnimationFrame(updateCategory);}}
window.addEventListener('scroll',schedule,{passive:true});window.addEventListener('resize',schedule);updateCategory();
</script>
</body>
</html>
<style is:global>
html{scrollbar-width:none;scroll-behavior:smooth}html::-webkit-scrollbar,body::-webkit-scrollbar{display:none}
.category-position{position:fixed;right:12px;top:50%;transform:translateY(-50%);z-index:10;display:flex;flex-direction:column;gap:2px}
.category-position a{display:flex;align-items:center;justify-content:flex-end;position:relative;width:36px;height:32px;text-decoration:none;color:#fff}
.category-position i{width:20px;height:2px;border-radius:2px;background:#969696;transition:background .2s,width .2s}
.category-position a[aria-current] i{background:#fff;width:28px}
.category-position span{position:absolute;right:44px;white-space:nowrap;font-size:13px;background:rgba(0,0,0,.85);border-radius:8px;padding:6px 10px;opacity:0;visibility:hidden;transition:opacity .15s;pointer-events:none}
.category-position a:hover span,.category-position a:focus-visible span{opacity:1;visibility:visible}.category-position a:focus-visible{outline:1px solid #fff;outline-offset:2px;border-radius:4px}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.category-position i,.category-position span{transition:none}}
*{box-sizing:border-box}html,body{margin:0;background:#000;color:#fff}
body{font-family:'Pretendard Variable',sans-serif;word-break:keep-all}
main{max-width:1200px;margin:auto;padding:64px 32px 96px}
section+section{margin-top:64px;border-top:1px solid rgba(255,255,255,.18);padding-top:48px}h2{font-size:22px;font-weight:500;margin:0 0 24px;letter-spacing:-.04em}
.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.entry{position:relative;display:block;aspect-ratio:1;overflow:hidden;color:white;text-decoration:none;background:#141414}
.entry{transition:transform .25s ease,box-shadow .25s ease}.entry img{transition:transform .35s ease;position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.entry::after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.85))}
h3{position:absolute;left:24px;right:24px;bottom:24px;margin:0;z-index:1;font-size:28px;font-weight:800;line-height:1.25;letter-spacing:-.04em}
.entry[data-category="가이드북"]{border-radius:24px}.entry[data-category="가이드북"] img{object-fit:contain;background:#101114}.entry:focus-visible{outline:3px solid #FFB11A;outline-offset:5px}
@media(hover:hover){.entry:hover{transform:translateY(-6px);box-shadow:0 12px 32px rgba(255,177,26,.14)}.entry:hover img{transform:scale(1.035)}}
@media(prefers-reduced-motion:reduce){.entry,.entry img{transition:none}.entry:hover,.entry:hover img{transform:none}}
@media(max-width:900px){.gallery{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:540px){main{padding:40px 20px 64px}.gallery{grid-template-columns:1fr}h2{font-size:20px;margin-bottom:20px}h3{font-size:28px}}
</style>
