---
import FeedbackAdmin from '../components/FeedbackAdmin.tsx';
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex,nofollow" />
<title>기능 개선 요청 검토 · parcyun studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
<style>
  :root{--ps-primary:#FFB11A;--ps-bg-cinematic:#000;--ps-surface-cinematic-1:#141414;--ps-surface-cinematic-3:#333;--ps-text-cinematic-secondary:#8C8C8C;--ps-font-body:'Pretendard Variable','Pretendard','Montserrat',-apple-system,sans-serif;--ps-font-en:'Montserrat','Pretendard Variable',sans-serif;--ps-font-signature:'Covered By Your Grace',cursive}
  *{box-sizing:border-box}html,body{margin:0;padding:0}body{min-height:100vh;background:#000;color:#fff;font-family:var(--ps-font-body);font-weight:300;padding:72px 24px 40px;word-break:keep-all;-webkit-font-smoothing:antialiased}.fa-wrap{width:min(100%,720px);margin:0 auto}.fa-sig{font-family:var(--ps-font-signature);font-size:34px;color:var(--ps-primary);line-height:1;margin-bottom:6px}.fa-eyebrow{font-family:var(--ps-font-en);font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--ps-text-cinematic-secondary);margin:0 0 28px}a.fa-back{position:fixed;top:16px;left:18px;font-family:var(--ps-font-en);font-size:12px;color:var(--ps-text-cinematic-secondary);text-decoration:none}a.fa-back:hover{color:var(--ps-primary)}
</style>
</head>
<body>
  <a class="fa-back" href="/admin/">← 관리자</a>
  <main class="fa-wrap">
    <div class="fa-sig">parcyun studio</div>
    <p class="fa-eyebrow">Feature requests</p>
    <FeedbackAdmin client:load />
  </main>
</body>
</html>
