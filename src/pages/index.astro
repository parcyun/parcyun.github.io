---
import CinematicLayout from '../layouts/CinematicLayout.astro';
import { icon } from '../lib/icons';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '박창현',
  alternateName: 'parcyun',
  url: 'https://parcyun.github.io/',
  jobTitle: '초등교사 · 프롬프트 엔지니어 · 디자이너',
  sameAs: [
    'https://www.instagram.com/parcyun',
    'https://github.com/parcyun',
    'https://linktr.ee/parcyun',
  ],
  knowsAbout: ['교육', '생성형 AI', '프롬프트 엔지니어링', 'UIUX·WEB 디자인', '디지털 미디어 교육'],
};
---
<CinematicLayout
  title="parcyun studio · 강의 자료 허브"
  description="초등교사 parcyun이 운영하는 교육·AI·디자인 강의 자료 허브. Designed by parcyun studio."
  ogTitle="parcyun studio"
  ogDescription="초등교사 · 프롬프트 엔지니어 · 디자이너. 교육과 AI를 잇는 강의 자료 허브."
  ogUrl="https://parcyun.github.io/"
>
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">Teacher. Product Builder. Education Studio.</div>
    <h1 data-ps-edit-id="ps-home-001" data-ps-design-id="ps-home-001" class="hero-wordmark">parcyun studio</h1>
    <p data-ps-edit-id="ps-home-002" data-ps-design-id="ps-home-002" class="hero-name">parcyun · 박창현</p>
    <p data-ps-edit-id="ps-home-003" data-ps-design-id="ps-home-003" class="hero-tagline">교육 현장을 가장 잘 이해하는 사람이,<br><strong>좋은 교육 서비스를 만듭니다.</strong></p>
    <div class="hero-ctas">
      <a data-ps-edit-id="ps-home-004" data-ps-design-id="ps-home-004" href="/academica/" class="btn primary">강의 자료 <span data-ps-edit-id="ps-home-005" data-ps-design-id="ps-home-005" class="arrow">↗</span></a>
      <a data-ps-edit-id="ps-home-006" data-ps-design-id="ps-home-006" href="/atlas-gears/" class="btn primary">교육 활동 자료 <span data-ps-edit-id="ps-home-007" data-ps-design-id="ps-home-007" class="arrow">↗</span></a>
    </div>
    <div class="hero-ctas">
      <a data-ps-edit-id="ps-home-008" data-ps-design-id="ps-home-008" href="./works/" class="btn ghost">parcyun studio works <span data-ps-edit-id="ps-home-009" data-ps-design-id="ps-home-009" class="arrow">↗</span></a>
      <a data-ps-edit-id="ps-home-010" data-ps-design-id="ps-home-010" href="https://www.instagram.com/parcyun" class="btn ghost" target="_blank" rel="noopener">@parcyun <span data-ps-edit-id="ps-home-011" data-ps-design-id="ps-home-011" class="arrow">↗</span></a>
    </div>
  </div>
</section>

<!-- ===== ABOUT / MANIFESTO ===== -->
<section class="about">
  <div class="wrap">
    <header class="section-header">
      <h2 data-ps-edit-id="ps-home-012" data-ps-design-id="ps-home-012" class="ko">parcyun studio는</h2>
      <span data-ps-edit-id="ps-home-013" data-ps-design-id="ps-home-013" class="en">About</span>
    </header>
    <p data-ps-edit-id="ps-home-014" data-ps-design-id="ps-home-014" class="manifesto">초등학교 교사이자 교육용 <span data-ps-edit-id="ps-home-015" data-ps-design-id="ps-home-015" class="highlight">프로덕트 개발자</span>입니다.<br><span data-ps-edit-id="ps-home-016" data-ps-design-id="ps-home-016" class="highlight">교육 현장에 도움</span>을 줄 수 있는 지점을 찾고, <span data-ps-edit-id="ps-home-017" data-ps-design-id="ps-home-017" class="highlight">해결</span>하는 과정을 씁니다.</p>
    <div class="identity-tags">
      <span data-ps-edit-id="ps-home-018" data-ps-design-id="ps-home-018" class="tag-pill">초등 교사</span>
      <span data-ps-edit-id="ps-home-019" data-ps-design-id="ps-home-019" class="tag-pill">Prompt Engineer</span>
      <span data-ps-edit-id="ps-home-020" data-ps-design-id="ps-home-020" class="tag-pill">Google Educator L2</span>
      <span data-ps-edit-id="ps-home-021" data-ps-design-id="ps-home-021" class="tag-pill">디지털 미디어 교육</span>
      <span data-ps-edit-id="ps-home-022" data-ps-design-id="ps-home-022" class="tag-pill">AI R&amp;D</span>
      <span data-ps-edit-id="ps-home-023" data-ps-design-id="ps-home-023" class="tag-pill">UIUX · WEB 디자인</span>
      <span data-ps-edit-id="ps-home-024" data-ps-design-id="ps-home-024" class="tag-pill">도시공학</span>
    </div>
    <button data-ps-edit-id="ps-home-025" data-ps-design-id="ps-home-025" class="career-toggle" type="button" aria-expanded="false" aria-controls="career-list" onclick="toggleCareer(this)">
      <span data-ps-edit-id="ps-home-026" data-ps-design-id="ps-home-026" class="label">경력 전체 보기</span>
      <span data-ps-edit-id="ps-home-027" data-ps-design-id="ps-home-027" class="chev">⌄</span>
    </button>
    <div class="career-list collapsed" id="career-list" data-career-managed data-noedit>

      <div class="career-category-header">주요 경력</div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-028" data-ps-design-id="ps-home-028" class="career-year">현재</span>
        <span data-ps-edit-id="ps-home-029" data-ps-design-id="ps-home-029" class="career-role">몽당분필 대외협력부장 · AI R&amp;D 팀 리더</span>
        <span data-ps-edit-id="ps-home-030" data-ps-design-id="ps-home-030" class="career-org">(사)디미교연</span>
      </div>

      <div class="career-category-header">강의 · 연수</div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-031" data-ps-design-id="ps-home-031" class="career-year">현재</span>
        <span data-ps-edit-id="ps-home-032" data-ps-design-id="ps-home-032" class="career-role">찾아가는 학교 컨설팅 주강사</span>
        <span data-ps-edit-id="ps-home-033" data-ps-design-id="ps-home-033" class="career-org"></span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-034" data-ps-design-id="ps-home-034" class="career-year">—</span>
        <span data-ps-edit-id="ps-home-035" data-ps-design-id="ps-home-035" class="career-role">관리자 연수 우수 사례 발표 (찾아가는 학교 컨설팅)</span>
        <span data-ps-edit-id="ps-home-036" data-ps-design-id="ps-home-036" class="career-org"></span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-037" data-ps-design-id="ps-home-037" class="career-year">—</span>
        <span data-ps-edit-id="ps-home-038" data-ps-design-id="ps-home-038" class="career-role">AI · 에듀테크 직무 연수 강사</span>
        <span data-ps-edit-id="ps-home-039" data-ps-design-id="ps-home-039" class="career-org"></span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-040" data-ps-design-id="ps-home-040" class="career-year">—</span>
        <span data-ps-edit-id="ps-home-041" data-ps-design-id="ps-home-041" class="career-role">(사)디미교연 AI · 에듀테크 내부 역량 강화 연수 강사</span>
        <span data-ps-edit-id="ps-home-042" data-ps-design-id="ps-home-042" class="career-org"></span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-043" data-ps-design-id="ps-home-043" class="career-year">—</span>
        <span data-ps-edit-id="ps-home-044" data-ps-design-id="ps-home-044" class="career-role">특성화고등학교 시각디자인과 생성형 AI 활용 특강</span>
        <span data-ps-edit-id="ps-home-045" data-ps-design-id="ps-home-045" class="career-org"></span>
      </div>

      <div class="career-category-header">제작 · 콘텐츠</div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-046" data-ps-design-id="ps-home-046" class="career-year">—</span>
        <span data-ps-edit-id="ps-home-047" data-ps-design-id="ps-home-047" class="career-role">티처빌 온라인 직무연수 제작 (이미지 · 영상 생성 AI)</span>
        <span data-ps-edit-id="ps-home-048" data-ps-design-id="ps-home-048" class="career-org">티처빌</span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-049" data-ps-design-id="ps-home-049" class="career-year">—</span>
        <span data-ps-edit-id="ps-home-050" data-ps-design-id="ps-home-050" class="career-role">경기도교육청 미디어 리터러시 교육 영상 제작</span>
        <span data-ps-edit-id="ps-home-051" data-ps-design-id="ps-home-051" class="career-org">경기도교육청</span>
      </div>

      <div class="career-category-header">위원 · 연구</div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-052" data-ps-design-id="ps-home-052" class="career-year">2026</span>
        <span data-ps-edit-id="ps-home-053" data-ps-design-id="ps-home-053" class="career-role">경기도교육청 AI 교육연구회 회장</span>
        <span data-ps-edit-id="ps-home-054" data-ps-design-id="ps-home-054" class="career-org">경기도교육청</span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-055" data-ps-design-id="ps-home-055" class="career-year">2025</span>
        <span data-ps-edit-id="ps-home-056" data-ps-design-id="ps-home-056" class="career-role">화성오산교육지원청 디지털토핑교육연구위원</span>
        <span data-ps-edit-id="ps-home-057" data-ps-design-id="ps-home-057" class="career-org">화성오산교육지원청</span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-058" data-ps-design-id="ps-home-058" class="career-year">2025</span>
        <span data-ps-edit-id="ps-home-059" data-ps-design-id="ps-home-059" class="career-role">경기도교육청 디지털시민역량교육연구위원</span>
        <span data-ps-edit-id="ps-home-060" data-ps-design-id="ps-home-060" class="career-org">경기도교육청</span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-061" data-ps-design-id="ps-home-061" class="career-year">2023—</span>
        <span data-ps-edit-id="ps-home-062" data-ps-design-id="ps-home-062" class="career-role">교실혁명 선도교사</span>
        <span data-ps-edit-id="ps-home-063" data-ps-design-id="ps-home-063" class="career-org">교육부</span>
      </div>

      <div class="career-category-header">학력 · 자격</div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-064" data-ps-design-id="ps-home-064" class="career-year">2023</span>
        <span data-ps-edit-id="ps-home-065" data-ps-design-id="ps-home-065" class="career-role">프롬프트 엔지니어 자격</span>
        <span data-ps-edit-id="ps-home-066" data-ps-design-id="ps-home-066" class="career-org">뤼튼</span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-067" data-ps-design-id="ps-home-067" class="career-year">2022</span>
        <span data-ps-edit-id="ps-home-068" data-ps-design-id="ps-home-068" class="career-role">Google Certified Educator Level 2</span>
        <span data-ps-edit-id="ps-home-069" data-ps-design-id="ps-home-069" class="career-org">Google</span>
      </div>
      <div class="career-item">
        <span data-ps-edit-id="ps-home-070" data-ps-design-id="ps-home-070" class="career-year">2017</span>
        <span data-ps-edit-id="ps-home-071" data-ps-design-id="ps-home-071" class="career-role">광주교육대학교 졸업</span>
        <span data-ps-edit-id="ps-home-072" data-ps-design-id="ps-home-072" class="career-org">광주교육대학교</span>
      </div>

    </div>
  </div>
</section>

<!-- ===== COLLECTIONS (자료실) ===== -->
<section id="collections">
  <div class="wrap">
    <header class="section-header">
      <h2 data-ps-edit-id="ps-home-073" data-ps-design-id="ps-home-073" class="ko">자료실</h2>
      <span data-ps-edit-id="ps-home-074" data-ps-design-id="ps-home-074" class="en">Collections</span>
    </header>
    <div class="collections-grid">
      <a data-ps-edit-id="ps-home-075" data-ps-design-id="ps-home-075" href="/academica/" class="collection-card">
        <span data-ps-edit-id="ps-home-076" data-ps-design-id="ps-home-076" class="cc-brand">ACADEMICA</span>
        <span data-ps-edit-id="ps-home-077" data-ps-design-id="ps-home-077" class="cc-ko">강의 자료</span>
        <span data-ps-edit-id="ps-home-078" data-ps-design-id="ps-home-078" class="cc-desc">교육 · AI · 디자인 강의 자료를 카테고리별로 모아뒀어요.</span>
        <span data-ps-edit-id="ps-home-079" data-ps-design-id="ps-home-079" class="cc-go">서가 열기 <span data-ps-edit-id="ps-home-080" data-ps-design-id="ps-home-080" class="ico" set:html={icon('arrowRight', 15)}></span></span>
      </a>
      <a data-ps-edit-id="ps-home-081" data-ps-design-id="ps-home-081" href="/atlas-gears/" class="collection-card">
        <span data-ps-edit-id="ps-home-082" data-ps-design-id="ps-home-082" class="cc-brand">ATLAS GEARS</span>
        <span data-ps-edit-id="ps-home-083" data-ps-design-id="ps-home-083" class="cc-ko">교육 활동 자료</span>
        <span data-ps-edit-id="ps-home-084" data-ps-design-id="ps-home-084" class="cc-desc">게임 · 활동지 · 커리큘럼 · 인터랙티브를 검색해서 바로.</span>
        <span data-ps-edit-id="ps-home-085" data-ps-design-id="ps-home-085" class="cc-go">자료 찾기 <span data-ps-edit-id="ps-home-086" data-ps-design-id="ps-home-086" class="ico" set:html={icon('arrowRight', 15)}></span></span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  .collections-grid{display:grid;grid-template-columns:1fr;gap:18px;margin-top:6px}
  @media(min-width:768px){.collections-grid{grid-template-columns:1fr 1fr}}
  .collection-card{position:relative;display:flex;flex-direction:column;gap:2px;padding:30px 28px;border-radius:10px;
    background:var(--ps-surface-cinematic-1);border:1px solid var(--ps-surface-cinematic-3);
    transition:transform .2s var(--ps-ease-out),border-color .2s var(--ps-ease-out)}
  .collection-card:hover{transform:translateY(-3px);border-color:var(--ps-primary)}
  .cc-brand{font-family:var(--ps-font-en);font-weight:800;font-size:26px;letter-spacing:-.01em;color:#fff}
  .collection-card:hover .cc-brand{color:var(--ps-primary)}
  .ico{display:inline-flex;align-items:center;justify-content:center;line-height:0}
  .ico svg{display:block}
  .cc-ko{font-size:14px;font-weight:600;color:var(--ps-primary);margin-top:2px}
  .cc-desc{font-size:13.5px;line-height:1.65;color:var(--ps-text-cinematic-secondary);margin-top:8px}
  .cc-go{margin-top:16px;font-family:var(--ps-font-en);font-size:13px;font-weight:600;letter-spacing:.02em;color:#fff;display:inline-flex;align-items:center;gap:6px}
  .collection-card:hover .cc-go{color:var(--ps-primary)}
</style>

<style is:global>
/* ===== Hero ===== */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 120px 24px 80px;
  position: relative;
}
@media (min-width: 768px) {
  .hero { padding: 120px 48px 80px; }
}
.hero-inner {
  max-width: 1108px;
  margin: 0 auto;
  width: 100%;
}
.hero-eyebrow {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--ps-primary);
  margin-bottom: 32px;
}
.hero-wordmark {
  font-family: var(--ps-font-signature);
  font-size: clamp(72px, 14vw, 180px);
  font-weight: 400;
  letter-spacing: -2px;
  line-height: 1.15;
  margin: 0 0 24px;
  color: var(--ps-primary);
}
.hero-name {
  font-family: var(--ps-font-en);
  font-size: clamp(13px, 1.3vw, 16px);
  font-weight: 300;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
  margin: 0 0 48px;
}
.hero-tagline {
  font-size: clamp(20px, 2.5vw, 32px);
  font-weight: 300;
  letter-spacing: -0.8px;
  line-height: 1.4;
  max-width: 720px;
  margin: 0 0 48px;
  color: #FFFFFF;
}
.hero-tagline strong {
  font-weight: 700;
  color: var(--ps-primary);
}
.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  font-family: var(--ps-font-en);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.3px;
  border-radius: 100px;
  transition: all 240ms var(--ps-ease-out);
  cursor: pointer;
  border: 1px solid transparent;
}
.btn.primary {
  background: var(--ps-primary);
  color: #000;
}
.btn.primary:hover {
  background: var(--ps-primary-dark);
  transform: translateY(-2px);
}
.btn.ghost {
  background: transparent;
  border-color: var(--ps-surface-cinematic-3);
  color: #FFFFFF;
}
.btn.ghost:hover {
  border-color: var(--ps-primary);
  color: var(--ps-primary);
}
.btn .arrow {
  font-size: 16px;
  line-height: 1;
}

/* ===== About / Manifesto ===== */
.about {
  border-top: 1px solid var(--ps-surface-cinematic-3);
  border-bottom: 1px solid var(--ps-surface-cinematic-3);
}
.manifesto {
  font-size: clamp(22px, 2.5vw, 32px);
  font-weight: 300;
  letter-spacing: -0.6px;
  line-height: 1.5;
  max-width: 840px;
  margin: 0;
  color: #FFFFFF;
}
.manifesto .highlight {
  color: var(--ps-primary);
  font-weight: 700;
}
.identity-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 48px;
}
.tag-pill {
  display: inline-flex;
  align-items: center;
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  color: #FFFFFF;
  background: transparent;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 100px;
  padding: 5px 12px 6px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* ===== Career / Timeline ===== */
.career-list {
  margin-top: 48px;
  border-top: 1px solid var(--ps-surface-cinematic-3);
  padding-top: 8px;
}
.career-item {
  display: grid;
  grid-template-columns: 72px 1fr auto;
  align-items: baseline;
  gap: 0 24px;
  padding: 18px 0;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.career-item:last-child { border-bottom: none; }
.career-category-header {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
  padding: 28px 0 10px;
  border-bottom: 1px solid var(--ps-surface-cinematic-3);
}
.career-category-header:first-child { padding-top: 8px; }
.career-year {
