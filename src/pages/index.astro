---
import CinematicLayout from '../layouts/CinematicLayout.astro';
import ResourceExplorer from '../components/ResourceExplorer.tsx';
import { resources } from '../data/resources';
---
<CinematicLayout
  title="parcyun studio · 강의 자료 허브"
  description="초등교사 parcyun이 운영하는 교육·AI·디자인 강의 자료 허브. Designed by parcyun studio."
  ogTitle="parcyun studio"
  ogDescription="초등교사 · 프롬프트 엔지니어 · 디자이너. 교육과 AI를 잇는 강의 자료 허브."
  ogUrl="https://parcyun.github.io/"
>
<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">Educator · Prompt Engineer · Designer</div>
    <h1 class="hero-wordmark">parcyun studio</h1>
    <p class="hero-name">parcyun · 박창현</p>
    <p class="hero-tagline">
      교육과 <strong>AI</strong>를 잇습니다.<br>
    </p>
    <div class="hero-ctas">
      <a href="#lectures" class="btn primary">강의 둘러보기 <span class="arrow">↓</span></a>
      <a href="#activities" class="btn primary">수업 자료 둘러보기 <span class="arrow">↓</span></a>
    </div>
    <div class="hero-ctas">
      <a href="./works/" class="btn ghost">parcyun studio works <span class="arrow">↗</span></a>
      <a href="https://www.instagram.com/parcyun" class="btn ghost" target="_blank" rel="noopener">@parcyun <span class="arrow">↗</span></a>
    </div>
  </div>
</section>

<!-- ===== ABOUT / MANIFESTO ===== -->
<section class="about">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">parcyun studio는</h2>
      <span class="en">About</span>
    </header>
    <p class="manifesto">
      디자인 · 건축 · AI를 일상 교실에 활용하고,<br>
      그 과정을 <span class="highlight">강의 자료</span>와 <span class="highlight">레퍼런스</span>로 정리해 공유합니다.
    </p>
    <div class="identity-tags">
      <span class="tag-pill">초등 교사</span>
      <span class="tag-pill">Prompt Engineer</span>
      <span class="tag-pill">Google Educator L2</span>
      <span class="tag-pill">디지털 미디어 교육</span>
      <span class="tag-pill">AI R&amp;D</span>
      <span class="tag-pill">UIUX · WEB 디자인</span>
      <span class="tag-pill">도시공학</span>
    </div>
    <button class="career-toggle" type="button" aria-expanded="false" aria-controls="career-list" onclick="toggleCareer(this)">
      <span class="label">경력 전체 보기</span>
      <span class="chev">⌄</span>
    </button>
    <div class="career-list collapsed" id="career-list">

      <div class="career-category-header">주요 경력</div>
      <div class="career-item">
        <span class="career-year">현재</span>
        <span class="career-role">몽당분필 대외협력부장 · AI R&amp;D 팀 리더</span>
        <span class="career-org">(사)디미교연</span>
      </div>

      <div class="career-category-header">강의 · 연수</div>
      <div class="career-item">
        <span class="career-year">현재</span>
        <span class="career-role">찾아가는 학교 컨설팅 주강사</span>
        <span class="career-org"></span>
      </div>
      <div class="career-item">
        <span class="career-year">—</span>
        <span class="career-role">관리자 연수 우수 사례 발표 (찾아가는 학교 컨설팅)</span>
        <span class="career-org"></span>
      </div>
      <div class="career-item">
        <span class="career-year">—</span>
        <span class="career-role">AI · 에듀테크 직무 연수 강사</span>
        <span class="career-org"></span>
      </div>
      <div class="career-item">
        <span class="career-year">—</span>
        <span class="career-role">(사)디미교연 AI · 에듀테크 내부 역량 강화 연수 강사</span>
        <span class="career-org"></span>
      </div>
      <div class="career-item">
        <span class="career-year">—</span>
        <span class="career-role">특성화고등학교 시각디자인과 생성형 AI 활용 특강</span>
        <span class="career-org"></span>
      </div>

      <div class="career-category-header">제작 · 콘텐츠</div>
      <div class="career-item">
        <span class="career-year">—</span>
        <span class="career-role">티처빌 온라인 직무연수 제작 (이미지 · 영상 생성 AI)</span>
        <span class="career-org">티처빌</span>
      </div>
      <div class="career-item">
        <span class="career-year">—</span>
        <span class="career-role">경기도교육청 미디어 리터러시 교육 영상 제작</span>
        <span class="career-org">경기도교육청</span>
      </div>

      <div class="career-category-header">위원 · 연구</div>
      <div class="career-item">
        <span class="career-year">2026</span>
        <span class="career-role">경기도교육청 AI 교육연구회 회장</span>
        <span class="career-org">경기도교육청</span>
      </div>
      <div class="career-item">
        <span class="career-year">2025</span>
        <span class="career-role">화성오산교육지원청 디지털토핑교육연구위원</span>
        <span class="career-org">화성오산교육지원청</span>
      </div>
      <div class="career-item">
        <span class="career-year">2025</span>
        <span class="career-role">경기도교육청 디지털시민역량교육연구위원</span>
        <span class="career-org">경기도교육청</span>
      </div>
      <div class="career-item">
        <span class="career-year">2023—</span>
        <span class="career-role">교실혁명 선도교사</span>
        <span class="career-org">교육부</span>
      </div>

      <div class="career-category-header">학력 · 자격</div>
      <div class="career-item">
        <span class="career-year">2023</span>
        <span class="career-role">프롬프트 엔지니어 자격</span>
        <span class="career-org">뤼튼</span>
      </div>
      <div class="career-item">
        <span class="career-year">2022</span>
        <span class="career-role">Google Certified Educator Level 2</span>
        <span class="career-org">Google</span>
      </div>
      <div class="career-item">
        <span class="career-year">2017</span>
        <span class="career-role">광주교육대학교 졸업</span>
        <span class="career-org">광주교육대학교</span>
      </div>

    </div>
  </div>
</section>

<!-- ===== EXPLORE (동적 검색·필터 · React 아일랜드) ===== -->
<section id="explore">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">자료 찾기</h2>
      <span class="en">Explore</span>
    </header>
    <ResourceExplorer client:load resources={resources} />
  </div>
</section>

<style is:global>
  /* ===== Resource Explorer (동적 검색·필터) ===== */
  .rx-controls{display:flex;flex-direction:column;gap:14px;margin-bottom:20px}
  .rx-search{position:relative;display:flex;align-items:center}
  .rx-search-icon{position:absolute;left:16px;font-size:18px;color:var(--ps-text-cinematic-secondary);pointer-events:none}
  .rx-input{width:100%;padding:15px 16px 15px 44px;border-radius:14px;background:var(--ps-surface-cinematic-1);
    border:1px solid var(--ps-surface-cinematic-3);color:#fff;font-family:var(--ps-font-body);font-size:15px;font-weight:300;
    transition:border-color .2s var(--ps-ease-out)}
  .rx-input::placeholder{color:var(--ps-text-cinematic-secondary)}
  .rx-input:focus{outline:none;border-color:var(--ps-primary)}
  .rx-reset{position:absolute;right:10px;padding:7px 13px;border:0;border-radius:100px;cursor:pointer;
    background:var(--ps-surface-cinematic-3);color:#fff;font-size:12px;font-family:var(--ps-font-body);white-space:nowrap;
    transition:all .18s var(--ps-ease-out)}
  .rx-reset:hover{background:var(--ps-primary);color:#000}
  .rx-tabs{display:flex;gap:8px;flex-wrap:wrap}
  .rx-tab{padding:9px 16px;border-radius:100px;cursor:pointer;font-size:13px;font-weight:500;background:transparent;
    border:1px solid var(--ps-surface-cinematic-3);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-body);
    transition:all .18s var(--ps-ease-out)}
  .rx-tab:hover{border-color:var(--ps-primary);color:#fff}
  .rx-tab.on{background:var(--ps-primary);border-color:var(--ps-primary);color:#000;font-weight:700}
  .rx-tags{display:flex;gap:8px;flex-wrap:wrap}
  .rx-chip{padding:6px 12px;border-radius:100px;cursor:pointer;font-size:12px;background:var(--ps-surface-cinematic-1);
    border:1px solid var(--ps-surface-cinematic-3);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-en);
    transition:all .16s var(--ps-ease-out)}
  .rx-chip:hover{border-color:var(--ps-primary);color:#fff}
  .rx-chip.on{background:rgba(255,177,26,.14);border-color:var(--ps-primary);color:var(--ps-primary);font-weight:700}
  .rx-count{font-family:var(--ps-font-en);font-size:12px;letter-spacing:.08em;color:var(--ps-text-cinematic-secondary);
    text-transform:uppercase;margin-bottom:18px}
  .rx-count b{color:var(--ps-primary);font-weight:700;font-size:14px;margin-right:4px}
  .tag-pill.on{background:var(--ps-primary);color:#000;border-color:var(--ps-primary)}
  .rx-empty{text-align:center;padding:56px 20px;border:1px dashed var(--ps-surface-cinematic-3);border-radius:16px}
  .rx-empty-big{font-family:var(--ps-font-en);font-size:20px;font-weight:600;color:#fff;margin:0 0 8px}
  .rx-empty-sub{font-size:13px;color:var(--ps-text-cinematic-secondary);margin:0 0 20px}
</style>

<!-- ===== LECTURES ===== -->
<section id="lectures">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">강의 자료</h2>
      <span class="en">Lectures</span>
    </header>

    <!-- ── Featured: 온라인 연수 녹화본 (compact) ── -->
    <div class="lecture-section">
      <header class="lecture-subsection-header">
        <h3 class="ko">온라인 연수 녹화본</h3>
        <span class="en">Training Archive</span>
      </header>
      <a href="./academica-parcyun-studio/" class="lecture-card compact">
        <span class="lc-id">Archive · Site</span>
        <span class="lc-title">온라인 연수 <strong>녹화본 모아보기</strong></span>
        <span class="lc-arrow">→</span>
      </a>
    </div>

    <!-- ── Sub-section: LLM · Harness Agent ── -->
    <div class="lecture-section">
      <header class="lecture-subsection-header">
        <h3 class="ko">LLM · Harness Agent</h3>
        <span class="en">LLM &amp; Harness</span>
      </header>
      <div class="lecture-grid">
        <!-- Lecture 001 -->
        <a href="./llm-fundamentals/" class="lecture-card">
          <div class="lecture-card-poster">
            <div class="lid">Lecture · 001</div>
            <p class="ptitle">
              하네스 에이전트를 위한<br>
              <strong>생성형 AI</strong> 기본 이해
            </p>
          </div>
          <div class="lecture-card-body">
            <div class="lecture-card-meta">
              <span>2026.05.10</span>
              <span class="dot"></span>
              <span>44 slides</span>
              <span class="dot"></span>
              <span>FOR EDUCATORS</span>
            </div>
            <h3 class="lecture-card-title">LLM 이해하기 · LLM Fundamentals</h3>
            <p class="lecture-card-desc">
              NLP · LLM · Tokenization부터 Markdown · Skills · API · MCP · Harness · Orchestration까지 ─ 자율형 AI 에이전트를 다루기 위해 반드시 알아야 할 개념을 17개 풀스크롤 섹션으로 정리.
            </p>
            <div class="lecture-card-tags">
              <span class="tag-pill">LLM</span>
              <span class="tag-pill">MCP</span>
              <span class="tag-pill">Agent</span>
            </div>
          </div>
        </a>

        <!-- Lecture 002 -->
        <a href="https://parcyun.notion.site/Agentic-AI-with-LLM-3593f99a82238070ab4be47cefd571d7" class="lecture-card" target="_blank" rel="noopener">
          <div class="lecture-card-poster">
            <div class="lid">Lecture · 002 · Hands-On</div>
            <p class="ptitle">
              <strong>Claude Desktop</strong><br>
              따라하기 실습
            </p>
          </div>
          <div class="lecture-card-body">
            <div class="lecture-card-meta">
              <span>2026.05.10</span>
              <span class="dot"></span>
              <span>NOTION ↗</span>
              <span class="dot"></span>
              <span>HANDS-ON</span>
            </div>
            <h3 class="lecture-card-title">Agentic AI with LLM</h3>
            <p class="lecture-card-desc">
              Claude Desktop을 자율형 에이전트로 직접 셋업하고 운영해보는 실습 가이드. LLM 강의에서 배운 Skills · MCP · Harness · Orchestration 개념을 실제 워크플로우로 구축합니다.
            </p>
            <div class="lecture-card-tags">
              <span class="tag-pill">Claude Desktop</span>
              <span class="tag-pill">MCP</span>
              <span class="tag-pill">실습</span>
            </div>
          </div>
        </a>

        <!-- Coming soon placeholder -->
        <div class="lecture-card placeholder">
          <p class="topic">Sub-Agent 오케스트레이션</p>
          <span class="cs-label">Coming Soon</span>
        </div>
      </div>
    </div>

    <!-- ── Sub-section: Notion 활용 ── -->
    <div class="lecture-section">
      <header class="lecture-subsection-header">
        <h3 class="ko">Notion 활용</h3>
        <span class="en">Notion</span>
      </header>
      <div class="lecture-grid">
        <a href="https://parcyun.notion.site/Notion-8280d9f2847044e6bf48b25a1f199d76" class="lecture-card" target="_blank" rel="noopener">
          <div class="lecture-card-poster">
            <div class="lid">Guide · 001</div>
            <p class="ptitle">
              <strong>Notion</strong><br>
              Onboarding
            </p>
          </div>
          <div class="lecture-card-body">
            <div class="lecture-card-meta">
              <span>2026.06.02</span>
              <span class="dot"></span>
              <span>NOTION ↗</span>
              <span class="dot"></span>
              <span>BEGINNER</span>
            </div>
            <h3 class="lecture-card-title">Notion 온보딩 가이드</h3>
            <p class="lecture-card-desc">
              처음 Notion을 시작하는 사용자를 위한 단계별 가이드 ─ 워크스페이스 셋업부터 페이지·데이터베이스 구조화까지 한 번에 익히기.
            </p>
            <div class="lecture-card-tags">
              <span class="tag-pill">Notion</span>
              <span class="tag-pill">온보딩</span>
              <span class="tag-pill">기초</span>
            </div>
          </div>
        </a>
        <div class="lecture-card placeholder">
          <p class="topic">Notion 업무 자동화</p>
          <span class="cs-label">Coming Soon</span>
        </div>
        <div class="lecture-card placeholder">
          <p class="topic">교사용 Notion 템플릿</p>
          <span class="cs-label">Coming Soon</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== 교육 활동 자료 (Educational Activities) ===== -->
<section id="activities">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">교육 활동 자료</h2>
      <span class="en">Educational Activities</span>
    </header>

    <!-- ── Sub-section: 국어 ── -->
    <div class="lecture-section">
      <header class="lecture-subsection-header">
        <h3 class="ko">국어</h3>
        <span class="en">Korean</span>
      </header>
      <div class="lecture-grid">

        <!-- Activity 001: 맞춤법 연습 게임 -->
        <a href="/korean-spell-drill-parcyun/" class="lecture-card" target="_blank" rel="noopener">
          <div class="lecture-card-poster">
            <div class="lid">Activity · 001</div>
            <p class="ptitle">
              <strong>맞춤법</strong><br>
              연습 게임
            </p>
          </div>
          <div class="lecture-card-body">
            <div class="lecture-card-meta">
              <span>2026.05.15</span>
              <span class="dot"></span>
              <span>GAME ↗</span>
              <span class="dot"></span>
              <span>초등</span>
            </div>
            <h3 class="lecture-card-title">한글 맞춤법 연습 게임</h3>
            <p class="lecture-card-desc">
              헷갈리기 쉬운 한글 맞춤법을 게임으로 익히는 학생용 학습 도구. 짧은 자투리 시간에 교실에서 바로 활용 가능합니다.
            </p>
            <div class="lecture-card-tags">
              <span class="tag-pill">국어</span>
              <span class="tag-pill">맞춤법</span>
              <span class="tag-pill">게임</span>
            </div>
          </div>
        </a>

        <div class="lecture-card placeholder">
          <p class="topic">국어 활동 자료 추가 예정</p>
          <span class="cs-label">Coming Soon</span>
        </div>

        <div class="lecture-card placeholder">
          <p class="topic">국어 활동 자료 추가 예정</p>
          <span class="cs-label">Coming Soon</span>
        </div>

      </div>
    </div>

    <!-- ── Sub-section: 수학 ── -->
    <div class="lecture-section">
      <header class="lecture-subsection-header">
        <h3 class="ko">수학</h3>
        <span class="en">Math</span>
      </header>

      <!-- ▸ 도형과 기하 -->
      <header class="lecture-subsubsection-header">
        <h4 class="ko">도형과 기하</h4>
        <span class="en">Geometry</span>
      </header>
      <div class="lecture-grid">

        <!-- Activity: 입체도형의 부피 -->
        <a href="./math-solid-volume/" class="lecture-card">
          <div class="lecture-card-poster">
            <div class="lid">Activity · 부피</div>
            <p class="ptitle">
              쌓기나무로 푸는<br>
              <strong>입체도형의 부피</strong>
            </p>
          </div>
          <div class="lecture-card-body">
            <div class="lecture-card-meta">
              <span>2026.06.23</span>
              <span class="dot"></span>
              <span>활동지 + 정답</span>
              <span class="dot"></span>
              <span>6학년</span>
            </div>
            <h3 class="lecture-card-title">쌓기나무 공장 · 부피 검수 미션</h3>
            <p class="lecture-card-desc">
              세기 = 곱하기를 발견하고, 셀 수 없는 상자를 곱셈으로 검수하고, 역추리·불량 검수까지 ─ 3단계 공장 게임으로 직육면체의 부피(가로×세로×높이)를 익히는 인쇄용 활동지.
            </p>
            <div class="lecture-card-tags">
              <span class="tag-pill">부피</span>
              <span class="tag-pill">직육면체</span>
              <span class="tag-pill">인쇄용</span>
            </div>
          </div>
        </a>

        <div class="lecture-card placeholder">
          <p class="topic">도형과 기하 활동 자료 추가 예정</p>
          <span class="cs-label">Coming Soon</span>
        </div>

        <div class="lecture-card placeholder">
          <p class="topic">도형과 기하 활동 자료 추가 예정</p>
          <span class="cs-label">Coming Soon</span>
        </div>

      </div>
    </div>

    <!-- ── Sub-section: 사회 ── -->
