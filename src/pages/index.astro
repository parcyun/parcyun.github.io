/* ===== Career section · collapsible ===== */
.career-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: 1px solid var(--ps-surface-cinematic-3);
  color: var(--ps-text-cinematic-secondary);
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  border-radius: 100px;
  padding: 8px 16px;
  cursor: pointer;
  margin-top: 32px;
  transition: border-color 240ms var(--ps-ease-out), color 240ms var(--ps-ease-out);
}
.career-toggle:hover { border-color: var(--ps-primary); color: var(--ps-primary); }
.career-toggle .chev {
  display: inline-block;
  transition: transform 240ms var(--ps-ease-out);
  font-size: 12px;
  line-height: 1;
}
.career-toggle[aria-expanded="true"] .chev { transform: rotate(180deg); }
.career-list.collapsed .career-category-header,
.career-list.collapsed .career-item { display: none; }
.career-list.collapsed { border-top: none; padding-top: 0; margin-top: 0; }

</style>

<script is:inline>
function toggleCareer(btn){
  var list = document.getElementById('career-list');
  var expanded = btn.getAttribute('aria-expanded') === 'true';
  btn.setAttribute('aria-expanded', String(!expanded));
  list.classList.toggle('collapsed', expanded);
  btn.querySelector('.label').textContent = expanded ? '경력 전체 보기' : '경력 접기';
}
</script>
