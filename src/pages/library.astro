---
import { resources } from '../data/resources';
const lectures = resources.filter((r) => r.category === '강의 자료');
const palette = ["linear-gradient(180deg,#2b2119,#181109)","linear-gradient(180deg,#1d2431,#111620)","linear-gradient(180deg,#2b1f27,#160e14)","linear-gradient(180deg,#232a21,#141812)","linear-gradient(180deg,#2a2620,#161310)"];
const spine = (r) => r.title.split(' · ')[0];
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>LIBRARY · 강의 자료 · parcyun studio</title>
<meta name="description" content="parcyun studio 강의 자료를 책장처럼 모아둔 서가. 교육·AI·디자인 강의를 한 권씩 꺼내 보세요. Designed by parcyun studio." />
<meta property="og:title" content="LIBRARY · parcyun studio" />
<meta property="og:description" content="강의 자료를 책장처럼 모아둔 서가." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://parcyun.github.io/library/" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

<style is:global>

/* === parcyun studio · Cinematic Mode tokens === */
:root {
  --ps-primary:                    #FFB11A;
  --ps-primary-dark:               #E89500;

  --ps-bg-cinematic:               #000000;
  --ps-surface-cinematic-1:        #141414;
  --ps-surface-cinematic-2:        #222222;
  --ps-surface-cinematic-3:        #333333;
  --ps-text-cinematic-secondary:   #8C8C8C;

  --ps-font-body: 'Pretendard Variable', 'Pretendard', 'Montserrat', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
  --ps-font-en:   'Montserrat', 'Pretendard Variable', 'Pretendard', sans-serif;
  --ps-font-signature: 'Covered By Your Grace', cursive;

  --ps-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
}

body {
  background: var(--ps-bg-cinematic);
  color: #FFFFFF;
  font-family: var(--ps-font-body);
  font-weight: 300;
  line-height: 1.6;
  word-break: keep-all;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }

/* ===== Top corner mark ===== */
.ps-corner {
  position: fixed;
  top: 20px;
  left: 24px;
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.5px;
  color: var(--ps-text-cinematic-secondary);
  z-index: 90;
  transition: color 240ms var(--ps-ease-out);
}
.ps-corner:hover { color: var(--ps-primary); }

/* ===== Layout ===== */
.wrap {
  max-width: 1108px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 768px) {
  .wrap { padding: 0 48px; }
}

section {
  padding: 96px 0;
}
@media (min-width: 768px) {
  section { padding: 120px 0; }
}

/* ===== Bilingual Section Header ===== */
.section-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 48px;
}
@media (min-width: 768px) {
  .section-header { flex-direction: row; align-items: baseline; gap: 16px; }
}
.section-header .ko {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 300;
  letter-spacing: -1.2px;
  line-height: 1.2;
  margin: 0;
  color: #FFFFFF;
}
.section-header .en {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Mandatory parcyun footer ===== */
.ps-footer {
  position: fixed;
  bottom: 16px;
  right: 20px;
  font-family: var(--ps-font-en);
  font-weight: 300;
  font-size: 11px;
  color: var(--ps-text-cinematic-secondary);
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 6px 12px;
  border-radius: 100px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.ps-signature {
  font-family: var(--ps-font-signature);
  font-size: 15px;
  color: var(--ps-primary);
  line-height: 1;
}
.ps-ig {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: inherit;
  text-decoration: none;
  margin-left: 4px;
}
.ps-ig:hover { color: var(--ps-primary); }
.ps-ig-icon { width: 10px; height: 10px; vertical-align: middle; }

/* ===== Entry animation ===== */
section, .hero {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 800ms var(--ps-ease-out), transform 800ms var(--ps-ease-out);
}
section.in-view, .hero.in-view {
  opacity: 1;
  transform: none;
}
.hero { opacity: 1; transform: none; } /* hero is always visible */

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  section, .hero { opacity: 1; transform: none; transition: none; }
}

/* ===== Floating nav (top / bottom) ===== */
.float-nav {
  position: fixed;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 80;
}
.float-nav button {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  font-family: var(--ps-font-en);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 240ms var(--ps-ease-out), color 240ms var(--ps-ease-out), transform 240ms var(--ps-ease-out);
}
.float-nav button:hover {
  border-color: var(--ps-primary);
  color: var(--ps-primary);
  transform: translateY(-2px);
}
@media (max-width: 639px) {
  .float-nav { right: 12px; gap: 6px; }
  .float-nav button { width: 36px; height: 36px; font-size: 13px; }
}

/* ===== Footer (ps-footer) · 업무 대시보드 link ===== */
.ps-footer-link {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.3px;
  color: var(--ps-text-cinematic-secondary);
  text-decoration: none;
  padding-right: 10px;
  margin-right: 4px;
  border-right: 1px solid rgba(255, 255, 255, 0.14);
  transition: color 240ms var(--ps-ease-out);
}
.ps-footer-link:hover { color: var(--ps-primary); }
.ps-footer-coffee {
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.3px;
  color: var(--ps-primary);
  background: transparent;
  border: 0;
  padding: 0 10px 0 0;
  margin-right: 4px;
  border-right: 1px solid rgba(255, 255, 255, 0.14);
  cursor: pointer;
  transition: color 240ms var(--ps-ease-out);
}
.ps-footer-coffee:hover { color: var(--ps-primary-dark); }

/* ===== 커피 후원 QR 팝업 ===== */
.coffee-modal {
  position: fixed; inset: 0; z-index: 10000;
  display: flex; align-items: center; justify-content: center; padding: 24px;
}
.coffee-modal[hidden] { display: none; }
.coffee-backdrop {
  position: absolute; inset: 0;
  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  animation: coffeeFade 0.2s var(--ps-ease-out);
}
@keyframes coffeeFade { from { opacity: 0; } to { opacity: 1; } }
.coffee-card {
  position: relative; z-index: 1;
  background: var(--ps-surface-cinematic-1);
  border: 1px solid var(--ps-primary);
  border-radius: 18px;
  padding: 32px 32px 26px;
  text-align: center; max-width: 340px; width: 100%;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(255, 177, 26, 0.12);
  animation: coffeePop 0.28s var(--ps-ease-out);
}
@keyframes coffeePop { from { opacity: 0; transform: translateY(16px) scale(0.96); } to { opacity: 1; transform: none; } }
.coffee-close {
  position: absolute; top: 12px; right: 16px;
  background: transparent; border: 0;
  color: var(--ps-text-cinematic-secondary);
  font-size: 24px; line-height: 1; cursor: pointer;
  transition: color 150ms var(--ps-ease-out);
}
.coffee-close:hover { color: var(--ps-primary); }
.coffee-emoji { font-size: 40px; line-height: 1; margin-bottom: 10px; }
.coffee-title { margin: 0 0 6px; font-size: 19px; font-weight: 500; color: #FFFFFF; }
.coffee-sub { margin: 0 0 20px; font-size: 13px; font-weight: 300; color: var(--ps-text-cinematic-secondary); line-height: 1.6; }
.coffee-qr { display: block; width: 220px; height: 220px; margin: 0 auto 14px; border-radius: 12px; background: #fff; padding: 10px; object-fit: contain; }
.coffee-qr-fallback { display: none; margin: 0 auto 14px; padding: 40px 16px; border: 1px dashed var(--ps-surface-cinematic-3); border-radius: 12px; font-family: var(--ps-font-en); font-size: 12px; color: var(--ps-text-cinematic-secondary); }
.coffee-label { font-family: var(--ps-font-signature); font-size: 20px; color: var(--ps-primary); }


  /* ===== LIBRARY · 히어로 ===== */
  .ps-corner{font-family:var(--ps-font-en);font-size:12px;letter-spacing:.04em}
  .lib-hero{padding:104px 0 20px}
  .lib-eyebrow{font-family:var(--ps-font-en);font-size:12px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--ps-primary)}
  .lib-wordmark{font-family:var(--ps-font-en);font-weight:800;font-size:clamp(52px,13vw,140px);line-height:.86;letter-spacing:-.035em;margin:16px 0 0;text-transform:uppercase}
  .lib-wordmark .g{color:var(--ps-primary);text-shadow:0 0 46px rgba(255,177,26,.42)}
  .lib-tagline{margin:22px 0 0;max-width:560px;font-size:15px;line-height:1.75;color:#EDEDED;font-weight:300}
  .lib-tagline .amber{color:var(--ps-primary);font-weight:500}
  .lib-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}
  .lib-pill{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:100px;font-size:14px;font-weight:600;font-family:var(--ps-font-body);transition:all .2s var(--ps-ease-out)}
  .lib-pill.ghost{border:1px solid var(--ps-surface-cinematic-3);color:#fff}
  .lib-pill.ghost:hover{border-color:var(--ps-primary);color:var(--ps-primary)}

  /* ===== 책장 (Bookshelf) ===== */
  .lib-hint{font-size:13px;color:var(--ps-text-cinematic-secondary);margin:-4px 0 22px}
  .bookshelf{position:relative;margin-top:8px}
  .shelf{display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;padding:0 10px;min-height:340px}
  .book{position:relative;width:70px;min-height:250px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;
    padding:0 0 16px;border-radius:5px 5px 3px 3px;color:#fff;text-decoration:none;overflow:hidden;
    border:1px solid rgba(255,255,255,.08);
    box-shadow:inset 3px 0 0 rgba(255,255,255,.07), inset -5px 0 10px rgba(0,0,0,.45), 0 12px 22px rgba(0,0,0,.4);
    transition:transform .24s var(--ps-ease-out), box-shadow .24s var(--ps-ease-out)}
  .book:hover{transform:translateY(-20px);box-shadow:inset 3px 0 0 rgba(255,255,255,.1), inset -5px 0 12px rgba(0,0,0,.5), 0 22px 36px rgba(0,0,0,.55), 0 0 26px rgba(255,177,26,.25)}
  .book-cap{width:100%;padding:12px 0 11px;text-align:center;font-size:22px;line-height:1;background:linear-gradient(180deg,rgba(255,177,26,.22),rgba(255,177,26,0));border-bottom:1px solid rgba(255,177,26,.28)}
  .book-title{writing-mode:vertical-rl;text-orientation:mixed;font-family:var(--ps-font-body);font-weight:600;font-size:15px;letter-spacing:.03em;color:#fff;white-space:nowrap;margin:16px 0 auto;line-height:1}
  .book-foot{font-family:var(--ps-font-en);font-size:9px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.62);margin-top:12px}
  .book.empty{background:repeating-linear-gradient(180deg,#141414 0 8px,#101010 8px 16px);border-style:dashed;border-color:var(--ps-surface-cinematic-3);box-shadow:inset 0 0 0 1px rgba(255,255,255,.02)}
  .book.empty .book-title{color:var(--ps-text-cinematic-secondary);font-weight:500}
  .shelf-board{height:18px;margin:0 -2px;border-radius:3px;
    background:linear-gradient(180deg,#3b2c14 0%,#2a1f0e 55%,#1c1408 100%);
    box-shadow:0 14px 28px rgba(0,0,0,.55), inset 0 2px 0 rgba(255,177,26,.3), inset 0 -2px 4px rgba(0,0,0,.5)}
  .shelf-legend{display:flex;gap:16px;flex-wrap:wrap;margin-top:18px;font-family:var(--ps-font-en);font-size:11px;letter-spacing:.06em;color:var(--ps-text-cinematic-secondary);text-transform:uppercase}
  .shelf-legend b{color:var(--ps-primary);font-weight:700}
  @media(max-width:520px){.book{width:58px;min-height:220px}.book-title{font-size:13px}}

</style>
</head>
<body>

<a href="/" class="ps-corner">← parcyun studio</a>

<!-- ===== HERO ===== -->
<section class="hero lib-hero">
  <div class="wrap">
    <div class="lib-eyebrow">Lecture Shelf</div>
    <h1 class="lib-wordmark">LIBRA<span class="g">RY</span></h1>
    <p class="lib-tagline">
      교육 · AI · 디자인 <span class="amber">강의 자료</span>를 책장처럼 모아둔 서가예요. 📚<br>
      아래에서 한 권씩 꺼내 보세요.
    </p>
    <div class="lib-actions">
      <a href="/atlas-gears/" class="lib-pill ghost">교육 활동 자료 · ATLAS GEARS →</a>
      <a href="/" class="lib-pill ghost">← parcyun studio 메인</a>
    </div>
  </div>
</section>

<!-- ===== 책장 ===== -->
<section id="shelf">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">강의 서가</h2>
      <span class="en">The Shelf</span>
    </header>
    <p class="lib-hint">책등을 클릭하면 해당 강의로 이동해요. 마우스를 올리면 책이 살짝 올라옵니다.</p>
    <div class="bookshelf">
      <div class="shelf">
        {lectures.map((r, i) => (
          <a href={r.url} class="book" style={`background:${palette[i % palette.length]}`} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener' : undefined}>
            <span class="book-cap">{r.thumb}</span>
            <span class="book-title">{spine(r)}</span>
            <span class="book-foot">{r.type}</span>
          </a>
        ))}
        <div class="book empty"><span class="book-cap">✦</span><span class="book-title">다음 강의 준비 중</span><span class="book-foot">Soon</span></div>
        <div class="book empty" style="min-height:210px"><span class="book-cap">✦</span><span class="book-title">Coming soon</span><span class="book-foot">Soon</span></div>
      </div>
      <div class="shelf-board"></div>
    </div>
    <div class="shelf-legend">
      <span><b>{lectures.length}</b> 권 · Lectures</span>
      <span>📚 교육 · AI · 디자인</span>
    </div>
  </div>
</section>

<!-- ===== footer ===== -->
<footer class="ps-footer">
  <a href="/" class="ps-footer-link">← parcyun studio</a>
  Designed by
  <span class="ps-signature">parcyun studio</span>
  <a href="https://www.instagram.com/parcyun" class="ps-ig" target="_blank" rel="noopener">
    <svg class="ps-ig-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4 1 .5.4.8.8 1 1.4.2.4.3 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-1 1.4-.4.5-.8.8-1.4 1-.4.2-1 .3-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-1-.5-.4-.8-.8-1-1.4-.2-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 1-1.4.4-.5.8-.8 1.4-1 .4-.2 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 5.5a4.3 4.3 0 100 8.6 4.3 4.3 0 000-8.6zm5.4-.3a1 1 0 11-2 0 1 1 0 012 0zM12 9.5a2.5 2.5 0 110 5 2.5 2.5 0 010-5z"/></svg>
    @parcyun
  </a>
</footer>

<script is:inline>
(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { document.querySelectorAll('section').forEach(function(el){ el.classList.add('in-view'); }); return; }
  var io = new IntersectionObserver(function(entries){ entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -15% 0px', threshold: 0.05 });
  document.querySelectorAll('section').forEach(function(el){ io.observe(el); });
})();
</script>
<script is:inline src="/share-widget.js" defer></script>
<script is:inline src="/visitor-counter.js" defer></script>
</body>
</html>
