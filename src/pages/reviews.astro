---
import CinematicLayout from '../layouts/CinematicLayout.astro';
---
<CinematicLayout title="리뷰 · parcyun studio" description="parcyun studio를 사용한 선생님들의 리뷰" showFeedback={true}>
  <main class="reviews-page">
    <section class="reviews-hero">
      <div class="wrap">
        <p class="reviews-eyebrow">FROM THE CLASSROOM</p>
        <h1>선생님의 경험이<br /><span>다음 업데이트가 됩니다.</span></h1>
        <p class="reviews-lede">로그인이나 개인정보 없이, 별점과 한 줄의 경험만 남겨 주세요.<br />모든 리뷰는 확인 후 공개됩니다.</p>
      </div>
    </section>
    <section class="reviews-section">
      <div class="wrap reviews-grid">
        <div class="review-composer" data-reviews-app>
          <p class="reviews-kicker">WRITE A REVIEW</p>
          <h2>수업에서 써 보셨나요?</h2>
          <div class="review-stars" data-review-stars aria-label="별점 선택"></div>
          <textarea data-review-body maxlength="500" placeholder="수업에서 어떤 점이 좋았나요?"></textarea>
          <div class="review-form-meta"><span data-review-count>0 / 500</span><button type="button" data-review-submit>리뷰 남기기</button></div>
          <p class="review-message" data-review-message role="status"></p>
        </div>
        <div class="review-list-wrap">
          <p class="reviews-kicker">REVIEWS</p>
          <h2>개선 아이디어와 경험</h2>
          <div class="review-list" data-review-list><p class="review-empty">아직 공개된 리뷰가 없습니다.</p></div>
        </div>
      </div>
    </section>
  </main>
</CinematicLayout>

<style is:global>
  .reviews-page{min-height:calc(100vh - 56px)}
  .reviews-hero{padding:150px 0 72px}
  .reviews-eyebrow,.reviews-kicker{font-family:var(--ps-font-en);font-size:11px;letter-spacing:.18em;color:var(--ps-primary);font-weight:600}
  .reviews-hero h1{font-size:clamp(38px,6vw,72px);line-height:1.14;font-weight:300;letter-spacing:-.06em;margin:18px 0 24px}
  .reviews-hero h1 span{color:var(--ps-primary)}
  .reviews-lede{color:var(--ps-text-cinematic-secondary);font-size:15px;line-height:1.9}
  .reviews-section{padding:40px 0 120px}
  .reviews-grid{display:flex;flex-direction:column;gap:72px}
  .review-composer,.review-list-wrap{border-top:1px solid rgba(255,255,255,.16);padding-top:20px}
  .review-list-wrap{order:-1}
  .reviews-grid h2{font-size:24px;font-weight:400;margin:12px 0 24px}
  .review-stars{display:flex;gap:4px;margin-bottom:16px;align-items:center}
  .review-star{appearance:none;-webkit-appearance:none;display:inline-block;width:auto;height:auto;min-width:0;min-height:0;border:0!important;border-radius:0;background:transparent!important;box-shadow:none;padding:0 2px;color:#555;font-size:28px;line-height:1;cursor:pointer;transition:color .16s ease,transform .16s ease}
  .review-star:hover,.review-star:focus-visible,.review-star.active{color:var(--ps-primary)}
  .review-star:hover,.review-star:focus-visible{transform:translateY(-1px)}
  .review-star:focus-visible{outline:1px solid var(--ps-primary);outline-offset:4px;border-radius:2px}
  .review-composer textarea{display:block;width:100%;min-height:150px;resize:vertical;background:#111;border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:16px;color:#fff;font:inherit;line-height:1.7}
  .review-composer textarea:focus{outline:1px solid var(--ps-primary);border-color:var(--ps-primary)}
  .review-form-meta{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:12px;color:#666;font-size:12px}
  .review-form-meta button{border:1px solid var(--ps-primary);background:var(--ps-primary);color:#111;border-radius:999px;padding:10px 18px;font:inherit;font-size:12px;font-weight:600;cursor:pointer}
  .review-message{min-height:24px;color:var(--ps-primary);font-size:13px;line-height:1.6}
  .review-card{padding:20px 0;border-bottom:1px solid rgba(255,255,255,.1)}
  .review-card-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:8px}
  .review-card-stars{color:var(--ps-primary);letter-spacing:.12em}
  .review-card time{font-size:11px;color:#666}
  .review-card p{margin:0;color:#ddd;line-height:1.75;font-size:14px}
  .review-like{margin-top:12px;border:1px solid rgba(255,255,255,.2);border-radius:999px;background:transparent;color:#aaa;padding:5px 10px;font:11px var(--ps-font-en);cursor:pointer}
  .review-like:hover,.review-like[aria-pressed="true"]{border-color:var(--ps-primary);color:var(--ps-primary)}
  .review-list{max-height:var(--review-list-max-height);overflow-y:auto;scrollbar-width:none}
  .review-list::-webkit-scrollbar{display:none}
  .review-list-wrap.has-overflow{position:relative}
  .review-list-wrap.has-overflow:not(.is-at-end)::after{content:"";position:absolute;left:0;right:0;bottom:0;height:96px;pointer-events:none;background:linear-gradient(transparent,var(--ps-bg,#0f0e0d))}
  .review-empty{color:#666;font-size:14px}
  @media(max-width:767px){.reviews-hero{padding:120px 0 56px}.reviews-grid{gap:56px}.reviews-section{padding-bottom:80px}}
</style>
<script is:inline src="/review-viewport.js?v=20260720.3" defer></script>
<script is:inline src="/reviews.js?v=20260720.3" defer></script>
