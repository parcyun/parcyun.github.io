---
import WorksFilter from '../components/WorksFilter.tsx';
import { icon } from '../lib/icons';
import PsFooter from '../components/PsFooter.astro';
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>parcyun studio · Works</title>
<meta name="description" content="매주 하나씩 만드는 웹서비스 아카이브. 1주 1웹서비스 프로젝트. Designed by parcyun studio.">
<meta property="og:title" content="parcyun studio · Works">
<meta property="og:description" content="매주 하나씩, 웹서비스를 만들어 쌓습니다. 1 Week · 1 Web Service.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://parcyun.github.io/works/">
  <link rel="canonical" href="https://parcyun.github.io/works/">
  <meta property="og:image" content="https://parcyun.github.io/images/og-card.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://parcyun.github.io/images/og-card.png" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">

<style is:global>
/* === parcyun studio · Cinematic Mode tokens === */
:root {
  --ps-primary:                    #FFB11A;
  --ps-primary-dark:               #E89500;

  --ps-bg-cinematic:               #000000;
  --ps-surface-cinematic-1:        #141414;
  --ps-surface-cinematic-2:        #222222;
  --ps-surface-cinematic-3:        #333333;
  --ps-text-cinematic-secondary:   #8C8C8C;

  --ps-font-body: 'Pretendard Variable', 'Pretendard', 'Montserrat', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
  --ps-font-en:   'Montserrat', 'Pretendard Variable', 'Pretendard', sans-serif;
  --ps-font-signature: 'Covered By Your Grace', cursive;

  --ps-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background: var(--ps-bg-cinematic);
  color: #FFFFFF;
  font-family: var(--ps-font-body);
  font-weight: 300;
  line-height: 1.6;
  word-break: keep-all;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }


/* ===== Layout ===== */
.wrap {
  max-width: 1108px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 768px) {
  .wrap { padding: 0 48px; }
}

section { padding: 96px 0; }
@media (min-width: 768px) {
  section { padding: 120px 0; }
}

/* ===== Bilingual Section Header ===== */
.section-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 48px;
}
@media (min-width: 768px) {
  .section-header { flex-direction: row; align-items: baseline; gap: 16px; }
}
.section-header .ko {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 300;
  letter-spacing: -1.2px;
  line-height: 1.2;
  margin: 0;
  color: #FFFFFF;
}
.section-header .en {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Hero ===== */
.hero {
  min-height: 92vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 120px 24px 80px;
  position: relative;
}
@media (min-width: 768px) {
  .hero { padding: 120px 48px 80px; }
}
.hero-inner {
  max-width: 1108px;
  margin: 0 auto;
  width: 100%;
}
.hero-eyebrow {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--ps-primary);
  margin-bottom: 32px;
}
.hero-wordmark {
  font-family: var(--ps-font-signature);
  font-size: clamp(72px, 14vw, 180px);
  font-weight: 400;
  letter-spacing: -2px;
  line-height: 1.15;
  margin: 0 0 24px;
  color: var(--ps-primary);
}
.hero-name {
  font-family: var(--ps-font-en);
  font-size: clamp(13px, 1.3vw, 16px);
  font-weight: 300;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
  margin: 0 0 48px;
}
.hero-tagline {
  font-size: clamp(20px, 2.5vw, 32px);
  font-weight: 300;
  letter-spacing: -0.8px;
  line-height: 1.4;
  max-width: 760px;
  margin: 0 0 48px;
  color: #FFFFFF;
}
.hero-tagline strong { font-weight: 500; color: var(--ps-primary); }

.hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  font-family: var(--ps-font-en);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.3px;
  border-radius: 100px;
  transition: all 240ms var(--ps-ease-out);
  cursor: pointer;
  border: 1px solid transparent;
}
.btn.primary { background: var(--ps-primary); color: #000; }
.btn.primary:hover { background: var(--ps-primary-dark); transform: translateY(-2px); }
.btn.ghost { background: transparent; border-color: var(--ps-surface-cinematic-3); color: #FFFFFF; }
.btn.ghost:hover { border-color: var(--ps-primary); color: var(--ps-primary); }
.btn .arrow { font-size: 16px; line-height: 1; }

/* ===== Project counter strip ===== */
.works-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 28px;
  margin-top: 8px;
}
.works-meta .stat { display: flex; flex-direction: column; gap: 4px; }
.works-meta .stat .num {
  font-family: var(--ps-font-en);
  font-size: clamp(28px, 3.4vw, 40px);
  font-weight: 600;
  letter-spacing: -1px;
  color: var(--ps-primary);
  line-height: 1;
}
.works-meta .stat .lbl {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Works grid ===== */
.works {
  border-top: 1px solid var(--ps-surface-cinematic-3);
}
.work-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
@media (min-width: 768px) {
  .work-grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
}
@media (min-width: 1024px) {
  .work-grid { grid-template-columns: repeat(3, 1fr); }
}

.work-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: #FFFFFF;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 16px;
  overflow: hidden;
  transition: border-color 320ms var(--ps-ease-out), transform 320ms var(--ps-ease-out);
}
.work-card.live:hover { border-color: var(--ps-primary); transform: translateY(-4px); }

/* Typographic poster (no external image needed) */
.work-poster {
  aspect-ratio: 370 / 220;
  background: var(--ps-surface-cinematic-1);
  position: relative;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}
.work-poster::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(at 80% 20%, rgba(255, 177, 26, 0.10) 0%, transparent 50%),
    radial-gradient(at 20% 80%, rgba(255, 177, 26, 0.05) 0%, transparent 50%);
  pointer-events: none;
}
.work-poster .pnum {
  position: relative;
  font-family: var(--ps-font-en);
  font-size: clamp(40px, 6vw, 64px);
  font-weight: 700;
  letter-spacing: -2px;
  line-height: 1;
  color: rgba(255, 255, 255, 0.10);
}
.work-poster .ptitle {
  position: relative;
  font-size: clamp(18px, 1.8vw, 22px);
  font-weight: 500;
  letter-spacing: -0.5px;
  line-height: 1.25;
  color: #FFFFFF;
}

/* status pill */
.status {
  position: absolute;
  top: 20px;
  right: 20px;
  font-family: var(--ps-font-en);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 100px;
  z-index: 2;
}
.status.live {
  color: #000;
  background: var(--ps-primary);
}
.status.soon {
  color: var(--ps-text-cinematic-secondary);
  border: 1px solid var(--ps-surface-cinematic-3);
}

.work-body {
  padding: 22px 24px 26px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex: 1;
}
.work-week {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--ps-primary);
}
.work-desc {
  font-size: 14px;
  font-weight: 300;
  line-height: 1.6;
  color: #D4D4D4;
  margin: 0;
}
.work-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  padding-top: 4px;
}
.work-tags span {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0.8px;
  color: var(--ps-text-cinematic-secondary);
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 100px;
  padding: 3px 10px;
}

/* placeholder / coming-soon card */
.work-card.soon { cursor: default; }
.work-card.soon .work-poster { background: var(--ps-surface-cinematic-1); }
.work-card.soon .pnum { color: rgba(255, 255, 255, 0.06); }
.work-card.soon .ptitle { color: var(--ps-text-cinematic-secondary); }

/* ===== Titan tools ===== */
.titan-tools {
  border-top: 1px solid var(--ps-surface-cinematic-3);
}
.titan-intro {
  max-width: 680px;
  margin: -20px 0 32px;
  color: #B8B8B8;
  font-size: 15px;
  line-height: 1.8;
}
.titan-controls {
  display: grid;
  grid-template-columns: minmax(240px, 1fr) auto;
  gap: 16px 24px;
  align-items: center;
  margin-bottom: 28px;
}
.titan-search {
  position: relative;
}
.titan-search input {
  width: 100%;
  height: 48px;
  padding: 0 46px 0 18px;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 14px;
  background: var(--ps-surface-cinematic-1);
  color: #fff;
  font: 400 14px/1 var(--ps-font-body);
  outline: none;
  transition: border-color 180ms var(--ps-ease-out), box-shadow 180ms var(--ps-ease-out);
}
.titan-search input::placeholder { color: #777; }
.titan-search input:focus {
  border-color: var(--ps-primary);
  box-shadow: 0 0 0 3px rgba(255, 177, 26, 0.12);
}
.titan-search-icon {
  position: absolute;
  top: 50%;
  right: 17px;
  color: var(--ps-text-cinematic-secondary);
  font-size: 16px;
  transform: translateY(-50%);
  pointer-events: none;
}
.titan-filters {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.titan-filter {
  min-height: 38px;
  padding: 0 14px;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 100px;
  background: transparent;
  color: var(--ps-text-cinematic-secondary);
  font: 500 12px/1 var(--ps-font-body);
  cursor: pointer;
  transition: color 180ms var(--ps-ease-out), border-color 180ms var(--ps-ease-out), background 180ms var(--ps-ease-out);
}
.titan-filter:hover { color: #fff; border-color: rgba(255, 177, 26, 0.62); }
.titan-filter.is-active {
  border-color: var(--ps-primary);
  background: var(--ps-primary);
  color: #000;
  font-weight: 700;
}
.titan-item[hidden] { display: none; }
.titan-empty {
  display: none;
  padding: 34px 18px;
  border-top: 1px solid var(--ps-surface-cinematic-3);
  color: var(--ps-text-cinematic-secondary);
  font-size: 14px;
  text-align: center;
}
.titan-empty.is-visible { display: block; }
.titan-list {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--ps-surface-cinematic-3);
}
.titan-item {
  border-bottom: 1px solid var(--ps-surface-cinematic-3);
}
.titan-link {
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) auto;
  align-items: start;
  gap: 20px;
  padding: 28px 0;
  transition: color 240ms var(--ps-ease-out);
}
.titan-link:hover .titan-title,
.titan-link:focus-visible .titan-title {
  color: var(--ps-primary);
}
.titan-link:focus-visible {
  outline: 2px solid var(--ps-primary);
  outline-offset: 8px;
  border-radius: 4px;
}
.titan-num {
  padding-top: 3px;
  font-family: var(--ps-font-en);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 1.4px;
  color: var(--ps-primary);
}
.titan-title {
  display: block;
  margin-bottom: 8px;
  font-size: clamp(18px, 2.2vw, 24px);
  font-weight: 500;
  letter-spacing: -0.5px;
  line-height: 1.35;
  transition: color 240ms var(--ps-ease-out);
}
.titan-desc {
  display: block;
  max-width: 720px;
  color: #B8B8B8;
  font-size: 14px;
  line-height: 1.7;
}
.titan-kind {
  margin-top: 4px;
  padding: 4px 10px;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 100px;
  color: var(--ps-text-cinematic-secondary);
  font-family: var(--ps-font-en);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  white-space: nowrap;
}
@media (max-width: 639px) {
  .titan-controls { grid-template-columns: 1fr; }
  .titan-link {
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 12px;
    padding: 24px 0;
  }
  .titan-kind {
    grid-column: 2;
    justify-self: start;
    margin-top: 0;
  }
}

/* ===== Entry animation ===== */
section, .hero {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 800ms var(--ps-ease-out), transform 800ms var(--ps-ease-out);
}
section.in-view, .hero.in-view { opacity: 1; transform: none; }
.hero { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  section, .hero { opacity: 1; transform: none; transition: none; }
}

  /* ===== Works Filter (동적 상태·태그 필터) ===== */
  .wf-controls{display:flex;flex-direction:column;gap:14px;margin-bottom:20px}
  .wf-tabs{display:flex;gap:8px;flex-wrap:wrap}
  .wf-tab{padding:9px 16px;border-radius:100px;cursor:pointer;font-size:13px;font-weight:500;background:transparent;border:1px solid var(--ps-surface-cinematic-3);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-body);transition:all .18s var(--ps-ease-out)}
  .wf-tab:hover{border-color:var(--ps-primary);color:#fff}
  .wf-tab.on{background:var(--ps-primary);border-color:var(--ps-primary);color:#000;font-weight:700}
  .wf-tags{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  .wf-chip{padding:6px 12px;border-radius:100px;cursor:pointer;font-size:12px;background:var(--ps-surface-cinematic-1);border:1px solid var(--ps-surface-cinematic-3);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-en);transition:all .16s var(--ps-ease-out)}
  .wf-chip:hover{border-color:var(--ps-primary);color:#fff}
  .wf-chip.on{background:rgba(255,177,26,.14);border-color:var(--ps-primary);color:var(--ps-primary);font-weight:700}
  .wf-reset{padding:6px 13px;border:0;border-radius:100px;cursor:pointer;background:var(--ps-surface-cinematic-3);color:#fff;font-size:12px;font-family:var(--ps-font-body);transition:all .18s var(--ps-ease-out)}
  .wf-reset:hover{background:var(--ps-primary);color:#000}
  .wf-count{font-family:var(--ps-font-en);font-size:12px;letter-spacing:.08em;color:var(--ps-text-cinematic-secondary);text-transform:uppercase;margin-bottom:18px}
  .wf-count b{color:var(--ps-primary);font-weight:700;font-size:14px;margin-right:4px}
  .wf-empty{text-align:center;padding:48px 20px;border:1px dashed var(--ps-surface-cinematic-3);border-radius:16px}
  .wf-empty-big{font-family:var(--ps-font-en);font-size:18px;font-weight:600;color:#fff;margin:0 0 16px}
  .ps-topnav{position:fixed;top:16px;right:20px;z-index:90;font-family:var(--ps-font-en);font-size:12px;letter-spacing:.04em;color:#8C8C8C;display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border-radius:100px;border:1px solid rgba(255,255,255,.1);background:rgba(0,0,0,.4);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);transition:color .18s,border-color .18s;text-decoration:none}
  .ps-topnav:hover{color:#fff;border-color:rgba(255,255,255,.25)}
  .ps-back{position:fixed;top:14px;left:16px;z-index:91;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;padding:6px;color:#8C8C8C;cursor:pointer;line-height:0;transition:color .18s}
  .ps-back:hover{color:#fff}
  .ico{display:inline-flex;align-items:center;justify-content:center;line-height:0}
  .ico svg{display:block}
</style>
<noscript><style>section,.hero{opacity:1!important;transform:none!important}</style></noscript>
</head>

<body>

<button data-ps-edit-id="ps-works-001" data-ps-design-id="ps-works-001" type="button" class="ps-back" aria-label="뒤로 가기" onclick="if(history.length>1){history.back()}else{location.href='/'}"><span data-ps-edit-id="ps-works-002" data-ps-design-id="ps-works-002" class="ico" set:html={icon('arrowLeft', 20)}></span></button>

<a data-ps-edit-id="ps-works-003" data-ps-design-id="ps-works-003" href="/" class="ps-topnav"><span data-ps-edit-id="ps-works-004" data-ps-design-id="ps-works-004" class="ico" set:html={icon('home', 15)}></span> parcyun studio</a>

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">1 Week · 1 Web Service</div>
    <h1 data-ps-edit-id="ps-works-005" data-ps-design-id="ps-works-005" class="hero-wordmark">Works</h1>
    <p data-ps-edit-id="ps-works-006" data-ps-design-id="ps-works-006" class="hero-name">parcyun · 박창현</p>
    <p data-ps-edit-id="ps-works-007" data-ps-design-id="ps-works-007" class="hero-tagline">
      작게 시작해 꾸준히 늘려가는 빌드 아카이브.
    </p>
    <div class="hero-ctas">
      <a data-ps-edit-id="ps-works-008" data-ps-design-id="ps-works-008" href="#works" class="btn primary">프로젝트 보기 <span data-ps-edit-id="ps-works-009" data-ps-design-id="ps-works-009" class="arrow">↓</span></a>
      <a data-ps-edit-id="ps-works-010" data-ps-design-id="ps-works-010" href="https://github.com/parcyun" class="btn ghost" target="_blank" rel="noopener">GitHub <span data-ps-edit-id="ps-works-011" data-ps-design-id="ps-works-011" class="arrow">↗</span></a>
    </div>

    <div class="works-meta" style="margin-top:56px;">
      <div class="stat"><span data-ps-edit-id="ps-works-012" data-ps-design-id="ps-works-012" class="num">02</span><span data-ps-edit-id="ps-works-013" data-ps-design-id="ps-works-013" class="lbl">Shipped</span></div>
      <div class="stat"><span data-ps-edit-id="ps-works-014" data-ps-design-id="ps-works-014" class="num">∞</span><span data-ps-edit-id="ps-works-015" data-ps-design-id="ps-works-015" class="lbl">Weekly</span></div>
      <div class="stat"><span data-ps-edit-id="ps-works-016" data-ps-design-id="ps-works-016" class="num">2026</span><span data-ps-edit-id="ps-works-017" data-ps-design-id="ps-works-017" class="lbl">Season</span></div>
    </div>
  </div>
</section>

<!-- ===== WORKS ===== -->
<section class="works" id="works">
  <div class="wrap">
    <header class="section-header">
      <h2 data-ps-edit-id="ps-works-018" data-ps-design-id="ps-works-018" class="ko">웹서비스</h2>
      <span data-ps-edit-id="ps-works-019" data-ps-design-id="ps-works-019" class="en">Weekly Builds</span>
    </header>
    <WorksFilter client:load />
  </div>
</section>

<!-- ===== TITAN TOOLS ===== -->
<section class="titan-tools" id="titan-tools">
  <div class="wrap">
