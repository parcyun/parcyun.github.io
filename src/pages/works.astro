---
import WorksFilter from '../components/WorksFilter.tsx';
import { icon } from '../lib/icons';
import PsFooter from '../components/PsFooter.astro';
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>parcyun studio · Works</title>
<meta name="description" content="매주 하나씩 만드는 웹서비스 아카이브. 1주 1웹서비스 프로젝트. Designed by parcyun studio.">
<meta property="og:title" content="parcyun studio · Works">
<meta property="og:description" content="매주 하나씩, 웹서비스를 만들어 쌓습니다. 1 Week · 1 Web Service.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://parcyun.github.io/works/">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">

<style is:global>
/* === parcyun studio · Cinematic Mode tokens === */
:root {
  --ps-primary:                    #FFB11A;
  --ps-primary-dark:               #E89500;

  --ps-bg-cinematic:               #000000;
  --ps-surface-cinematic-1:        #141414;
  --ps-surface-cinematic-2:        #222222;
  --ps-surface-cinematic-3:        #333333;
  --ps-text-cinematic-secondary:   #8C8C8C;

  --ps-font-body: 'Pretendard Variable', 'Pretendard', 'Montserrat', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
  --ps-font-en:   'Montserrat', 'Pretendard Variable', 'Pretendard', sans-serif;
  --ps-font-signature: 'Covered By Your Grace', cursive;

  --ps-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background: var(--ps-bg-cinematic);
  color: #FFFFFF;
  font-family: var(--ps-font-body);
  font-weight: 300;
  line-height: 1.6;
  word-break: keep-all;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }


/* ===== Layout ===== */
.wrap {
  max-width: 1108px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 768px) {
  .wrap { padding: 0 48px; }
}

section { padding: 96px 0; }
@media (min-width: 768px) {
  section { padding: 120px 0; }
}

/* ===== Bilingual Section Header ===== */
.section-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 48px;
}
@media (min-width: 768px) {
  .section-header { flex-direction: row; align-items: baseline; gap: 16px; }
}
.section-header .ko {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 300;
  letter-spacing: -1.2px;
  line-height: 1.2;
  margin: 0;
  color: #FFFFFF;
}
.section-header .en {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Hero ===== */
.hero {
  min-height: 92vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 120px 24px 80px;
  position: relative;
}
@media (min-width: 768px) {
  .hero { padding: 120px 48px 80px; }
}
.hero-inner {
  max-width: 1108px;
  margin: 0 auto;
  width: 100%;
}
.hero-eyebrow {
  font-family: var(--ps-font-en);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--ps-primary);
  margin-bottom: 32px;
}
.hero-wordmark {
  font-family: var(--ps-font-signature);
  font-size: clamp(72px, 14vw, 180px);
  font-weight: 400;
  letter-spacing: -2px;
  line-height: 1.15;
  margin: 0 0 24px;
  color: var(--ps-primary);
}
.hero-name {
  font-family: var(--ps-font-en);
  font-size: clamp(13px, 1.3vw, 16px);
  font-weight: 300;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
  margin: 0 0 48px;
}
.hero-tagline {
  font-size: clamp(20px, 2.5vw, 32px);
  font-weight: 300;
  letter-spacing: -0.8px;
  line-height: 1.4;
  max-width: 760px;
  margin: 0 0 48px;
  color: #FFFFFF;
}
.hero-tagline strong { font-weight: 500; color: var(--ps-primary); }

.hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  font-family: var(--ps-font-en);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.3px;
  border-radius: 100px;
  transition: all 240ms var(--ps-ease-out);
  cursor: pointer;
  border: 1px solid transparent;
}
.btn.primary { background: var(--ps-primary); color: #000; }
.btn.primary:hover { background: var(--ps-primary-dark); transform: translateY(-2px); }
.btn.ghost { background: transparent; border-color: var(--ps-surface-cinematic-3); color: #FFFFFF; }
.btn.ghost:hover { border-color: var(--ps-primary); color: var(--ps-primary); }
.btn .arrow { font-size: 16px; line-height: 1; }

/* ===== Project counter strip ===== */
.works-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 28px;
  margin-top: 8px;
}
.works-meta .stat { display: flex; flex-direction: column; gap: 4px; }
.works-meta .stat .num {
  font-family: var(--ps-font-en);
  font-size: clamp(28px, 3.4vw, 40px);
  font-weight: 600;
  letter-spacing: -1px;
  color: var(--ps-primary);
  line-height: 1;
}
.works-meta .stat .lbl {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--ps-text-cinematic-secondary);
}

/* ===== Works grid ===== */
.works {
  border-top: 1px solid var(--ps-surface-cinematic-3);
}
.work-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
@media (min-width: 768px) {
  .work-grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
}
@media (min-width: 1024px) {
  .work-grid { grid-template-columns: repeat(3, 1fr); }
}

.work-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: #FFFFFF;
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 16px;
  overflow: hidden;
  transition: border-color 320ms var(--ps-ease-out), transform 320ms var(--ps-ease-out);
}
.work-card.live:hover { border-color: var(--ps-primary); transform: translateY(-4px); }

/* Typographic poster (no external image needed) */
.work-poster {
  aspect-ratio: 370 / 220;
  background: var(--ps-surface-cinematic-1);
  position: relative;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}
.work-poster::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(at 80% 20%, rgba(255, 177, 26, 0.10) 0%, transparent 50%),
    radial-gradient(at 20% 80%, rgba(255, 177, 26, 0.05) 0%, transparent 50%);
  pointer-events: none;
}
.work-poster .pnum {
  position: relative;
  font-family: var(--ps-font-en);
  font-size: clamp(40px, 6vw, 64px);
  font-weight: 700;
  letter-spacing: -2px;
  line-height: 1;
  color: rgba(255, 255, 255, 0.10);
}
.work-poster .ptitle {
  position: relative;
  font-size: clamp(18px, 1.8vw, 22px);
  font-weight: 500;
  letter-spacing: -0.5px;
  line-height: 1.25;
  color: #FFFFFF;
}

/* status pill */
.status {
  position: absolute;
  top: 20px;
  right: 20px;
  font-family: var(--ps-font-en);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 100px;
  z-index: 2;
}
.status.live {
  color: #000;
  background: var(--ps-primary);
}
.status.soon {
  color: var(--ps-text-cinematic-secondary);
  border: 1px solid var(--ps-surface-cinematic-3);
}

.work-body {
  padding: 22px 24px 26px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex: 1;
}
.work-week {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--ps-primary);
}
.work-desc {
  font-size: 14px;
  font-weight: 300;
  line-height: 1.6;
  color: #D4D4D4;
  margin: 0;
}
.work-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  padding-top: 4px;
}
.work-tags span {
  font-family: var(--ps-font-en);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0.8px;
  color: var(--ps-text-cinematic-secondary);
  border: 1px solid var(--ps-surface-cinematic-3);
  border-radius: 100px;
  padding: 3px 10px;
}

/* placeholder / coming-soon card */
.work-card.soon { cursor: default; }
.work-card.soon .work-poster { background: var(--ps-surface-cinematic-1); }
.work-card.soon .pnum { color: rgba(255, 255, 255, 0.06); }
.work-card.soon .ptitle { color: var(--ps-text-cinematic-secondary); }

/* ===== Entry animation ===== */
section, .hero {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 800ms var(--ps-ease-out), transform 800ms var(--ps-ease-out);
}
section.in-view, .hero.in-view { opacity: 1; transform: none; }
.hero { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  section, .hero { opacity: 1; transform: none; transition: none; }
}

  /* ===== Works Filter (동적 상태·태그 필터) ===== */
  .wf-controls{display:flex;flex-direction:column;gap:14px;margin-bottom:20px}
  .wf-tabs{display:flex;gap:8px;flex-wrap:wrap}
  .wf-tab{padding:9px 16px;border-radius:100px;cursor:pointer;font-size:13px;font-weight:500;background:transparent;border:1px solid var(--ps-surface-cinematic-3);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-body);transition:all .18s var(--ps-ease-out)}
  .wf-tab:hover{border-color:var(--ps-primary);color:#fff}
  .wf-tab.on{background:var(--ps-primary);border-color:var(--ps-primary);color:#000;font-weight:700}
  .wf-tags{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  .wf-chip{padding:6px 12px;border-radius:100px;cursor:pointer;font-size:12px;background:var(--ps-surface-cinematic-1);border:1px solid var(--ps-surface-cinematic-3);color:var(--ps-text-cinematic-secondary);font-family:var(--ps-font-en);transition:all .16s var(--ps-ease-out)}
  .wf-chip:hover{border-color:var(--ps-primary);color:#fff}
  .wf-chip.on{background:rgba(255,177,26,.14);border-color:var(--ps-primary);color:var(--ps-primary);font-weight:700}
  .wf-reset{padding:6px 13px;border:0;border-radius:100px;cursor:pointer;background:var(--ps-surface-cinematic-3);color:#fff;font-size:12px;font-family:var(--ps-font-body);transition:all .18s var(--ps-ease-out)}
  .wf-reset:hover{background:var(--ps-primary);color:#000}
  .wf-count{font-family:var(--ps-font-en);font-size:12px;letter-spacing:.08em;color:var(--ps-text-cinematic-secondary);text-transform:uppercase;margin-bottom:18px}
  .wf-count b{color:var(--ps-primary);font-weight:700;font-size:14px;margin-right:4px}
  .wf-empty{text-align:center;padding:48px 20px;border:1px dashed var(--ps-surface-cinematic-3);border-radius:16px}
  .wf-empty-big{font-family:var(--ps-font-en);font-size:18px;font-weight:600;color:#fff;margin:0 0 16px}
  .ps-topnav{position:fixed;top:16px;right:20px;z-index:90;font-family:var(--ps-font-en);font-size:12px;letter-spacing:.04em;color:#8C8C8C;display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border-radius:100px;border:1px solid rgba(255,255,255,.1);background:rgba(0,0,0,.4);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);transition:color .18s,border-color .18s;text-decoration:none}
  .ps-topnav:hover{color:#fff;border-color:rgba(255,255,255,.25)}
  .ps-back{position:fixed;top:14px;left:16px;z-index:91;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;padding:6px;color:#8C8C8C;cursor:pointer;line-height:0;transition:color .18s}
  .ps-back:hover{color:#fff}
  .ico{display:inline-flex;align-items:center;justify-content:center;line-height:0}
  .ico svg{display:block}
</style>
<noscript><style>section,.hero{opacity:1!important;transform:none!important}</style></noscript>
</head>

<body>

<button type="button" class="ps-back" aria-label="뒤로 가기" onclick="if(history.length>1){history.back()}else{location.href='/'}"><span class="ico" set:html={icon('arrowLeft', 20)}></span></button>

<a href="/" class="ps-topnav"><span class="ico" set:html={icon('home', 15)}></span> parcyun studio</a>

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">1 Week · 1 Web Service</div>
    <h1 class="hero-wordmark">Works</h1>
    <p class="hero-name">parcyun · 박창현</p>
    <p class="hero-tagline">
      매주 하나씩, <strong>웹서비스</strong>를 만들어 쌓습니다.<br>
      작게 시작해 꾸준히 늘려가는 빌드 아카이브.
    </p>
    <div class="hero-ctas">
      <a href="#works" class="btn primary">프로젝트 보기 <span class="arrow">↓</span></a>
      <a href="https://github.com/parcyun" class="btn ghost" target="_blank" rel="noopener">GitHub <span class="arrow">↗</span></a>
    </div>

    <div class="works-meta" style="margin-top:56px;">
      <div class="stat"><span class="num">02</span><span class="lbl">Shipped</span></div>
      <div class="stat"><span class="num">∞</span><span class="lbl">Weekly</span></div>
      <div class="stat"><span class="num">2026</span><span class="lbl">Season</span></div>
    </div>
  </div>
</section>

<!-- ===== WORKS ===== -->
<section class="works" id="works">
  <div class="wrap">
    <header class="section-header">
      <h2 class="ko">웹서비스</h2>
      <span class="en">Weekly Builds</span>
    </header>
    <WorksFilter client:load />
  </div>
</section>

<!-- ===== Mandatory parcyun footer ===== -->
<PsFooter />

<!-- ===== Entry animation ===== -->
<script is:inline>
(function(){
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('section').forEach(function(el){ el.classList.add('in-view'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); }
    });
  }, { rootMargin: '0px 0px -15% 0px', threshold: 0.05 });
  document.querySelectorAll('section').forEach(function(el){ io.observe(el); });
})();
</script>

<script is:inline src="/share-widget.js" defer></script>
<script is:inline src="/visitor-counter.js" defer></script>
</body>
</html>
