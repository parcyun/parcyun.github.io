<!-- ===== Entry animation ===== -->
<script is:inline>
(function(){
  var titanSearch = document.querySelector('[data-titan-search]');
  var titanFilters = Array.from(document.querySelectorAll('[data-titan-filter]'));
  var titanItems = Array.from(document.querySelectorAll('[data-titan-category]'));
  var titanEmpty = document.querySelector('[data-titan-empty]');
  var titanCategory = 'all';

  function filterTitanTools() {
    var query = titanSearch ? titanSearch.value.trim().toLocaleLowerCase('ko') : '';
    var visible = 0;
    titanItems.forEach(function(item) {
      var categoryMatches = titanCategory === 'all' || item.dataset.titanCategory === titanCategory;
      var textMatches = !query || item.textContent.toLocaleLowerCase('ko').includes(query);
      item.hidden = !(categoryMatches && textMatches);
      if (!item.hidden) visible += 1;
    });
    if (titanEmpty) titanEmpty.classList.toggle('is-visible', visible === 0);
  }

  if (titanSearch) titanSearch.addEventListener('input', filterTitanTools);
  titanFilters.forEach(function(button) {
    button.addEventListener('click', function() {
      titanCategory = button.dataset.titanFilter || 'all';
      titanFilters.forEach(function(candidate) {
        var active = candidate === button;
        candidate.classList.toggle('is-active', active);
        candidate.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      filterTitanTools();
    });
  });

  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('section').forEach(function(el){ el.classList.add('in-view'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); }
    });
  }, { rootMargin: '0px 0px -15% 0px', threshold: 0.05 });
  document.querySelectorAll('section').forEach(function(el){ io.observe(el); });
})();
</script>

